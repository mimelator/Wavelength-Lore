# Test-specific environment variables
# This file contains variables needed for the gallery test suite

# Copy this file to .env.test and update with your values

# API endpoint (default: http://localhost:3001)
API_BASE_URL=http://localhost:3001

# Authentication
# Generate a Firebase session token by running: node scripts/generate-session-token.js
SESSION_COOKIE=your_firebase_session_token_here

# AWS credentials are taken from main .env file:
# ACCESS_KEY_ID=...
# SECRET_ACCESS_KEY=...
# AWS_REGION=...

# S3 Storage
S3_BUCKET_NAME=<your_gallery_bucket_name>
CDN_URL=<your_cdn_url>