# Production Environment Configuration
# This file contains production-specific values that override .env defaults
# Used by the App Runner environment updater

# Node environment
NODE_ENV=production

# CloudFront CDN (production)
CDN_URL="https://df5sj8f594cdx.cloudfront.net"

# App Runner health check port
PORT=8080

# Production security settings
ADMIN_ALLOWED_IPS=*

# Production backup settings
ENABLE_BACKUPS=true

# Production AI settings (if different from dev)
# AI_PROVIDER=google-genai
# AI_MODEL_KEY=gemini-2.5-flash-image

# Printify Configuration - Production Mode
PRINTIFY_ENVIRONMENT=production
PRINTIFY_MOCK_MODE=false
PRINTIFY_API_URL=https://api.printify.com/v1

# Stripe - Production Mode (ensure consistency)
STRIPE_ENVIRONMENT=live

# Email configuration
EMAIL_PROVIDER=ses
FROM_EMAIL=mimel@imelshire.com
SUPPORT_EMAIL=mimel@imelshire.com
AWS_SES_REGION=us-east-1