{
  "agenticCoding": {
    "enabled": true,
    "autoApprove": true,
    "autoApproveAll": true,
    "trustLevel": "high",
    "allowAllTestCommands": true,
    "allowAllReadCommands": true,
    "autoApproveCommands": {
      "testCommands": true,
      "fileRead": true,
      "safeCommands": true,
      "bashExecution": true,
      "all": true
    },
    "allowedCommands": [
      "node tests/**",
      "npm test",
      "ls", "cat", "grep", "find", "head", "tail",
      "ps aux", "kill -9"
    ],
    "autoApprovePatterns": [
      ".*node tests.*",
      ".*npm test.*",
      ".*ls.*",
      ".*cat.*",
      ".*grep.*",
      ".*find.*"
    ]
  }
}