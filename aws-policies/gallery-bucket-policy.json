{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGalleryS3Access",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::170023515523:user/wavelength-lore-app-user"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::wavelength-gallery-346923",
        "arn:aws:s3:::wavelength-gallery-346923/*"
      ]
    },
    {
      "Sid": "PublicReadForGetBucketObjects",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::wavelength-gallery-346923/images/gallery/*"
    }
  ]
}