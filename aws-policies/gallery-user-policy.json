{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GalleryBucketFullAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetBucketCORS",
        "s3:PutBucketCORS",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::wavelength-gallery-346923",
        "arn:aws:s3:::wavelength-gallery-346923/*"
      ]
    }
  ]
}