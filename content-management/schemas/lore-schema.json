{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lore Schema", 
  "description": "Schema for Wavelength Lore world-building data",
  "type": "object",
  "properties": {
    "locations": {
      "type": "array",
      "items": { "$ref": "#/definitions/location" }
    },
    "objects": {
      "type": "array", 
      "items": { "$ref": "#/definitions/loreItem" }
    },
    "villains": {
      "type": "array",
      "items": { "$ref": "#/definitions/villain" }
    },
    "concepts": {
      "type": "array",
      "items": { "$ref": "#/definitions/concept" }
    },
    "bands": {
      "type": "array",
      "items": { "$ref": "#/definitions/band" }
    }
  },
  "definitions": {
    "location": {
      "type": "object",
      "required": ["id", "title", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["place", "region", "building", "landmark"]
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 50
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "image_gallery": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "climate": {
          "type": "string",
          "enum": ["temperate", "cold", "hot", "tropical", "arid", "magical"]
        },
        "inhabitants": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "loreItem": {
      "type": "object", 
      "required": ["id", "title", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["thing", "artifact", "weapon", "tool", "creature"]
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 30
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "image_gallery": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "rarity": {
          "type": "string",
          "enum": ["common", "uncommon", "rare", "legendary", "unique"]
        },
        "origin": {
          "type": "string",
          "description": "Where the item comes from"
        }
      }
    },
    "villain": {
      "type": "object",
      "required": ["id", "title", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["villain", "monster", "evil-creature", "dark-force"]
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 50
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "image_gallery": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "power_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "weaknesses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "concept": {
      "type": "object",
      "required": ["id", "title", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["concept", "philosophy", "magic-system", "natural-law"]
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "band": {
      "type": "object",
      "required": ["id", "title", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["band", "group", "organization", "family"]
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 30
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "image_gallery": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "members": {
          "type": "array",
          "items": { "type": "string" }
        },
        "genre": {
          "type": "string"
        },
        "formation_date": {
          "type": "string"
        }
      }
    }
  }
}