
# ================================================
# AWS CONFIGURATION FOR APP RUNNER
# ================================================
# Add these variables to your .env file to enable
# App Runner environment synchronization
# ================================================

# Your AWS Account ID (12 digits)
# Find it in AWS Console → Click your name in top-right → Account
AWS_ACCOUNT_ID=your-account-id-here

# AWS Region where your App Runner service is deployed
AWS_REGION=us-east-1

# App Runner Service ARN
# Find it in AWS Console → App Runner → Your Service → Configuration tab
# Format: arn:aws:apprunner:REGION:ACCOUNT_ID:service/SERVICE_NAME/SERVICE_ID
APPRUNNER_SERVICE_ARN=arn:aws:apprunner:us-east-1:ACCOUNT_ID:service/wavelength-lore/SERVICE_ID

# Optional: App Runner Service Name (defaults to wavelength-lore)
APPRUNNER_SERVICE_NAME=wavelength-lore

# Optional: App Runner Service ID (extracted from ARN if not provided)
APPRUNNER_SERVICE_ID=your-service-id

# ================================================
# INSTRUCTIONS:
# ================================================
# 1. Replace the placeholder values above with your actual AWS values
# 2. Add these to your .env file
# 3. Run: node scripts/generate-aws-config.js
# 4. Then run: node scripts/apprunner-env-updater.js --force
# ================================================
