<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enhanced Vendor Catalog - Wavelength Admin</title>
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-panel.css">
    
    <style>
        .enhanced-catalog {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .catalog-filters {
            background: white;
            border: 3px solid #333;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .filter-row {
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
        }
        
        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        
        .filter-select {
            padding: 8px 12px;
            border: 2px solid #333;
            border-radius: 4px;
            min-width: 150px;
        }
        
        .vendor-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .vendor-card {
            background: white;
            border: 3px solid #333;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.2s;
        }
        
        .vendor-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
        }
        
        .vendor-header {
            background: #f8f9fa;
            padding: 15px;
            border-bottom: 2px solid #333;
        }
        
        .vendor-name {
            font-weight: bold;
            color: #007bff;
            margin-bottom: 5px;
        }
        
        .vendor-stats {
            font-size: 12px;
            color: #666;
        }
        
        .product-samples {
            padding: 15px;
        }
        
        .sample-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        
        .sample-item {
            text-align: center;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        
        .sample-image {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 8px;
        }
        
        .sample-info {
            font-size: 11px;
        }
        
        .product-type {
            font-weight: bold;
            color: #333;
        }
        
        .overlay-options {
            margin-top: 10px;
            display: flex;
            gap: 5px;
            justify-content: center;
        }
        
        .overlay-btn {
            padding: 4px 8px;
            font-size: 10px;
            border: 1px solid #333;
            background: white;
            border-radius: 3px;
            cursor: pointer;
        }
        
        .overlay-btn:hover {
            background: #f0f0f0;
        }
        
        .vendor-actions {
            padding: 15px;
            border-top: 1px solid #ddd;
            background: #f8f9fa;
        }
        
        .action-btn {
            padding: 6px 12px;
            margin: 2px;
            border: 2px solid #333;
            background: white;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
        }
        
        .btn-primary {
            background: #007bff;
            color: white;
        }
        
        .btn-success {
            background: #28a745;
            color: white;
        }
        
        .btn-warning {
            background: #ffc107;
            color: #333;
        }
    </style>
</head>

<body>
    <%- include('../partials/header') %>
    
    <div class="main-wrapper">
        <div class="enhanced-catalog">
            <div class="catalog-header">
                <h1>🎨 Enhanced Vendor Catalog Preview</h1>
                <p>Comprehensive preview of products from different vendors with overlay options</p>
            </div>
            
            <div class="catalog-filters">
                <h3>🔍 Filter Products</h3>
                <div class="filter-row">
                    <div class="filter-group">
                        <label>Vendor:</label>
                        <select id="vendor-filter" class="filter-select">
                            <option value="">All Vendors</option>
                            <option value="1">Premium Prints</option>
                            <option value="3">Monster Digital</option>
                            <option value="4">Standard Print Co</option>
                            <option value="7">Budget Prints</option>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label>Product Type:</label>
                        <select id="product-type-filter" class="filter-select">
                            <option value="">All Types</option>
                            <option value="5">T-Shirts</option>
                            <option value="17">Coffee Mugs</option>
                            <option value="7">Posters</option>
                            <option value="146">Hoodies</option>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label>Image Style:</label>
                        <select id="image-style-filter" class="filter-select">
                            <option value="">All Styles</option>
                            <option value="character">Character Art</option>
                            <option value="location">Location Scenes</option>
                            <option value="abstract">Abstract</option>
                        </select>
                    </div>
                    
                    <button class="action-btn btn-primary" onclick="applyFilters()">Apply Filters</button>
                    <button class="action-btn" onclick="clearFilters()">Clear</button>
                </div>
            </div>
            
            <div id="vendor-grid" class="vendor-grid">
                <!-- Vendor cards will be populated here -->
            </div>
        </div>
    </div>
    
    <!-- Include Border Selection Modal -->
    <%- include('../components/border-selection') %>
    
    <script src="/js/border-selection.js"></script>
    <script>
        // Real vendor data from actual Printify catalog
        const vendorData = {
            "1": {
                name: "Print Provider",
                description: "Reliable printing with consistent quality across all product types",
                productCount: 30,
                specialties: ["T-Shirts", "Mugs", "Phone Cases", "Bags"],
                samples: [
                    {
                        type: "Unisex Cotton Crew Tee",
                        blueprintId: "5",
                        image: "https://images.printify.com/mockup/5/17391/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 77,
                        overlays: ["solid", "gradient", "theme"]
                    },
                    {
                        type: "Coffee Mug 11oz",
                        blueprintId: "68",
                        image: "https://images.printify.com/mockup/68/0/1581405237.jpg",
                        price: "$15.99",
                        popularity: 50,
                        overlays: ["wrap", "solid", "minimal"]
                    },
                    {
                        type: "Slim Phone Cases",
                        blueprintId: "268",
                        image: "https://images.printify.com/mockup/268/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 39,
                        overlays: ["full", "partial", "corner"]
                    },
                    {
                        type: "Weekender Bag",
                        blueprintId: "326",
                        image: "https://images.printify.com/mockup/326/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 68,
                        overlays: ["center", "side", "all-over"]
                    }
                ]
            },
            "2": {
                name: "Art Studio",
                description: "Premium art-focused printing with superior color reproduction",
                productCount: 30,
                specialties: ["Art Prints", "Premium Apparel", "Wall Art"],
                samples: [
                    {
                        type: "Women's Jersey V-Neck Tee",
                        blueprintId: "11",
                        image: "https://images.printify.com/mockup/11/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 100,
                        overlays: ["artistic", "gradient", "watercolor"]
                    },
                    {
                        type: "Satin Posters",
                        blueprintId: "97",
                        image: "https://images.printify.com/mockup/97/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 75,
                        overlays: ["frame", "border", "gallery"]
                    },
                    {
                        type: "Indoor Wall Tapestries",
                        blueprintId: "241",
                        image: "https://images.printify.com/mockup/241/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 28,
                        overlays: ["artistic", "bohemian", "modern"]
                    },
                    {
                        type: "Square Stickers",
                        blueprintId: "384",
                        image: "https://images.printify.com/mockup/384/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 71,
                        overlays: ["cut", "kiss-cut", "die-cut"]
                    }
                ]
            },
            "3": {
                name: "Marco Fine Arts",
                description: "Boutique printing with artisan quality and attention to detail",
                productCount: 30,
                specialties: ["Fine Art", "Luxury Items", "Custom Designs"],
                samples: [
                    {
                        type: "The Boyfriend Tee for Women",
                        blueprintId: "14",
                        image: "https://images.printify.com/mockup/14/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 94,
                        overlays: ["vintage", "distressed", "premium"]
                    },
                    {
                        type: "Faux Suede Square Pillowcase",
                        blueprintId: "232",
                        image: "https://images.printify.com/mockup/232/0/1581405237.jpg",
                        price: "$24.99",
                        popularity: 94,
                        overlays: ["luxury", "embossed", "textured"]
                    },
                    {
                        type: "Wall Clock",
                        blueprintId: "277",
                        image: "https://images.printify.com/mockup/277/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 54,
                        overlays: ["classic", "modern", "artistic"]
                    },
                    {
                        type: "Kiss-Cut Stickers",
                        blueprintId: "400",
                        image: "https://images.printify.com/mockup/400/0/1581405237.jpg",
                        price: "$18.99",
                        popularity: 98,
                        overlays: ["precision", "detailed", "premium"]
                    }
                ]
            }
        };
        
        function renderVendorGrid() {
            const grid = document.getElementById('vendor-grid');
            const vendorFilter = document.getElementById('vendor-filter').value;
            const productTypeFilter = document.getElementById('product-type-filter').value;
            
            let html = '';
            
            Object.entries(vendorData).forEach(([vendorId, vendor]) => {
                // Apply vendor filter
                if (vendorFilter && vendorFilter !== vendorId) return;
                
                // Apply product type filter
                let filteredSamples = vendor.samples;
                if (productTypeFilter) {
                    filteredSamples = vendor.samples.filter(sample => 
                        sample.blueprintId === productTypeFilter
                    );
                    if (filteredSamples.length === 0) return;
                }
                
                html += `
                    <div class="vendor-card" data-vendor-id="${vendorId}">
                        <div class="vendor-header">
                            <div class="vendor-name">${vendor.name}</div>
                            <div class="vendor-stats">
                                ${vendor.productCount} products • ${vendor.specialties.join(', ')}
                            </div>
                        </div>
                        
                        <div class="product-samples">
                            <div class="sample-grid">
                                ${filteredSamples.map(sample => `
                                    <div class="sample-item">
                                        <img src="${sample.image}" 
                                             alt="${sample.type}" 
                                             class="sample-image"
                                             onerror="this.src='/images/placeholder.jpg'" />
                                        <div class="sample-info">
                                            <div class="product-type">${sample.type}</div>
                                            <div class="overlay-options">
                                                ${sample.overlays.map(overlay => `
                                                    <button class="overlay-btn" 
                                                            onclick="applyOverlay('${sample.image}', '${overlay}', '${vendorId}', '${sample.blueprintId}', '${sample.type}')">
                                                        ${overlay}
                                                    </button>
                                                `).join('')}
                                            </div>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                        
                        <div class="vendor-actions">
                            <button class="action-btn btn-primary" 
                                    onclick="generateVendorProducts('${vendorId}')">
                                Generate Products
                            </button>
                            <button class="action-btn btn-success"
                                    onclick="previewVendorCatalog('${vendorId}')">
                                Preview Catalog
                            </button>
                            <button class="action-btn btn-warning"
                                    onclick="compareVendors('${vendorId}')">
                                Compare
                            </button>
                        </div>
                    </div>
                `;
            });
            
            grid.innerHTML = html || '<div class="empty-state">No vendors match the current filters.</div>';
        }
        
        function applyOverlay(imageUrl, overlayType, vendorId, blueprintId, productType) {
            console.log('🎨 Applying overlay:', overlayType, 'to', productType);
            
            // Enhanced overlay configurations with vendor-specific options
            const overlayConfigs = {
                // Basic overlays
                'solid': { type: 'solid', color: '#000000', width: 15 },
                'gradient': { type: 'gradient', colors: ['#000000', '#ffffff'], width: 20 },
                'minimal': { type: 'solid', color: '#ffffff', width: 5 },
                
                // Artistic overlays (Art Studio specialty)
                'artistic': { type: 'gradient', colors: ['#8B4513', '#DAA520'], width: 25 },
                'watercolor': { type: 'gradient', colors: ['#FF6B6B', '#4ECDC4'], width: 20 },
                'bohemian': { type: 'pattern', pattern: 'mandala', width: 30 },
                'modern': { type: 'solid', color: '#2C3E50', width: 10 },
                
                // Premium overlays (Marco Fine Arts specialty)
                'vintage': { type: 'gradient', colors: ['#8B4513', '#F4A460'], width: 20 },
                'distressed': { type: 'texture', texture: 'aged', opacity: 0.7 },
                'premium': { type: 'solid', color: '#FFD700', width: 8 },
                'luxury': { type: 'gradient', colors: ['#FFD700', '#FFA500'], width: 15 },
                'embossed': { type: 'raised', depth: 3, color: '#C0C0C0' },
                'textured': { type: 'pattern', pattern: 'fabric', opacity: 0.3 },
                'classic': { type: 'solid', color: '#8B4513', width: 12 },
                'precision': { type: 'solid', color: '#000000', width: 2 },
                'detailed': { type: 'pattern', pattern: 'fine-line', width: 5 },
                
                // Product-specific overlays
                'wrap': { type: 'wrap-around', coverage: 'full' },
                'frame': { type: 'frame', style: 'classic', width: 30 },
                'gallery': { type: 'frame', style: 'museum', width: 40 },
                'cut': { type: 'cut-line', style: 'square' },
                'kiss-cut': { type: 'cut-line', style: 'rounded' },
                'die-cut': { type: 'cut-line', style: 'custom' },
                'full': { type: 'coverage', area: 'full' },
                'partial': { type: 'coverage', area: 'center' },
                'corner': { type: 'placement', position: 'corner' },
                'center': { type: 'placement', position: 'center' },
                'side': { type: 'placement', position: 'side' },
                'all-over': { type: 'coverage', area: 'seamless' },
                
                // Wavelength theme
                'theme': { type: 'wavelength-theme', theme: 'goblin-king', width: 20 }
            };
            
            const imageData = {
                id: `vendor-${vendorId}-${blueprintId}`,
                vendorId: vendorId,
                productType: blueprintId,
                title: `${productType} Preview`
            };
            
            // Use the existing border modal system
            openBorderModal(imageUrl, imageData, overlayConfigs[overlayType]);
        }
        
        function generateVendorProducts(vendorId) {
            const vendor = vendorData[vendorId];
            console.log('🏭 Generating products for vendor:', vendor.name);
            
            // Show progress
            showProgress(`Generating ${vendor.productCount} products for ${vendor.name}...`);
            
            // Simulate product generation
            setTimeout(() => {
                hideProgress();
                showSuccess(`Generated ${vendor.productCount} products for ${vendor.name}!`);
            }, 2000);
        }
        
        function previewVendorCatalog(vendorId) {
            const vendor = vendorData[vendorId];
            console.log('👁️ Previewing catalog for vendor:', vendor.name);
            
            // Open vendor-specific catalog view
            window.open(`/admin/vendor-catalog?vendor=${vendorId}`, '_blank');
        }
        
        function compareVendors(vendorId) {
            console.log('⚖️ Comparing vendor:', vendorId);
            
            // Open comparison view
            window.open(`/admin/vendor-comparison?base=${vendorId}`, '_blank');
        }
        
        function applyFilters() {
            renderVendorGrid();
        }
        
        function clearFilters() {
            document.getElementById('vendor-filter').value = '';
            document.getElementById('product-type-filter').value = '';
            document.getElementById('image-style-filter').value = '';
            renderVendorGrid();
        }
        
        function showProgress(message) {
            // Create simple progress indicator
            const progress = document.createElement('div');
            progress.id = 'progress-indicator';
            progress.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                background: white;
                border: 3px solid #333;
                border-radius: 8px;
                padding: 20px;
                z-index: 10000;
                text-align: center;
            `;
            progress.innerHTML = `
                <div style="margin-bottom: 10px;">⏳</div>
                <div>${message}</div>
            `;
            document.body.appendChild(progress);
        }
        
        function hideProgress() {
            const progress = document.getElementById('progress-indicator');
            if (progress) progress.remove();
        }
        
        function showSuccess(message) {
            alert('✅ ' + message);
        }
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            renderVendorGrid();
        });
    </script>
</body>
</html>