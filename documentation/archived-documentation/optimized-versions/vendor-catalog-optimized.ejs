<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Optimized Vendor Catalog - Wavelength Admin</title>
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-panel.css">
    
    <style>
        .optimized-catalog {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .performance-stats {
            background: #e8f5e8;
            border: 2px solid #28a745;
            border-radius: 6px;
            padding: 15px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-number {
            font-size: 24px;
            font-weight: bold;
            color: #28a745;
        }
        
        .stat-label {
            font-size: 12px;
            color: #666;
        }
        
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .product-card {
            background: white;
            border: 2px solid #333;
            border-radius: 6px;
            padding: 15px;
            transition: transform 0.2s;
        }
        
        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        
        .product-title {
            font-weight: bold;
            color: #007bff;
            margin-bottom: 8px;
        }
        
        .product-meta {
            font-size: 12px;
            color: #666;
            margin: 4px 0;
        }
        
        .image-placeholder {
            width: 100%;
            height: 120px;
            background: #f8f9fa;
            border: 1px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 10px 0;
            border-radius: 4px;
            cursor: pointer;
        }
        
        .image-loaded {
            background: none;
            border: 1px solid #ddd;
        }
        
        .image-loaded img {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 4px;
        }
        
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #007bff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 30px 0;
            gap: 10px;
        }
        
        .pagination button {
            padding: 8px 12px;
            border: 2px solid #333;
            background: white;
            cursor: pointer;
            border-radius: 4px;
        }
        
        .pagination button:hover {
            background: #f0f0f0;
        }
        
        .pagination button.active {
            background: #007bff;
            color: white;
        }
        
        .pagination button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .load-more {
            text-align: center;
            margin: 20px 0;
        }
        
        .load-more button {
            padding: 12px 24px;
            background: #28a745;
            color: white;
            border: 2px solid #28a745;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }
        
        .load-more button:hover {
            background: #218838;
        }
        
        .load-more button:disabled {
            background: #6c757d;
            border-color: #6c757d;
            cursor: not-allowed;
        }
    </style>
</head>

<body>
    <%- include('../partials/header') %>
    
    <div class="main-wrapper">
        <div class="optimized-catalog">
            <div class="catalog-header">
                <h1>⚡ Optimized Vendor Catalog</h1>
                <p>Fast-loading catalog with lazy image loading and pagination</p>
            </div>
            
            <div class="performance-stats">
                <div class="stat-item">
                    <div class="stat-number" id="load-time">--</div>
                    <div class="stat-label">Load Time (ms)</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" id="product-count">0</div>
                    <div class="stat-label">Products Loaded</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" id="images-loaded">0</div>
                    <div class="stat-label">Images Loaded</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" id="api-calls">0</div>
                    <div class="stat-label">API Calls</div>
                </div>
            </div>
            
            <div id="products-container">
                <div class="products-grid" id="products-grid">
                    <!-- Products will be loaded here -->
                </div>
                
                <div class="load-more">
                    <button id="load-more-btn" onclick="loadMoreProducts()">
                        Load More Products
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Performance tracking
        const startTime = Date.now();
        let currentPage = 1;
        let totalPages = 1;
        let isLoading = false;
        let apiCallCount = 0;
        let imagesLoadedCount = 0;
        
        // Load initial products
        document.addEventListener('DOMContentLoaded', function() {
            loadProducts(1);
        });
        
        async function loadProducts(page = 1) {
            if (isLoading) return;
            
            isLoading = true;
            apiCallCount++;
            updateStats();
            
            try {
                const response = await fetch(`/admin/vendor-catalog-optimized/api?page=${page}&limit=20`);
                const data = await response.json();
                
                if (data.success) {
                    if (page === 1) {
                        // First load - replace content
                        document.getElementById('products-grid').innerHTML = '';
                    }
                    
                    // Add products to grid
                    data.products.forEach(product => {
                        addProductToGrid(product);
                    });
                    
                    // Update pagination info
                    currentPage = data.stats.currentPage;
                    totalPages = data.stats.totalPages;
                    
                    // Update load more button
                    const loadMoreBtn = document.getElementById('load-more-btn');
                    if (data.stats.hasMore) {
                        loadMoreBtn.textContent = `Load More (${data.stats.totalProducts - (currentPage * 20)} remaining)`;
                        loadMoreBtn.disabled = false;
                    } else {
                        loadMoreBtn.textContent = 'All Products Loaded';
                        loadMoreBtn.disabled = true;
                    }
                    
                    // Update performance stats
                    document.getElementById('product-count').textContent = 
                        document.querySelectorAll('.product-card').length;
                    
                    if (page === 1) {
                        const loadTime = Date.now() - startTime;
                        document.getElementById('load-time').textContent = loadTime;
                    }
                }
            } catch (error) {
                console.error('Error loading products:', error);
            } finally {
                isLoading = false;
            }
        }
        
        function addProductToGrid(product) {
            const grid = document.getElementById('products-grid');
            
            const productCard = document.createElement('div');
            productCard.className = 'product-card';
            productCard.innerHTML = `
                <div class="product-title">${product.title}</div>
                <div class="product-meta">
                    <strong>Product ID:</strong> ${product.productId}
                </div>
                <div class="product-meta">
                    <strong>Product Type:</strong> ${product.blueprintName}
                </div>
                <div class="product-meta">
                    <strong>Print Provider:</strong> ${product.providerName}
                </div>
                <div class="product-meta">
                    <strong>Source:</strong> ${product.sourceImage}
                </div>
                <div class="product-meta">
                    <strong>Created:</strong> ${new Date(product.createdAt).toLocaleDateString()}
                </div>
                
                <div class="image-placeholder" onclick="loadProductImage('${product.productId}', this)">
                    <span>Click to Load Image</span>
                </div>
                
                <div class="product-actions" style="margin-top: 15px; text-align: center;">
                    <a href="/merchandise/preview/${product.productId}" 
                       class="btn" target="_blank" style="display: inline-block; padding: 6px 12px; background: #007bff; color: white; text-decoration: none; border-radius: 4px; font-size: 12px;">
                        👁️ View
                    </a>
                </div>
            `;
            
            grid.appendChild(productCard);
        }
        
        async function loadProductImage(productId, placeholder) {
            if (placeholder.classList.contains('image-loaded')) return;
            
            placeholder.innerHTML = '<div class="loading-spinner"></div>';
            apiCallCount++;
            updateStats();
            
            try {
                const response = await fetch(`/admin/vendor-catalog-optimized/image/${productId}`);
                const data = await response.json();
                
                if (data.success && data.images && data.images.length > 0) {
                    const firstImage = data.images[0];
                    placeholder.innerHTML = `<img src="${firstImage.src}" alt="Product Image" />`;
                    placeholder.classList.add('image-loaded');
                    imagesLoadedCount++;
                } else {
                    placeholder.innerHTML = '<span style="color: #999;">No Image Available</span>';
                }
            } catch (error) {
                console.error('Error loading image:', error);
                placeholder.innerHTML = '<span style="color: #dc3545;">Failed to Load</span>';
            }
            
            updateStats();
        }
        
        function loadMoreProducts() {
            if (currentPage < totalPages) {
                loadProducts(currentPage + 1);
            }
        }
        
        function updateStats() {
            document.getElementById('api-calls').textContent = apiCallCount;
            document.getElementById('images-loaded').textContent = imagesLoadedCount;
        }
        
        // Auto-load images when scrolling (optional)
        let autoLoadEnabled = false;
        
        function enableAutoLoad() {
            autoLoadEnabled = true;
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting && !entry.target.classList.contains('image-loaded')) {
                        const productId = entry.target.onclick.toString().match(/'([^']+)'/)[1];
                        loadProductImage(productId, entry.target);
                    }
                });
            });
            
            document.querySelectorAll('.image-placeholder').forEach(placeholder => {
                observer.observe(placeholder);
            });
        }
        
        // Add toggle for auto-load
        document.addEventListener('DOMContentLoaded', function() {
            const header = document.querySelector('.catalog-header');
            const toggleBtn = document.createElement('button');
            toggleBtn.textContent = 'Enable Auto-Load Images';
            toggleBtn.style.cssText = 'margin-left: 20px; padding: 6px 12px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;';
            toggleBtn.onclick = function() {
                enableAutoLoad();
                this.textContent = 'Auto-Load Enabled';
                this.disabled = true;
            };
            header.appendChild(toggleBtn);
        });
    </script>
</body>
</html>