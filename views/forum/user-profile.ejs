<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        pageTitle: title + ' - Wavelength Community Forum',
        pageDescription: 'User profile page for the Wavelength Community Forum',
        pageKeywords: 'wavelength, forum, profile, community',
        ogTitle: title + ' - Wavelength Community Forum',
        ogDescription: 'User profile page for the Wavelength Community Forum'
    }) %>
    
    <!-- Forum-specific styles -->
    <link rel="stylesheet" href="<%= cdnUrl %>/css/forum.css">
    
    <!-- Firebase SDK - Module imports for better compatibility -->
    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js';
      import { getAuth, signInWithPopup, signInWithRedirect, getRedirectResult, GoogleAuthProvider, signOut, onAuthStateChanged, setPersistence, browserLocalPersistence } from 'https://www.gstatic.com/firebasejs/10.7.0/firebase-auth.js';
      import { getDatabase, ref, push, set, onValue, query, orderByChild, serverTimestamp, get, update } from 'https://www.gstatic.com/firebasejs/10.7.0/firebase-database.js';
      
      // Initialize Firebase with environment config
      const firebaseConfig = {
        apiKey: "<%= process.env.API_KEY %>",
        authDomain: "<%= process.env.AUTH_DOMAIN %>",
        databaseURL: "<%= process.env.DATABASE_URL %>",
        projectId: "<%= process.env.PROJECT_ID %>",
        storageBucket: "<%= process.env.STORAGE_BUCKET %>",
        messagingSenderId: "<%= process.env.MESSAGING_SENDER_ID %>",
        appId: "<%= process.env.APP_ID %>"
      };
      
      console.log('🔥 Initializing Firebase for profile page...');
      
      const app = initializeApp(firebaseConfig);
      const auth = getAuth(app);
      const database = getDatabase(app);
      
      // Configure Firebase Auth persistence for 2-week sessions
      setPersistence(auth, browserLocalPersistence).then(() => {
        console.log('✅ Firebase Auth persistence set to LOCAL for extended sessions');
        
        // Initialize session manager
        window.sessionManager = {
          SESSION_DURATION: 14 * 24 * 60 * 60 * 1000,
          isSessionValid: function() {
            const lastActivity = localStorage.getItem('wavelength_last_activity');
            if (!lastActivity) return false;
            const now = Date.now();
            const timeSinceActivity = now - parseInt(lastActivity);
            return timeSinceActivity < this.SESSION_DURATION;
          },
          updateActivity: function() {
            localStorage.setItem('wavelength_last_activity', Date.now().toString());
          },
          clearExpiredSession: function() {
            if (!this.isSessionValid()) {
              localStorage.removeItem('wavelength_last_activity');
              auth.signOut();
              return true;
            }
            return false;
          }
        };
        
        window.sessionManager.clearExpiredSession();
        console.log('✅ Session manager initialized for 2-week persistence');
        
      }).catch((error) => {
        console.error('❌ Failed to set Firebase persistence:', error);
      });
      
      // Make Firebase available globally
      window.firebaseAuth = auth;
      window.firebaseDB = database;
      window.firebaseUtils = { 
        signInWithPopup, 
        signInWithRedirect,
        getRedirectResult,
        GoogleAuthProvider, 
        signOut, 
        onAuthStateChanged, 
        setPersistence, 
        browserLocalPersistence, 
        ref, 
        push, 
        set, 
        onValue, 
        query, 
        orderByChild,
        serverTimestamp,
        get,
        update
      };
      
      console.log('✅ Firebase initialized successfully for profile page');
    </script>
    
    <!-- Forum JavaScript -->
    <script src="/js/forum.js" defer></script>
</head>
<body>
    <!-- Forum Navigation Header -->
    <%- include('../partials/forum-header') %>
    
    <div class="forum-container">
        <!-- Forum Title Section -->
        <div class="forum-title-section">
            <h1 class="forum-page-title">
                <span class="forum-icon">👤</span>
                User Profile
            </h1>
            <p class="forum-tagline">Community member information</p>
        </div>
        
        <!-- Main Forum Content -->
        <main class="forum-main">
            <div class="container">
                <!-- Breadcrumb -->
                <div class="forum-breadcrumb">
                    <a href="/forum">Forum</a>
                    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length > 0) { %>
                        <% breadcrumbs.forEach(crumb => { %>
                            <span class="breadcrumb-separator">›</span>
                            <% if (crumb.url) { %>
                                <a href="<%= crumb.url %>"><%= crumb.name %></a>
                            <% } else { %>
                                <span id="user-breadcrumb"><%= crumb.name %></span>
                            <% } %>
                        <% }); %>
                    <% } else { %>
                        <span class="breadcrumb-separator">›</span>
                        <span id="user-breadcrumb">User Profile</span>
                    <% } %>
                </div>
                
                <!-- Profile Content -->
                <div class="profile-page">
                    <!-- Authentication Section -->
                    <section class="auth-section">
                        <div id="forum-auth-container">
                            <div class="guest-message">Sign in to view profiles</div>
                            <div class="auth-actions">
                                <button class="btn btn-primary" onclick="window.forumJS.signInWithGoogle()">Sign in with Google</button>
                            </div>
                        </div>
                    </section>

                    <!-- Profile Content -->
                    <div class="profile-container" id="profile-container">
                        <div class="loading-placeholder">
                            <div class="loading-spinner"></div>
                            <p>Loading profile...</p>
                        </div>
                    </div>

                    <!-- Games Leaderboard -->
                    <%- include('../partials/leaderboard') %>

                    <!-- User Not Found -->
                    <div class="not-found-container" id="user-not-found" style="display: none;">
                        <div class="not-found-content">
                            <div class="not-found-icon">👤❌</div>
                            <h3>User Not Found</h3>
                            <p>The user profile you're looking for doesn't exist or may have been removed.</p>
                            <div class="not-found-actions">
                                <a href="/forum" class="btn btn-primary">← Back to Forum</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        
        <!-- Forum Footer -->
        <footer class="forum-footer">
            <div class="container">
                <div class="forum-footer-content">
                    <div class="forum-stats">
                        <span>Powered by Wavelength Community</span>
                    </div>
                    <div class="forum-links">
                        <a href="/">Return to Wavelength Lore</a>
                        <a href="/forum/guidelines">Community Guidelines</a>
                        <a href="/forum/help">Help & Support</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>
    
    <!-- Profile Modals -->
    <div id="profile-modals"></div>
    
    <!-- Forum Modals -->
    <div id="forum-modals"></div>

    <!-- Forum Activity Script -->
    <script src="/js/forum-activity.js"></script>
    <!-- User Profile Management Script -->
    <script src="/js/user-profile.js"></script>

    <script>
        // Profile page state
        const userId = '<%= userId %>';
        let currentProfile = null;
        let userPosts = [];
        let userReplies = [];
        
        // Initialize profile page
        document.addEventListener('DOMContentLoaded', function() {
            if (userId && userId !== 'undefined' && userId !== 'null') {
                // Viewing a specific user's profile
                loadUserProfile();
                loadUserPosts();
                loadUserReplies();
                setupAuthListener();
            } else {
                // Viewing current user's profile - wait for authentication
                setupCurrentUserProfile();
            }
        });
        
        function setupCurrentUserProfile() {
            if (window.firebaseAuth && window.firebaseUtils) {
                window.firebaseUtils.onAuthStateChanged(window.firebaseAuth, (user) => {
                    if (user) {
                        // Set the userId to current user and load profile
                        window.currentUserId = user.uid;
                        loadCurrentUserProfile(user.uid);
                        loadUserPosts();
                        loadUserReplies();
                        updateAuthUI();
                        updateProfilePermissions();
                    } else {
                        // Not signed in, show sign-in prompt
                        showSignInRequired();
                    }
                });
            } else {
                // Firebase not ready, try again
                setTimeout(setupCurrentUserProfile, 100);
            }
        }
        
        function loadCurrentUserProfile(currentUserId) {
            const userRef = window.firebaseUtils.ref(window.firebaseDB, 'forum/users/' + currentUserId);
            window.firebaseUtils.onValue(userRef, (snapshot) => {
                const userData = snapshot.val();
                if (userData) {
                    currentProfile = { id: currentUserId, ...userData };
                    displayUserProfile(currentProfile);
                } else {
                    // Create initial profile for new user
                    currentProfile = {
                        id: currentUserId,
                        name: window.forumState?.currentUser?.name || 'User',
                        email: window.forumState?.currentUser?.email || '',
                        avatar: window.forumState?.currentUser?.avatar || '/icons/hero-icon.svg',
                        bio: '',
                        joinedAt: Date.now(),
                        postCount: 0,
                        replyCount: 0
                    };
                    displayUserProfile(currentProfile);
                }
            });
        }
        
        function showSignInRequired() {
            const container = document.getElementById('profile-container');
            if (container) {
                container.innerHTML = [
                    '<div class="profile-signin-required">',
                    '    <div class="signin-card">',
                    '        <h2>Sign In Required</h2>',
                    '        <p>You need to sign in to view your profile.</p>',
                    '        <button class="btn btn-primary" onclick="signInWithGoogle()">',
                    '            🔐 Sign In with Google',
                    '        </button>',
                    '    </div>',
                    '</div>'
                ].join('');
            }
        }
        
        async function signInWithGoogle() {
            try {
                const provider = new window.firebaseUtils.GoogleAuthProvider();
                await window.firebaseUtils.signInWithPopup(window.firebaseAuth, provider);
            } catch (error) {
                console.error('Sign-in error:', error);
                alert('Sign-in failed. Please try again.');
            }
        }
        
        function displayUserProfile(profile) {
            const container = document.getElementById('profile-container');
            if (!container) return;
            
            const isOwnProfile = window.forumState.currentUser &&
                                 window.forumState.currentUser.uid === profile.id;
            
            const joinDate = new Date(profile.joinDate || profile.joinedAt || Date.now());
            const memberSince = joinDate.toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            });
            
            const lastSeenText = profile.lastSeen ? 
                formatTimeAgo(profile.lastSeen) : 'Unknown';
            
            const isOnline = profile.lastSeen && 
                            (Date.now() - profile.lastSeen) < 300000; // 5 minutes
            
            container.innerHTML = `
                <div class="user-profile">
                    <!-- Profile Header -->
                    <div class="profile-header">
                        <div class="profile-avatar">
                            <img src="${profile.avatar || '/icons/hero-icon.svg'}" 
                                 alt="${escapeHtml(profile.name)}" 
                                 class="avatar-large">
                            ${isOnline ? '<div class="online-status-large"></div>' : ''}
                        </div>
                        <div class="profile-info">
                            <h2 class="profile-name">${escapeHtml(profile.name)}</h2>
                            <div class="profile-role">${getRoleDisplay(profile.role || 'member')}</div>
                            <div class="profile-status">
                                <span class="status-item">
                                    ${isOnline ? '🟢 Online' : '⚫ Offline'}
                                    ${!isOnline ? ` - Last seen ${lastSeenText}` : ''}
                                </span>
                            </div>
                            <div class="profile-joined">
                                📅 Member since ${memberSince}
                            </div>
                            ${isOwnProfile ? `
                                <div class="profile-actions">
                                    <button class="btn btn-secondary" onclick="editProfile()">
                                        ✏️ Edit Profile
                                    </button>
                                    <button class="btn btn-secondary" onclick="viewSettings()">
                                        ⚙️ Settings
                                    </button>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                    
                    <!-- Bio Section -->
                    ${profile.bio ? `
                        <div class="profile-bio">
                            <h3>📝 About</h3>
                            <p>${escapeHtml(profile.bio)}</p>
                            ${isOwnProfile ? `
                                <button class="btn btn-link" onclick="editBio()">✏️ Edit Bio</button>
                            ` : ''}
                        </div>
                    ` : (isOwnProfile ? `
                        <div class="profile-bio empty">
                            <h3>📝 About</h3>
                            <p class="empty-bio">Tell the community about yourself...</p>
                            <button class="btn btn-secondary" onclick="editBio()">✏️ Add Bio</button>
                        </div>
                    ` : '')}
                    
                    <!-- Profile Statistics -->
                    <div class="profile-stats">
                        <div class="stat-card">
                            <div class="stat-number" id="posts-count">${profile.postCount || 0}</div>
                            <div class="stat-label">Posts</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number" id="replies-count">${profile.replyCount || 0}</div>
                            <div class="stat-label">Replies</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number" id="likes-received">${calculateLikesReceived()}</div>
                            <div class="stat-label">Likes Received</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number" id="reputation-score">${calculateReputation()}</div>
                            <div class="stat-label">Reputation</div>
                        </div>
                    </div>

                    <!-- Radio Player Game Stats -->
                    <div class="radio-player-stats">
                        <h3>Radio Player Game Stats</h3>
                        <div class="game-stats-grid">
                            <div class="game-stat-item">
                                <span class="game-stat-icon">🍄</span>
                                <span class="game-stat-value" id="radio-mushrooms">0</span>
                                <span class="game-stat-label">Mushrooms</span>
                            </div>
                            <div class="game-stat-item">
                                <span class="game-stat-icon">🌟</span>
                                <span class="game-stat-value" id="radio-stars">0</span>
                                <span class="game-stat-label">Stars</span>
                            </div>
                            <div class="game-stat-item">
                                <span class="game-stat-icon">🧲</span>
                                <span class="game-stat-value" id="radio-horseshoes">0</span>
                                <span class="game-stat-label">Horseshoes</span>
                            </div>
                            <div class="game-stat-item">
                                <span class="game-stat-icon">💎</span>
                                <span class="game-stat-value" id="radio-gems">0</span>
                                <span class="game-stat-label">Gems</span>
                            </div>
                        </div>
                        <div class="favorite-songs-section">
                            <h4>🎵 Favorite Songs</h4>
                            <div class="favorites-list" id="favorites-list">
                                <div class="loading-favorites">Loading favorite songs...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="profile-activity">
                        <h3>📈 Recent Activity</h3>
                        <div class="activity-list" id="activity-list">
                            <div class="loading-activity">Loading recent activity...</div>
                        </div>
                    </div>
                </div>
            `;

            // Load additional data after rendering
            loadGameStats(profile.id);
            loadFavoriteSongs(profile.id);
            loadRecentActivity(profile.id);
        }
        
        function updateAuthUI() {
            // Update authentication UI elements
            const authContainer = document.getElementById('forum-auth-container');
            if (authContainer && window.forumState?.currentUser) {
                authContainer.style.display = 'none';
            }
        }
        
        function updateProfilePermissions() {
            // Update UI based on user permissions
        }
        
        function loadUserProfile() {
            // Load specific user profile
            if (window.firebaseUtils && window.firebaseDB) {
                const userRef = window.firebaseUtils.ref(window.firebaseDB, 'forum/users/' + userId);
                window.firebaseUtils.onValue(userRef, (snapshot) => {
                    const userData = snapshot.val();
                    if (userData) {
                        currentProfile = { id: userId, ...userData };
                        displayUserProfile(currentProfile);
                    } else {
                        showUserNotFound();
                    }
                });
            }
        }
        
        function loadUserPosts() {
            // Load user's posts
        }
        
        function loadUserReplies() {
            // Load user's replies
        }
        
        function setupAuthListener() {
            // Set up authentication state listener
            if (window.firebaseAuth && window.firebaseUtils) {
                window.firebaseUtils.onAuthStateChanged(window.firebaseAuth, (user) => {
                    updateAuthUI();
                    updateProfilePermissions();
                });
            }
        }
        
        function showUserNotFound() {
            document.getElementById('profile-container').style.display = 'none';
            document.getElementById('user-not-found').style.display = 'block';
        }
        
        function escapeHtml(text) {
            if (!text) return '';
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        // Helper functions for profile display
        function getRoleDisplay(role) {
            const roles = {
                'admin': '👑 Administrator',
                'moderator': '🛡️ Moderator',
                'vip': '⭐ VIP Member',
                'member': '👤 Member',
                'new': '🆕 New Member'
            };
            return roles[role] || roles['member'];
        }

        function formatTimeAgo(timestamp) {
            const now = Date.now();
            const diff = now - timestamp;
            
            const minutes = Math.floor(diff / 60000);
            const hours = Math.floor(diff / 3600000);
            const days = Math.floor(diff / 86400000);
            
            if (minutes < 1) return 'just now';
            if (minutes < 60) return `${minutes}m ago`;
            if (hours < 24) return `${hours}h ago`;
            if (days < 7) return `${days}d ago`;
            return new Date(timestamp).toLocaleDateString();
        }

        function calculateLikesReceived() {
            // Calculate total likes received on posts and replies
            return userPosts.reduce((total, post) => total + (post.likes || 0), 0) +
                   userReplies.reduce((total, reply) => total + (reply.likes || 0), 0);
        }

        function calculateReputation() {
            // Calculate reputation based on posts, replies, and likes
            const postScore = (currentProfile?.postCount || 0) * 5;
            const replyScore = (currentProfile?.replyCount || 0) * 2;
            const likeScore = calculateLikesReceived() * 1;
            return postScore + replyScore + likeScore;
        }

        function loadGameStats(userId) {
            // Load radio player game statistics
            if (!window.firebaseUtils || !window.firebaseDB) {
                console.warn('Firebase not available for loading game stats');
                return;
            }
            
            if (!userId) {
                console.warn('No userId provided for loading game stats');
                return;
            }
            
            const gameStatsRef = window.firebaseUtils.ref(window.firebaseDB, `users/${userId}/radioPlayerStats`);
            window.firebaseUtils.onValue(gameStatsRef, (snapshot) => {
                const stats = snapshot.val();
                if (stats) {
                    // Update stat displays with error handling
                    const updateStat = (elementId, value) => {
                        const element = document.getElementById(elementId);
                        if (element) {
                            element.textContent = value || 0;
                        } else {
                            console.warn(`Element not found: ${elementId}`);
                        }
                    };
                    
                    updateStat('radio-mushrooms', stats.mushrooms);
                    updateStat('radio-stars', stats.stars);
                    updateStat('radio-horseshoes', stats.horseshoes);
                    updateStat('radio-gems', stats.crystals); // crystals maps to gems display
                    
                    console.log('✅ Game stats loaded successfully:', stats);
                } else {
                    // No stats found, set all to 0
                    const updateStat = (elementId) => {
                        const element = document.getElementById(elementId);
                        if (element) element.textContent = 0;
                    };
                    
                    updateStat('radio-mushrooms');
                    updateStat('radio-stars');
                    updateStat('radio-horseshoes');
                    updateStat('radio-gems');
                    
                    console.log('ℹ️ No game stats found for user, showing zeros');
                }
            }, (error) => {
                console.error('Error loading game stats:', error);
                // Set all to 0 on error
                ['radio-mushrooms', 'radio-stars', 'radio-horseshoes', 'radio-gems'].forEach(id => {
                    const element = document.getElementById(id);
                    if (element) element.textContent = 0;
                });
            });
        }

        function loadFavoriteSongs(userId) {
            // Load user's favorite songs
            if (!window.firebaseUtils || !window.firebaseDB) return;
            
            const favoritesRef = window.firebaseUtils.ref(window.firebaseDB, `userFavorites/${userId}`);
            window.firebaseUtils.onValue(favoritesRef, (snapshot) => {
                const favorites = snapshot.val();
                const favoritesList = document.getElementById('favorites-list');
                
                if (!favorites || Object.keys(favorites).length === 0) {
                    favoritesList.innerHTML = '<div class="no-favorites">No favorite songs yet</div>';
                    return;
                }
                
                const favoritesArray = Object.entries(favorites)
                    .map(([key, song]) => ({ id: key, ...song }))
                    .slice(0, 5); // Show top 5 favorites
                
                const favoritesHTML = favoritesArray.map(song => `
                    <div class="favorite-song-item">
                        <div class="song-info">
                            <span class="song-title">${escapeHtml(song.title || 'Unknown Song')}</span>
                            <span class="song-artist">${escapeHtml(song.artist || 'Unknown Artist')}</span>
                        </div>
                        <div class="song-actions">
                            <button class="btn btn-link" onclick="playFromRadio('${song.id}')">▶️</button>
                        </div>
                    </div>
                `).join('');
                
                favoritesList.innerHTML = favoritesHTML;
            });
        }

        function loadRecentActivity(userId) {
            // Load user's recent forum activity
            if (!window.firebaseUtils || !window.firebaseDB) return;
            
            const activityList = document.getElementById('activity-list');
            const activities = [];
            
            // Load recent posts
            const postsRef = window.firebaseUtils.query(
                window.firebaseUtils.ref(window.firebaseDB, 'forum/posts'),
                window.firebaseUtils.orderByChild('authorId')
            );
            
            window.firebaseUtils.onValue(postsRef, (snapshot) => {
                const posts = snapshot.val();
                if (posts) {
                    const userPostsData = Object.entries(posts)
                        .filter(([key, post]) => post.authorId === userId)
                        .map(([key, post]) => ({ id: key, type: 'post', ...post }))
                        .sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0))
                        .slice(0, 5);
                    
                    userPosts = userPostsData; // Update global variable
                    updateActivityDisplay(userPostsData);
                }
            });
        }

        function updateActivityDisplay(activities) {
            const activityList = document.getElementById('activity-list');
            
            if (!activities || activities.length === 0) {
                activityList.innerHTML = '<div class="no-activity">No recent activity</div>';
                return;
            }
            
            const activityHTML = activities.map(activity => {
                const timeAgo = formatTimeAgo(activity.createdAt);
                const activityIcon = activity.type === 'post' ? '📝' : '💬';
                
                return `
                    <div class="activity-item">
                        <div class="activity-icon">${activityIcon}</div>
                        <div class="activity-content">
                            <div class="activity-title">
                                <a href="/forum/post/${activity.id}">${escapeHtml(activity.title)}</a>
                            </div>
                            <div class="activity-meta">
                                ${activity.type === 'post' ? 'Created a post' : 'Made a reply'} • ${timeAgo}
                            </div>
                        </div>
                        <div class="activity-stats">
                            <span class="reply-count">${activity.replyCount || 0} replies</span>
                            <span class="like-count">${activity.likes || 0} likes</span>
                        </div>
                    </div>
                `;
            }).join('');
            
            activityList.innerHTML = activityHTML;
        }

        function playFromRadio(songId) {
            // Integration with radio player
            if (window.radioPlayer && window.radioPlayer.playSpecificSong) {
                window.radioPlayer.playSpecificSong(songId);
            }
        }
    </script>

    <!-- Radio Player Widget -->
    <%- include('../partials/radio-player-widget') %>

</body>
</html>