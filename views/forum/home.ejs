<!-- Featured/Pinned Posts -->
<div class="forum-featured-posts">
    <h3>📌 Pinned Posts</h3>
    <div class="pinned-posts-container" id="pinned-posts-container">
        <!-- Pinned posts will be loaded here -->
    </div>
</div>

<script>
// Initialize forum home page
document.addEventListener('DOMContentLoaded', function() {
    // Check for tag filter in URL
    const urlParams = new URLSearchParams(window.location.search);
    const tagFilter = urlParams.get('tag');
    
    if (tagFilter) {
        // Show tag filtering mode
        showTagFilterMode(tagFilter);
        loadPostsByTag(tagFilter);
    } else {
        // Normal home page mode
        loadForumCategories();
        loadRecentPosts();
        loadPinnedPosts();
    }
    
    loadForumStats();
    
    // Set up auth state listener
    if (window.firebaseAuth) {
        window.firebaseUtils.onAuthStateChanged(window.firebaseAuth, (user) => {
            if (user) {
                document.getElementById('forum-quick-actions').style.display = 'block';
            } else {
                document.getElementById('forum-quick-actions').style.display = 'none';
            }
        });
    }
});

async function loadForumCategories() {
    try {
        const response = await fetch('/forum/api/categories');
        const data = await response.json();
        const container = document.getElementById('forum-categories-container');
        
        if (data.success && data.categories) {
            const categoriesArray = Object.values(data.categories);
            container.innerHTML = categoriesArray.map(category => `
                <div class="category-card" onclick="location.href='/forum/category/${category.id}'">
                    <div class="category-header">
                        <div class="category-icon">
                            <span class="category-icon-emoji">${category.icon}</span>
                        </div>
                        <div class="category-info">
                            <h4 class="category-title" style="color: ${category.color}">${category.title}</h4>
                            <p class="category-description">${category.description}</p>
                        </div>
                    </div>
                    <div class="category-stats">
                        <div class="stat">
                            <span class="stat-number">${category.postCount || 0}</span>
                            <span class="stat-label">Posts</span>
                        </div>
                        <div class="category-last-activity">
                            <span class="no-activity">Ready for posts!</span>
                        </div>
                    </div>
                </div>
            `).join('');
        } else {
            container.innerHTML = '<p class="no-content">No categories found.</p>';
        }
    } catch (error) {
        console.error('Error loading categories:', error);
        document.getElementById('forum-categories-container').innerHTML = 
            '<p class="error-message">Error loading categories. Please refresh the page.</p>';
    }
}

async function loadRecentPosts() {
    try {
        const response = await fetch('/forum/api/posts/recent?limit=5');
        const data = await response.json();
        const container = document.getElementById('recent-posts-container');
        
        if (data.success && data.posts && data.posts.length > 0) {
            container.innerHTML = data.posts.map(post => `
                    <div class="recent-post-item" onclick="location.href='/forum/post/${post.id}'">
                        <div class="post-author">
                            <img src="${post.authorAvatar || '/icons/hero-icon.svg'}" alt="${post.authorName}" class="author-avatar" onerror="this.src='/icons/hero-icon.svg'">
                            <a href="/forum/user/${post.authorId}" class="author-link" onclick="event.stopPropagation()">
                                <span class="author-name">${post.authorName}</span>
                            </a>
                        </div>
                        <div class="post-content">
                            <h5 class="post-title">${post.title}</h5>
                            <p class="post-preview">${truncateText(post.content, 100)}</p>
                            <div class="post-meta">
                                <span class="post-time">${formatTimeAgo(post.createdAt)}</span>
                                <span class="post-replies">${post.replyCount || 0} replies</span>
                                <span class="post-likes">${post.likes || 0} likes</span>
                            </div>
                            ${post.tags && post.tags.length > 0 ? `
                                <div class="post-tags" style="margin-top: 8px;">
                                    ${post.tags.map(tag => `
                                        <a href="/forum?tag=${encodeURIComponent(tag)}" 
                                           class="post-tag" 
                                           onclick="event.stopPropagation();">#${tag}</a>
                                    `).join('')}
                                </div>
                            ` : ''}
                        </div>
                    </div>
                `).join('');
        } else {
            container.innerHTML = `
                <div class="no-posts-message">
                    <h4>🌟 Be the first to start a discussion!</h4>
                    <p>The forum is ready for your thoughts, theories, and conversations about Wavelength.</p>
                    <a href="/forum/create" class="btn btn-primary">Create First Post</a>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error loading recent posts:', error);
        document.getElementById('recent-posts-container').innerHTML = 
            '<p class="error-message">Error loading recent posts.</p>';
    }
}

async function loadPinnedPosts() {
    try {
        const postsRef = window.firebaseUtils.ref(window.firebaseDB, 'forum/posts');
        
        window.firebaseUtils.onValue(postsRef, (snapshot) => {
            const posts = snapshot.val();
            const container = document.getElementById('pinned-posts-container');
            
            if (posts) {
                const pinnedPosts = Object.entries(posts)
                    .map(([id, post]) => ({id, ...post}))
                    .filter(post => post.isPinned)
                    .sort((a, b) => b.createdAt - a.createdAt);
                
                if (pinnedPosts.length > 0) {
                    container.innerHTML = pinnedPosts.map(post => `
                        <div class="pinned-post-item" onclick="location.href='/forum/post/${post.id}'">
                            <div class="pinned-icon">📌</div>
                            <div class="post-info">
                                <h5 class="post-title">${post.title}</h5>
                                <div class="post-meta">
                                    <span class="post-author">by ${post.authorName}</span>
                                    <span class="post-time">${formatTimeAgo(post.createdAt)}</span>
                                </div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = '<p class="no-content">No pinned posts.</p>';
                }
            }
        });
    } catch (error) {
        console.error('Error loading pinned posts:', error);
    }
}

async function loadForumStats() {
    try {
        const response = await fetch('/forum/api/stats');
        const data = await response.json();
        
        if (data.success && data.stats) {
            document.getElementById('total-posts').textContent = data.stats.totalPosts || 0;
            document.getElementById('total-members').textContent = data.stats.totalUsers || 0;
            document.getElementById('online-users').textContent = data.stats.activeUsers || 0;
        } else {
            document.getElementById('total-posts').textContent = '0';
            document.getElementById('total-members').textContent = '0';
            document.getElementById('online-users').textContent = '0';
        }
    } catch (error) {
        console.error('Error loading forum stats:', error);
        document.getElementById('total-posts').textContent = '0';
        document.getElementById('total-members').textContent = '0';
        document.getElementById('online-users').textContent = '0';
    }
}

async function loadOnlineUsers() {
    try {
        const usersRef = window.firebaseUtils.ref(window.firebaseDB, 'forum/users');
        window.firebaseUtils.onValue(usersRef, (snapshot) => {
            const users = snapshot.val();
            if (users) {
                const now = Date.now();
                const fiveMinutesAgo = now - (5 * 60 * 1000);
                
                const onlineUsers = Object.values(users).filter(user => 
                    user.lastSeen && user.lastSeen > fiveMinutesAgo
                );
                
                document.getElementById('online-users').textContent = onlineUsers.length;
            } else {
                document.getElementById('online-users').textContent = '0';
            }
        }, { onlyOnce: true });
    } catch (error) {
        console.error('Error loading online users:', error);
    }
}

// Update user's last seen timestamp
function updateUserActivity() {
    if (window.forumState.isAuthenticated && window.forumState.currentUser) {
        const userRef = window.firebaseUtils.ref(window.firebaseDB, 
            `forum/users/${window.forumState.currentUser.uid}/lastSeen`);
        window.firebaseUtils.set(userRef, Date.now());
    }
}

// Update activity every 2 minutes while user is active
setInterval(updateUserActivity, 2 * 60 * 1000);

// Update activity when user interacts with the page
document.addEventListener('click', updateUserActivity);
document.addEventListener('keydown', updateUserActivity);

// Tag filtering functions
function showTagFilterMode(tag) {
    // Update page title and header
    const forumTitle = document.querySelector('.forum-title');
    if (forumTitle) {
        forumTitle.innerHTML = `Posts tagged with <span style="color: #4a47a3;">#${tag}</span>`;
    }
    
    // Hide categories section and show back button
    const categoriesSection = document.querySelector('.forum-categories');
    if (categoriesSection) {
        categoriesSection.style.display = 'none';
    }
    
    // Add back to forum button
    const welcomeSection = document.querySelector('.forum-welcome');
    if (welcomeSection) {
        welcomeSection.innerHTML = `
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                <a href="/forum" class="btn btn-secondary" style="text-decoration: none;">
                    ← Back to Forum
                </a>
                <div>
                    <h2>Posts tagged with #${tag}</h2>
                    <p>Showing all posts that have been tagged with "${tag}"</p>
                </div>
            </div>
        `;
    }
    
    // Update recent posts title
    const recentPostsTitle = document.querySelector('.forum-featured-posts h3');
    if (recentPostsTitle) {
        recentPostsTitle.textContent = `📌 Tagged Posts`;
    }
}

async function loadPostsByTag(tag) {
    try {
        const postsRef = window.firebaseUtils.ref(window.firebaseDB, 'forum/posts');
        window.firebaseUtils.onValue(postsRef, (snapshot) => {
            const posts = snapshot.val();
            const container = document.getElementById('recent-posts-container');
            
            if (posts) {
                // Filter posts that contain the tag
                const taggedPosts = Object.entries(posts)
                    .map(([id, post]) => ({id, ...post}))
                    .filter(post => post.tags && post.tags.includes(tag))
                    .sort((a, b) => b.createdAt - a.createdAt);
                
                if (taggedPosts.length > 0) {
                    container.innerHTML = taggedPosts.map(post => `
                        <div class="recent-post-item" onclick="location.href='/forum/post/${post.id}'">
                            <div class="post-author">
                                <img src="${post.authorAvatar || '/icons/hero-icon.svg'}" alt="${post.authorName}" class="author-avatar" onerror="this.src='/icons/hero-icon.svg'">
                                <a href="/forum/user/${post.authorId}" class="author-link" onclick="event.stopPropagation()">
                                    <span class="author-name">${post.authorName}</span>
                                </a>
                            </div>
                            <div class="post-content">
                                <h5 class="post-title">${post.title}</h5>
                                <p class="post-preview">${truncateText(post.content, 100)}</p>
                                <div class="post-meta">
                                    <span class="post-time">${formatTimeAgo(post.createdAt)}</span>
                                    <span class="post-replies">${post.replyCount || 0} replies</span>
                                    <span class="post-likes">${post.likes || 0} likes</span>
                                </div>
                                ${post.tags && post.tags.length > 0 ? `
                                    <div class="post-tags" style="margin-top: 8px;">
                                        ${post.tags.map(postTag => `
                                            <a href="/forum?tag=${encodeURIComponent(postTag)}" 
                                               class="post-tag ${postTag === tag ? 'active-tag' : ''}" 
                                               onclick="event.stopPropagation();">#${postTag}</a>
                                        `).join('')}
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #666;">
                            <h3>No posts found with tag #${tag}</h3>
                            <p>Be the first to create a post with this tag!</p>
                            <a href="/forum/create" class="btn btn-primary" style="margin-top: 15px;">Create Post</a>
                        </div>
                    `;
                }
            } else {
                container.innerHTML = '<p class="no-content">No posts found.</p>';
            }
        });
    } catch (error) {
        console.error('Error loading posts by tag:', error);
        document.getElementById('recent-posts-container').innerHTML = 
            '<p class="error-message">Error loading posts. Please refresh the page.</p>';
    }
}

// Utility functions
function formatTimeAgo(timestamp) {
    const now = Date.now();
    const diff = now - timestamp;
    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    const days = Math.floor(diff / 86400000);
    
    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes}m ago`;
    if (hours < 24) return `${hours}h ago`;
    if (days < 7) return `${days}d ago`;
    return new Date(timestamp).toLocaleDateString();
}

function truncateText(text, maxLength) {
    if (text.length <= maxLength) return text;
    return text.substring(0, maxLength) + '...';
}

function showCreatePostModal() {
    // Navigate to create post page
    window.location.href = '/forum/create';
}
</script>