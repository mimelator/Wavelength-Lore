<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {
        title: title + ' - Wavelength Community Forum',
        pageDescription: 'Join the discussion on the Wavelength Community Forum'
    }) %>
    
    <!-- Forum-specific CSS -->
    <link rel="stylesheet" href="<%= cdnUrl %>/css/forum.css">
    <style>
        .forum-post-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 2rem;
            background: rgba(74, 71, 163, 0.1);
            border-radius: 1rem;
            border: 1px solid rgba(74, 71, 163, 0.3);
        }
        .post-meta-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(74, 71, 163, 0.2);
        }
        .post-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #4a47a3;
        }
        .post-meta {
            flex: 1;
        }
        .post-title {
            font-size: 1.5rem;
            font-weight: bold;
            color: #4a47a3;
            margin: 0 0 0.5rem 0;
        }
        .post-author {
            color: #666;
            font-size: 0.9rem;
        }
        .post-content {
            line-height: 1.6;
            margin: 1.5rem 0;
            white-space: pre-wrap;
        }
        .post-tags {
            display: flex;
            gap: 0.5rem;
            margin: 1rem 0;
        }
        .tag {
            background: rgba(74, 71, 163, 0.2);
            color: #4a47a3;
            padding: 0.25rem 0.75rem;
            border-radius: 1rem;
            font-size: 0.8rem;
        }
        .replies-section {
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 2px solid rgba(74, 71, 163, 0.2);
        }
        .reply {
            background: rgba(255, 255, 255, 0.5);
            padding: 1rem;
            border-radius: 0.5rem;
            margin: 1rem 0;
            border-left: 3px solid #4a47a3;
        }
        .reply-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            color: #666;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 1rem;
            color: #4a47a3;
            text-decoration: none;
            font-weight: bold;
        }
        .back-link:hover {
            text-decoration: underline;
        }
        .error-message {
            text-align: center;
            color: #e74c3c;
            font-size: 1.2rem;
            margin: 2rem 0;
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    
    <main class="forum-post-container">
        <a href="/forum" class="back-link">← Back to Forum</a>
        
        <% if (typeof post !== 'undefined' && post) { %>
            <article class="forum-post">
                <div class="post-meta-header">
                    <img src="<%= post.authorAvatar || '/icons/hero-icon.svg' %>" 
                         alt="<%= post.authorName || 'Author' %>" 
                         class="post-avatar"
                         onerror="this.src='/icons/hero-icon.svg'">
                    <div class="post-meta">
                        <h1 class="post-title"><%= post.title || 'Untitled Post' %></h1>
                        <div class="post-author">
                            By <%= post.authorName || 'Unknown Author' %> • 
                            <%= post.createdAt ? new Date(post.createdAt).toLocaleDateString() : 'Unknown Date' %> • 
                            <%= post.views || 0 %> views
                        </div>
                    </div>
                </div>
                
                <div class="post-content"><%- post.content ? post.content.replace(/\n/g, '<br>') : 'No content available' %></div>
                
                <% if (typeof post.tags !== 'undefined' && post.tags && post.tags.length > 0) { %>
                    <div class="post-tags">
                        <% post.tags.forEach(tag => { %>
                            <span class="tag">#<%= tag %></span>
                        <% }); %>
                    </div>
                <% } %>
            </article>
            
            <% if (typeof replies !== 'undefined' && replies && replies.length > 0) { %>
                <section class="replies-section">
                    <h3>Replies (<%= replies.length %>)</h3>
                    <% replies.forEach(reply => { %>
                        <div class="reply">
                            <div class="reply-header">
                                <strong><%= reply.authorName || 'Anonymous' %></strong> • 
                                <%= reply.createdAt ? new Date(reply.createdAt).toLocaleDateString() : 'Unknown Date' %>
                            </div>
                            <div class="reply-content"><%- reply.content ? reply.content.replace(/\n/g, '<br>') : 'No content' %></div>
                        </div>
                    <% }); %>
                </section>
            <% } else { %>
                <section class="replies-section">
                    <h3>No Replies Yet</h3>
                    <p>Be the first to reply to this post!</p>
                </section>
            <% } %>
            
        <% } else { %>
            <div class="error-message">
                <h2><%= typeof error !== 'undefined' && error ? 'Error' : 'Post Not Found' %></h2>
                <p>
                    <% if (typeof error !== 'undefined' && error) { %>
                        <%= error %>
                    <% } else { %>
                        The requested post could not be found or may have been removed.
                    <% } %>
                </p>
                <a href="/forum" class="back-link">Return to Forum</a>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div style="margin-top: 1rem; padding: 1rem; background: rgba(255,0,0,0.1); border-radius: 0.5rem; font-family: monospace; font-size: 0.9rem; color: #666;">
                        <strong>Debug Info:</strong><br>
                        Error: <%= error %><br>
                        Timestamp: <%= new Date().toISOString() %>
                    </div>
                <% } %>
            </div>
        <% } %>
    </main>
    
    <%- include('../partials/footer') %>
</body>
</html>