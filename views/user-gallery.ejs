          } catch (drawError) {
            resultsDiv.innerHTML += `
              <p><strong>Canvas Drawing:</strong> <span style="color: #f44336;">❌ Failed</span></p>
              <p><strong>Error:</strong> ${drawError.message}</p>
            `;
          }
        };
        
        img.onerror = () => {
          resultsDiv.innerHTML = `
