            <p>This could be due to various reasons:</p>
            <ul>
              <li>The URL is invalid or the image doesn't exist</li>
              <li>CORS is not properly configured on the CDN/server</li>
              <li>Network issues preventing the image from loading</li>
            </ul>
          `;
        };
        
        // Start loading the image
        img.src = imageUrl;
