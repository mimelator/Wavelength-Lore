          <input type="text" id="test-image-url" style="width: 80%; padding: 5px; margin: 5px 0;" placeholder="Enter an image URL from your gallery to test...">
          <button id="test-cors" style="background-color: #4a90e2; color: white; border: none; padding: 5px 10px; cursor: pointer;">Test CORS</button>
        </div>
        <div id="cors-test-results" style="background-color: #222; padding: 10px; border-radius: 4px; max-height: 300px; overflow: auto;"></div>
      `;
      
      // Test API connectivity
      document.getElementById('test-api-connectivity').addEventListener('click', () => {
        const resultsDiv = document.getElementById('network-test-results');
        resultsDiv.innerHTML = 'Testing API connectivity...';
        
        const startTime = Date.now();
        
        fetch('/api/gallery/user/images', {
          credentials: 'include',
          headers: {
            'Cache-Control': 'no-cache, no-store, must-revalidate'
          }
        })
        .then(response => {
          const endTime = Date.now();
          const latency = endTime - startTime;
          
          resultsDiv.innerHTML = `
            <p><strong>API Connection:</strong> <span style="color: #4caf50;">✓ Connected</span></p>
            <p><strong>Response Status:</strong> ${response.status} ${response.statusText}</p>
            <p><strong>Latency:</strong> ${latency}ms</p>
          `;
          
          // Assess latency
          if (latency < 100) {
            resultsDiv.innerHTML += `<p><strong>Latency Assessment:</strong> <span style="color: #4caf50;">Excellent (${latency}ms)</span></p>`;
          } else if (latency < 300) {
            resultsDiv.innerHTML += `<p><strong>Latency Assessment:</strong> <span style="color: #8bc34a;">Good (${latency}ms)</span></p>`;
          } else if (latency < 500) {
            resultsDiv.innerHTML += `<p><strong>Latency Assessment:</strong> <span style="color: #ff9800;">Fair (${latency}ms)</span></p>`;
          } else {
            resultsDiv.innerHTML += `<p><strong>Latency Assessment:</strong> <span style="color: #f44336;">Poor (${latency}ms)</span></p>`;
          }
        })
        .catch(error => {
          resultsDiv.innerHTML = `
            <p><strong>API Connection:</strong> <span style="color: #f44336;">❌ Failed</span></p>
            <p><strong>Error:</strong> ${error.message}</p>
          `;
        });
