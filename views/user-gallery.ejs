          <p>Test network connectivity to key resources:</p>
          <button id="test-api-connectivity" style="background-color: #4a90e2; color: white; border: none; padding: 5px 10px; margin: 5px; cursor: pointer;">Test API Connectivity</button>
          <button id="test-cdn-connectivity" style="background-color: #4a90e2; color: white; border: none; padding: 5px 10px; margin: 5px; cursor: pointer;">Test CDN Connectivity</button>
        </div>
        <div id="network-test-results" style="background-color: #222; padding: 10px; border-radius: 4px; max-height: 300px; overflow: auto;"></div>
        
