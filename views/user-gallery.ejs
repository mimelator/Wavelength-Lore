<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="<%= cdnUrl %>/css/gallery/gallery.css">
  <link rel="stylesheet" href="<%= cdnUrl %>/css/lore_styles.css">
  <link rel="stylesheet" href="<%= cdnUrl %>/css/modal_styles.css">
  <link rel="stylesheet" href="<%= cdnUrl %>/css/gallery/gallery-buttons.css">
  <link rel="stylesheet" href="<%= cdnUrl %>/css/gallery/user-gallery.css">
  <link rel="stylesheet" href="<%= cdnUrl %>/css/shared/screensaver.css">
  <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css"/>
  <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css"/>
  <link rel="stylesheet" href="<%= cdnUrl %>/css/carousel.css">
</head>
<body>
  <!-- Include standard header -->
  <%- include('partials/header') %>

  <main class="gallery-main-container">
    <h1>My Photo Gallery</h1>
    
    <div class="intro">
      <p>Your personal collection of images from the Wavelength Lore universe.</p>
      <p>Save your favorite images by clicking "Save to Gallery" on any image throughout the site!</p>
    </div>
    
    <!-- Storage Usage Meter -->
    <div class="storage-meter-container" id="storage-meter-container">
      <h3>Storage Usage</h3>
      <div class="storage-meter">
        <div class="storage-used" id="storage-used-bar"></div>
      </div>
      <div class="storage-text" id="storage-text">Loading...</div>
    </div>
    
    <!-- Action Buttons -->
    <section class="action-buttons" id="action-buttons">
      <button id="download-all" class="action-button download-button">Download All Images</button>
      <button id="start-screensaver" class="action-button screensaver-button">Start Screensaver</button>
      <button id="select-mode" class="action-button" style="background-color: #607d8b;">Select Multiple</button>
      <button id="delete-selected" class="action-button delete-button" style="display: none;">Delete Selected</button>
    </section>
    
    <!-- Carousel Section (Default View) -->
    <section class="carousel-section" id="carousel-view">
      <div class="carousel" id="gallery-carousel">
        <!-- Images will be populated by JavaScript -->
      </div>
    </section>
    
    <!-- Gallery Controls -->
    <section class="gallery-controls">
      <button id="carousel-layout" class="layout-button active">Carousel View</button>
      <button id="grid-layout" class="layout-button">Grid View</button>
      
      <!-- Search Box -->
      <div class="search-box" style="margin-left: auto; display: flex; align-items: center;">
        <input type="text" id="gallery-search" placeholder="Search images..." 
               style="padding: 8px; border-radius: 4px; border: 2px solid #333; margin-right: 10px;">
        <button id="search-button" class="layout-button">Search</button>
      </div>
    </section>
    
    <!-- Grid View (Hidden by Default) -->
    <div id="grid-view" style="display: none;">
      <div class="gallery-grid" id="gallery-grid">
        <!-- Images will be populated by JavaScript -->
      </div>
    </div>
    
    <!-- Modal for Image Viewing -->
    <div id="imageModal" class="modal">
      <span class="modal-close">&times;</span>
      <img class="modal-content" id="fullSizeImage">
      <div id="modalCaption" class="modal-caption"></div>
      <button id="delete-image" class="action-button delete-button" style="position: absolute; bottom: 20px; right: 20px;">Delete Image</button>
    </div>
    
    <!-- Screensaver Modal -->
    <div id="screensaverModal" class="screensaver-overlay">
      <span class="modal-close">&times;</span>
      <div id="screensaver-container" class="screensaver-gallery">
        <!-- Images will be populated by JavaScript -->
      </div>
      
      <!-- Exit hint -->
      <div class="screensaver-exit-hint">
        Click anywhere or press any key to exit screensaver
      </div>
      
      <!-- Optional controls -->
      <div class="screensaver-controls" style="display: none;">
        <button class="screensaver-control" onclick="galleryScreensaver?.previousImage()" title="Previous Image">
          &#8249;
        </button>
        <button class="screensaver-control" onclick="galleryScreensaver?.nextImage()" title="Next Image">
          &#8250;
        </button>
      </div>
    </div>
  </main>
  
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
  <script src="<%= cdnUrl %>/js/shared/screensaver.js"></script>
  <script src="<%= cdnUrl %>/js/gallery/user-gallery.js"></script>
  
  <!-- Include standard footer -->
  <%- include('partials/footer') %>
  
  <!-- Gallery debugging tools (development only) -->
  <%- include('partials/gallery-debug-tools') %>
</body>
</html>