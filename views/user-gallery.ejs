    }
    
    // Populate logs tab
    function populateLogsTab() {
      const content = document.getElementById('logs-content');
      
      content.innerHTML = `
        <h3 style="color: #33ccff;">Console Logs</h3>
        <p>The most recent console logs related to gallery functionality:</p>
        <div id="console-logs" style="background-color: #222; padding: 10px; border-radius: 4px; max-height: 400px; overflow: auto; white-space: pre-wrap; font-family: monospace;"></div>
        <button id="clear-logs" style="background-color: #f44336; color: white; border: none; padding: 5px 10px; margin-top: 10px; cursor: pointer;">Clear Console</button>
        <button id="capture-logs" style="background-color: #4caf50; color: white; border: none; padding: 5px 10px; margin-top: 10px; margin-left: 10px; cursor: pointer;">Start Log Capture</button>
      `;
      
      // Get existing console logs
      const existingLogs = [];
      
      // Store original console methods
      const originalConsole = {
        log: console.log,
        info: console.info,
        warn: console.warn,
        error: console.error
      };
      
      // Function to format logs
      function formatLog(type, args) {
        const timestamp = new Date().toISOString().substr(11, 12);
        const prefix = `[${timestamp}] [${type.toUpperCase()}] `;
        
        let message = '';
        
        for (const arg of args) {
          if (typeof arg === 'object') {
            try {
              message += JSON.stringify(arg) + ' ';
            } catch (e) {
              message += arg + ' ';
            }
          } else {
            message += arg + ' ';
          }
        }
        
        let color = '';
        switch (type) {
          case 'error':
            color = '#f44336';
            break;
          case 'warn':
            color = '#ff9800';
            break;
          case 'info':
            color = '#2196f3';
            break;
          default:
            color = '#ffffff';
        }
        
        return `<span style="color: ${color}">${prefix}${message}</span>`;
      }
      
      // Handle clear logs button
      document.getElementById('clear-logs').addEventListener('click', () => {
        document.getElementById('console-logs').innerHTML = '';
        console.clear();
      });
      
      // Handle capture logs button
      const captureButton = document.getElementById('capture-logs');
      let isCapturing = false;
      
      captureButton.addEventListener('click', () => {
        if (isCapturing) {
          // Stop capturing
          isCapturing = false;
          captureButton.textContent = 'Start Log Capture';
          captureButton.style.backgroundColor = '#4caf50';
          
          // Restore original console methods
          console.log = originalConsole.log;
          console.info = originalConsole.info;
          console.warn = originalConsole.warn;
          console.error = originalConsole.error;
        } else {
          // Start capturing
          isCapturing = true;
          captureButton.textContent = 'Stop Log Capture';
          captureButton.style.backgroundColor = '#f44336';
          
          const logsDiv = document.getElementById('console-logs');
          
          // Override console methods
          console.log = function() {
            const formattedLog = formatLog('log', arguments);
            logsDiv.innerHTML += formattedLog + '<br>';
            logsDiv.scrollTop = logsDiv.scrollHeight;
            originalConsole.log.apply(console, arguments);
          };
          
          console.info = function() {
            const formattedLog = formatLog('info', arguments);
            logsDiv.innerHTML += formattedLog + '<br>';
            logsDiv.scrollTop = logsDiv.scrollHeight;
            originalConsole.info.apply(console, arguments);
          };
          
          console.warn = function() {
            const formattedLog = formatLog('warn', arguments);
            logsDiv.innerHTML += formattedLog + '<br>';
            logsDiv.scrollTop = logsDiv.scrollHeight;
            originalConsole.warn.apply(console, arguments);
          };
          
          console.error = function() {
            const formattedLog = formatLog('error', arguments);
            logsDiv.innerHTML += formattedLog + '<br>';
            logsDiv.scrollTop = logsDiv.scrollHeight;
            originalConsole.error.apply(console, arguments);
          };
          
          logsDiv.innerHTML += '<span style="color: #4caf50">Log capture started...</span><br>';
        }
      });
      
      // Display any existing errors from the console
      if (window.console && window.console.error && window.console.error.logs) {
        const logsDiv = document.getElementById('console-logs');
        logsDiv.innerHTML += '<span style="color: #f44336">Previous errors:</span><br>';
        
        for (const log of window.console.error.logs) {
          logsDiv.innerHTML += formatLog('error', log) + '<br>';
        }
      }
    }
  </script>
