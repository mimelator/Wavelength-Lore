<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="<%= cdnUrl %>/css/lore_styles.css">
    <link rel="stylesheet" href="/css/lore_styles.css">
    <link rel="stylesheet" href="<%= cdnUrl %>/css/gallery_styles.css">
    <link rel="stylesheet" href="/css/gallery_styles.css">
    <style>
        /* Visibility indicator styles */
        .visibility-indicator {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            color: #f1c40f;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: bold;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }
        
        .gallery-item {
            position: relative;
        }
        
        .gallery-item.hidden-content {
            opacity: 0.7;
            border: 2px dashed #f1c40f;
        }
        
        .gallery-item.hidden-content:hover {
            opacity: 1;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <%- include('partials/banner') %>

    <main>
        <h1>Lore Gallery</h1>
        <p class="gallery-subtitle">Explore the places, things, concepts, and ideas of the Wavelength universe</p>
        
        <section class="lore-gallery">
            <div class="gallery">
                <% lore.forEach(loreItem => { %>
                    <div class="gallery-item lore-item <%= loreItem.visible === false ? 'hidden-content' : '' %>">
                        <% if (isContentCreator && loreItem.visible === false) { %>
                            <div class="visibility-indicator" title="This lore is hidden from public view">
                                🔒 <span>HIDDEN</span>
                            </div>
                        <% } %>
                        <a href="/lore/<%= loreItem.id %>">
                            <img src="<%= loreItem.image.startsWith('http') ? loreItem.image : cdnUrl + loreItem.image %>" alt="<%= loreItem.title %>">
                            <h2><%= loreItem.title %></h2>
                            <div class="lore-type-badge">
                                <span class="type-<%= loreItem.type %>"><%= loreItem.type %></span>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>