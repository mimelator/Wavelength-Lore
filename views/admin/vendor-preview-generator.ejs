<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Wavelength Lore</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-panel.css">
    <style>
        .preview-generator-container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .admin-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .admin-header h1 {
            margin: 0;
            font-size: 2.5em;
            font-weight: 300;
        }
        
        .admin-header p {
            margin: 10px 0 0 0;
            opacity: 0.9;
            font-size: 1.1em;
        }
        
        .step-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            border: 1px solid #e1e8ed;
        }
        
        .step-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .step-number {
            background: #667eea;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 15px;
        }
        
        .step-title {
            font-size: 1.4em;
            margin: 0;
            color: #1a202c;
        }
        
        .image-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .image-item {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }
        
        .image-item:hover {
            border-color: #667eea;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.15);
        }
        
        .image-item.selected {
            border-color: #10b981;
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        }
        
        .image-preview {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 10px;
        }
        
        .image-title {
            font-size: 0.9em;
            color: #4a5568;
            margin: 0;
            word-break: break-word;
        }
        
        .selected-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #10b981;
            color: white;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.7em;
            font-weight: 500;
        }
        
        .product-types {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }
        
        .product-type-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .product-type-card:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        
        .product-type-card.selected {
            border-color: #10b981;
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        }
        
        .product-icon {
            font-size: 3em;
            margin-bottom: 10px;
        }
        
        .product-name {
            font-size: 1.2em;
            font-weight: 600;
            margin: 0;
            color: #1a202c;
        }
        
        .product-description {
            font-size: 0.9em;
            color: #718096;
            margin: 5px 0 0 0;
        }
        
        .vendor-selection {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .vendor-checkbox-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .vendor-checkbox-card:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        
        .vendor-checkbox-card.selected {
            border-color: #10b981;
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        }
        
        .vendor-checkbox {
            margin-right: 10px;
        }
        
        .vendor-name {
            font-size: 1.1em;
            font-weight: 600;
            margin: 0;
        }
        
        .vendor-location {
            color: #718096;
            font-size: 0.9em;
            margin: 5px 0;
        }
        
        .vendor-stats {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 0.85em;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-value {
            font-weight: 600;
            color: #2d3748;
        }
        
        .stat-label {
            color: #718096;
        }
        
        .generate-section {
            background: #1a202c;
            color: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
        }
        
        .generate-btn {
            background: #10b981;
            color: white;
            padding: 15px 30px;
            border: none;
            border-radius: 8px;
            font-size: 1.2em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 20px 10px;
        }
        
        .generate-btn:hover {
            background: #059669;
            transform: translateY(-2px);
        }
        
        .generate-btn:disabled {
            background: #4a5568;
            cursor: not-allowed;
            transform: none;
        }
        
        .progress-section {
            background: #fef3c7;
            border: 1px solid #f59e0b;
            color: #92400e;
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            display: none;
        }
        
        .progress-bar {
            width: 100%;
            height: 8px;
            background: #e2e8f0;
            border-radius: 4px;
            overflow: hidden;
            margin: 10px 0;
        }
        
        .progress-fill {
            height: 100%;
            background: #10b981;
            transition: width 0.3s ease;
            width: 0%;
        }
        
        .results-section {
            margin-top: 30px;
            display: none;
        }
        
        .vendor-preview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 30px;
        }
        
        .vendor-preview-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            border: 1px solid #e1e8ed;
        }
        
        .vendor-preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f1f3f4;
        }
        
        .vendor-name-large {
            font-size: 1.3em;
            font-weight: 600;
            color: #1a202c;
        }
        
        .quality-score {
            background: #10b981;
            color: white;
            padding: 5px 10px;
            border-radius: 6px;
            font-weight: 600;
        }
        
        .mockup-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
            margin: 15px 0;
        }
        
        .mockup-image {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }
        
        .vendor-details {
            margin: 15px 0;
        }
        
        .detail-row {
            display: flex;
            justify-content: space-between;
            margin: 8px 0;
            font-size: 0.9em;
        }
        
        .detail-label {
            color: #718096;
        }
        
        .detail-value {
            font-weight: 600;
            color: #2d3748;
        }
        
        .recent-comparisons {
            background: #f8fafc;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
        }
        
        .comparison-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #e2e8f0;
        }
        
        .comparison-info {
            flex: 1;
        }
        
        .comparison-title {
            font-weight: 600;
            color: #1a202c;
        }
        
        .comparison-meta {
            font-size: 0.85em;
            color: #718096;
            margin-top: 2px;
        }
        
        .comparison-actions {
            display: flex;
            gap: 10px;
        }
        
        .btn-small {
            padding: 5px 10px;
            font-size: 0.8em;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .btn-view {
            background: #667eea;
            color: white;
        }
        
        .btn-delete {
            background: #dc2626;
            color: white;
        }
        
        .notification {
            background: #fef3c7;
            border: 1px solid #f59e0b;
            color: #92400e;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        
        .notification.success {
            background: #d1fae5;
            border-color: #10b981;
            color: #065f46;
        }
        
        .notification.error {
            background: #fee2e2;
            border-color: #dc2626;
            color: #991b1b;
        }
        
        /* Cache Performance Styles */
        .cache-performance-section {
            background: linear-gradient(135deg, #e3f2fd 0%, #f8f9fa 100%);
            border: 2px solid #1976d2;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 5px 15px rgba(25, 118, 210, 0.1);
        }
        
        .cache-performance-section h4 {
            margin: 0 0 20px 0;
            color: #1976d2;
            font-size: 1.3em;
            font-weight: 600;
        }
        
        .cache-metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .cache-metric {
            background: white;
            padding: 15px;
            border-radius: 10px;
            border: 1px solid #e1e8ed;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .metric-label {
            font-size: 0.9em;
            color: #718096;
            margin-bottom: 5px;
        }
        
        .metric-value {
            font-size: 1.8em;
            font-weight: 700;
            color: #1976d2;
        }
        
        .cache-efficiency-bar {
            display: flex;
            align-items: center;
            gap: 15px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            border: 1px solid #e1e8ed;
        }
        
        .efficiency-label {
            font-weight: 600;
            color: #2d3748;
            white-space: nowrap;
        }
        
        .efficiency-bar {
            flex: 1;
            height: 20px;
            background: #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
        }
        
        .efficiency-progress {
            height: 100%;
            background: linear-gradient(90deg, #4caf50 0%, #8bc34a 100%);
            transition: width 0.5s ease;
        }
        
        .efficiency-text {
            font-weight: 600;
            color: #4caf50;
            white-space: nowrap;
        }
        
        /* Cache Status Indicators */
        .cache-hit {
            color: #4caf50 !important;
            font-weight: 600;
        }
        
        .cache-miss {
            color: #ff9800 !important;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="preview-generator-container">
        <!-- Admin Header -->
        <div class="admin-header">
            <h1>🎨 Vendor Preview Generator</h1>
            <p>Generate product mockups from multiple vendors using your artwork to visually compare quality, appearance, and options</p>
        </div>

        <!-- Recent Comparisons -->
        <% if (recentComparisons && recentComparisons.length > 0) { %>
        <div class="recent-comparisons">
            <h3>📊 Recent Vendor Comparisons</h3>
            <% recentComparisons.forEach(comparison => { %>
            <div class="comparison-item">
                <div class="comparison-info">
                    <div class="comparison-title">
                        <%= comparison.productType.charAt(0).toUpperCase() + comparison.productType.slice(1) %> 
                        (<%= comparison.vendorIds ? comparison.vendorIds.length : 0 %> vendors)
                    </div>
                    <div class="comparison-meta">
                        Generated <%= new Date(comparison.report?.generatedAt || Date.now()).toLocaleDateString() %> | 
                        Image: <%= comparison.imageId %>
                    </div>
                </div>
                <div class="comparison-actions">
                    <button class="btn-small btn-view" onclick="viewComparison('<%= comparison.id %>')">View</button>
                    <button class="btn-small btn-delete" onclick="deleteComparison('<%= comparison.id %>')">Delete</button>
                </div>
            </div>
            <% }); %>
        </div>
        <% } %>

        <!-- Notification Area -->
        <div id="notification" class="notification" style="display: none;"></div>

        <!-- Step 1: Select Artwork -->
        <div class="step-section">
            <div class="step-header">
                <div class="step-number">1</div>
                <h2 class="step-title">Select Your Artwork</h2>
            </div>
            <p>Choose an image from your gallery to use for vendor preview generation:</p>
            
            <div class="image-gallery">
                <% userImages.forEach(image => { %>
                <div class="image-item" onclick="selectImage('<%= image.relativePath %>')" data-image-id="<%= image.relativePath %>">
                    <img src="<%= image.url %>" alt="<%= image.originalName %>" class="image-preview">
                    <p class="image-title"><%= image.originalName || image.fileName %></p>
                </div>
                <% }); %>
            </div>
        </div>

        <!-- Step 2: Choose Product Type -->
        <div class="step-section">
            <div class="step-header">
                <div class="step-number">2</div>
                <h2 class="step-title">Choose Product Type</h2>
            </div>
            <p>Select the type of product you want to preview:</p>
            
            <div class="product-types">
                <div class="product-type-card" onclick="selectProductType('premium-tshirt')" data-product-type="premium-tshirt">
                    <div class="product-icon">👕</div>
                    <h3 class="product-name">Premium T-Shirt</h3>
                    <p class="product-description">High-quality cotton t-shirt</p>
                </div>
                <div class="product-type-card" onclick="selectProductType('mug')" data-product-type="mug">
                    <div class="product-icon">☕</div>
                    <h3 class="product-name">Ceramic Mug</h3>
                    <p class="product-description">Premium ceramic mug</p>
                </div>
                <div class="product-type-card" onclick="selectProductType('poster')" data-product-type="poster">
                    <div class="product-icon">🖼️</div>
                    <h3 class="product-name">Premium Poster</h3>
                    <p class="product-description">High-quality poster print</p>
                </div>
                <div class="product-type-card" onclick="selectProductType('hoodie')" data-product-type="hoodie">
                    <div class="product-icon">🧥</div>
                    <h3 class="product-name">Pullover Hoodie</h3>
                    <p class="product-description">Cozy hoodie with front pocket</p>
                </div>
            </div>
        </div>

        <!-- Step 3: Select Vendors -->
        <div class="step-section">
            <div class="step-header">
                <div class="step-number">3</div>
                <h2 class="step-title">Select Vendors to Compare</h2>
            </div>
            <p>Choose which print providers you want to generate previews from:</p>
            
            <div id="vendorSelection" class="vendor-selection">
                <!-- Will be populated based on selected product type -->
            </div>
        </div>

        <!-- Generation Section -->
        <div class="generate-section">
            <h3>🚀 Generate Vendor Previews</h3>
            <p>Create mockups from selected vendors to compare quality, appearance, and options</p>
            
            <div id="selectionSummary" style="margin: 20px 0; opacity: 0.7;">
                <p>Select an image, product type, and at least one vendor to continue</p>
            </div>
            
            <button id="generateBtn" class="generate-btn" onclick="generatePreviews()" disabled>
                🎨 Generate Previews
            </button>
        </div>

        <!-- Progress Section -->
        <div id="progressSection" class="progress-section">
            <h4>Generating Vendor Previews...</h4>
            <div class="progress-bar">
                <div id="progressFill" class="progress-fill"></div>
            </div>
            <p id="progressText">Preparing preview generation...</p>
        </div>

        <!-- Results Section -->
        <div id="resultsSection" class="results-section">
            <h3>🎯 Vendor Preview Results</h3>
            
            <!-- Cache Performance Metrics -->
            <div id="cachePerformanceSection" class="cache-performance-section" style="display: none;">
                <h4>⚡ Global Cache Performance</h4>
                <div class="cache-metrics-grid">
                    <div class="cache-metric">
                        <div class="metric-label">Cache Hit Rate</div>
                        <div id="cacheHitRate" class="metric-value">0%</div>
                    </div>
                    <div class="cache-metric">
                        <div class="metric-label">Enhancements Reused</div>
                        <div id="enhancementsReused" class="metric-value">0</div>
                    </div>
                    <div class="cache-metric">
                        <div class="metric-label">Processing Time Saved</div>
                        <div id="timeSaved" class="metric-value">0ms</div>
                    </div>
                    <div class="cache-metric">
                        <div class="metric-label">Average Time per Vendor</div>
                        <div id="avgTimePerVendor" class="metric-value">0ms</div>
                    </div>
                </div>
                <div class="cache-efficiency-bar">
                    <div class="efficiency-label">Cache Efficiency:</div>
                    <div class="efficiency-bar">
                        <div id="efficiencyProgress" class="efficiency-progress" style="width: 0%"></div>
                    </div>
                    <div id="efficiencyText" class="efficiency-text">No data</div>
                </div>
            </div>
            
            <div id="vendorPreviews" class="vendor-preview-grid">
                <!-- Results will be populated here -->
            </div>
        </div>
    </div>

    <script>
        let selectedImage = null;
        let selectedProductType = null;
        let selectedVendors = [];

        // Vendor data for each product type
        const vendorsByProduct = {
            'premium-tshirt': <%- JSON.stringify((vendorData && vendorData.tshirts && vendorData.tshirts.alternatives) ? vendorData.tshirts.alternatives : []) %>,
            'mug': <%- JSON.stringify((vendorData && vendorData.mugs && vendorData.mugs.alternatives) ? vendorData.mugs.alternatives : []) %>,
            'poster': <%- JSON.stringify((vendorData && vendorData.posters && vendorData.posters.alternatives) ? vendorData.posters.alternatives : []) %>,
            'hoodie': <%- JSON.stringify((vendorData && vendorData.hoodies && vendorData.hoodies.alternatives) ? vendorData.hoodies.alternatives : (vendorData && vendorData.tshirts && vendorData.tshirts.alternatives) ? vendorData.tshirts.alternatives : []) %>
        };

        function selectImage(imageId) {
            // Remove previous selection
            document.querySelectorAll('.image-item').forEach(item => {
                item.classList.remove('selected');
                const badge = item.querySelector('.selected-badge');
                if (badge) badge.remove();
            });

            // Add selection to clicked item
            const clickedItem = document.querySelector(`[data-image-id="${imageId}"]`);
            clickedItem.classList.add('selected');
            clickedItem.innerHTML += '<div class="selected-badge">✓ Selected</div>';

            selectedImage = imageId;
            updateGenerateButton();
            updateSelectionSummary();
        }

        function selectProductType(productType) {
            // Remove previous selection
            document.querySelectorAll('.product-type-card').forEach(card => {
                card.classList.remove('selected');
            });

            // Add selection to clicked card
            const clickedCard = document.querySelector(`[data-product-type="${productType}"]`);
            clickedCard.classList.add('selected');

            selectedProductType = productType;
            selectedVendors = []; // Reset vendor selection
            updateVendorSelection();
            updateGenerateButton();
            updateSelectionSummary();
        }

        function updateVendorSelection() {
            const vendorSelection = document.getElementById('vendorSelection');
            const vendors = vendorsByProduct[selectedProductType] || [];

            vendorSelection.innerHTML = vendors.map(vendor => `
                <div class="vendor-checkbox-card" onclick="toggleVendor(${vendor.id})">
                    <label>
                        <input type="checkbox" class="vendor-checkbox" data-vendor-id="${vendor.id}">
                        <span class="vendor-name">${vendor.name}</span>
                    </label>
                    <div class="vendor-location">📍 ${vendor.location}</div>
                    <div class="vendor-stats">
                        <div class="stat-item">
                            <div class="stat-value">${vendor.qualityRating}/5</div>
                            <div class="stat-label">Quality</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${vendor.priceRange}</div>
                            <div class="stat-label">Price</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${vendor.speedRating}/5</div>
                            <div class="stat-label">Speed</div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function toggleVendor(vendorId) {
            const checkbox = document.querySelector(`[data-vendor-id="${vendorId}"]`);
            const card = checkbox.closest('.vendor-checkbox-card');
            
            checkbox.checked = !checkbox.checked;
            
            if (checkbox.checked) {
                card.classList.add('selected');
                if (!selectedVendors.includes(vendorId)) {
                    selectedVendors.push(vendorId);
                }
            } else {
                card.classList.remove('selected');
                selectedVendors = selectedVendors.filter(id => id !== vendorId);
            }
            
            updateGenerateButton();
            updateSelectionSummary();
        }

        function updateGenerateButton() {
            const generateBtn = document.getElementById('generateBtn');
            const canGenerate = selectedImage && selectedProductType && selectedVendors.length > 0;
            
            generateBtn.disabled = !canGenerate;
            generateBtn.textContent = canGenerate ? 
                `🎨 Generate Previews (${selectedVendors.length} vendors)` : 
                '🎨 Generate Previews';
        }

        function updateSelectionSummary() {
            const summary = document.getElementById('selectionSummary');
            const parts = [];
            
            if (selectedImage) parts.push(`Image: ${selectedImage}`);
            if (selectedProductType) parts.push(`Product: ${selectedProductType}`);
            if (selectedVendors.length > 0) parts.push(`${selectedVendors.length} vendor(s)`);
            
            summary.innerHTML = parts.length > 0 ? 
                `<p>Selected: ${parts.join(' • ')}</p>` :
                '<p>Select an image, product type, and at least one vendor to continue</p>';
        }

        async function generatePreviews() {
            if (!selectedImage || !selectedProductType || selectedVendors.length === 0) {
                showNotification('Please select an image, product type, and at least one vendor', 'error');
                return;
            }

            // Show progress
            const progressSection = document.getElementById('progressSection');
            const resultsSection = document.getElementById('resultsSection');
            const progressFill = document.getElementById('progressFill');
            const progressText = document.getElementById('progressText');
            
            progressSection.style.display = 'block';
            resultsSection.style.display = 'none';
            
            // Animate progress
            let progress = 0;
            const progressInterval = setInterval(() => {
                progress += 5;
                progressFill.style.width = Math.min(progress, 90) + '%';
                
                if (progress < 30) {
                    progressText.textContent = 'Uploading artwork to vendors...';
                } else if (progress < 60) {
                    progressText.textContent = 'Generating product mockups...';
                } else if (progress < 90) {
                    progressText.textContent = 'Processing quality assessments...';
                }
            }, 200);

            try {
                const response = await fetch('/admin/vendor-research/generate-previews', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        imageId: selectedImage,
                        productType: selectedProductType,
                        vendorIds: selectedVendors
                    })
                });

                const result = await response.json();
                clearInterval(progressInterval);
                progressFill.style.width = '100%';
                progressText.textContent = 'Complete!';

                setTimeout(() => {
                    progressSection.style.display = 'none';
                    if (result.success) {
                        displayResults(result.data);
                        showNotification(`Successfully generated ${result.data.previews.length} vendor previews!`, 'success');
                    } else {
                        showNotification('Failed to generate previews: ' + result.error, 'error');
                    }
                }, 1000);

            } catch (error) {
                clearInterval(progressInterval);
                progressSection.style.display = 'none';
                showNotification('Error generating previews: ' + error.message, 'error');
            }
        }

        function displayResults(data) {
            const resultsSection = document.getElementById('resultsSection');
            const vendorPreviews = document.getElementById('vendorPreviews');
            const cachePerformanceSection = document.getElementById('cachePerformanceSection');
            
            // Display cache performance metrics
            if (data.cachePerformance) {
                displayCachePerformance(data.cachePerformance);
                cachePerformanceSection.style.display = 'block';
            }
            
            vendorPreviews.innerHTML = data.previews.map(preview => `
                <div class="vendor-preview-card">
                    <div class="vendor-preview-header">
                        <div class="vendor-name-large">${preview.vendorName}</div>
                        <div class="quality-score">${calculateQualityScore(preview)}/10</div>
                    </div>
                    
                    <div class="mockup-gallery">
                        ${preview.mockupImages.slice(0, 4).map(img => `
                            <img src="${img.src}" alt="Mockup" class="mockup-image">
                        `).join('')}
                    </div>
                    
                    <div class="vendor-details">
                        <div class="detail-row">
                            <span class="detail-label">Location:</span>
                            <span class="detail-value">${preview.vendorLocation?.city || 'Unknown'}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Price Range:</span>
                            <span class="detail-value">${preview.pricing.range}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Variants:</span>
                            <span class="detail-value">${preview.variants.length} options</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Quality Enhancement:</span>
                            <span class="detail-value">${preview.qualityMetrics.enhancementApplied ? 'Applied' : 'None'}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Processing Time:</span>
                            <span class="detail-value">${preview.processingTime ? preview.processingTime + 'ms' : 'N/A'}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Cache Status:</span>
                            <span class="detail-value ${preview.cacheOptimization?.globalCacheUsed ? 'cache-hit' : 'cache-miss'}">
                                ${preview.cacheOptimization?.globalCacheUsed ? '⚡ Cache Hit' : '🔨 Generated'}
                            </span>
                        </div>
                    </div>
                </div>
            `).join('');
            
            resultsSection.style.display = 'block';
            resultsSection.scrollIntoView({ behavior: 'smooth' });
        }

        function displayCachePerformance(performance) {
            document.getElementById('cacheHitRate').textContent = `${performance.cacheHitRate.toFixed(1)}%`;
            document.getElementById('enhancementsReused').textContent = performance.enhancementsReused;
            document.getElementById('avgTimePerVendor').textContent = `${performance.averageTimePerVendor.toFixed(0)}ms`;
            
            // Calculate estimated time saved based on typical enhancement time
            const typicalEnhancementTime = 15000; // 15 seconds average
            const timeSaved = performance.enhancementsReused * typicalEnhancementTime;
            document.getElementById('timeSaved').textContent = timeSaved > 1000 ? 
                `${(timeSaved / 1000).toFixed(1)}s` : `${timeSaved}ms`;
            
            // Update efficiency bar
            const efficiencyPercent = Math.min(performance.cacheHitRate, 100);
            document.getElementById('efficiencyProgress').style.width = `${efficiencyPercent}%`;
            
            let efficiencyText = 'Poor';
            if (efficiencyPercent > 75) efficiencyText = 'Excellent';
            else if (efficiencyPercent > 50) efficiencyText = 'Good';
            else if (efficiencyPercent > 25) efficiencyText = 'Fair';
            
            document.getElementById('efficiencyText').textContent = `${efficiencyText} (${efficiencyPercent.toFixed(1)}%)`;
        }

        function calculateQualityScore(preview) {
            // Simple quality scoring based on available data
            let score = 0;
            if (preview.mockupImages.length > 0) score += 3;
            if (preview.mockupImages.length > 3) score += 2;
            if (preview.variants.length > 5) score += 2;
            if (preview.qualityMetrics.enhancementApplied) score += 3;
            return Math.min(score, 10);
        }

        function viewComparison(comparisonId) {
            window.open(`/admin/vendor-research/comparison/${comparisonId}`, '_blank');
        }

        async function deleteComparison(comparisonId) {
            if (!confirm('Delete this vendor comparison?')) return;
            
            try {
                const response = await fetch(`/admin/vendor-research/comparison/${comparisonId}`, {
                    method: 'DELETE'
                });
                
                const result = await response.json();
                if (result.success) {
                    showNotification('Comparison deleted successfully', 'success');
                    location.reload(); // Refresh to update the list
                } else {
                    showNotification('Failed to delete comparison: ' + result.error, 'error');
                }
            } catch (error) {
                showNotification('Error: ' + error.message, 'error');
            }
        }

        function showNotification(message, type = 'info') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type}`;
            notification.style.display = 'block';
            
            setTimeout(() => {
                notification.style.display = 'none';
            }, 5000);
        }

        // Initialize the page
        document.addEventListener('DOMContentLoaded', function() {
            updateGenerateButton();
        });
    </script>
</body>
</html>