<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Management - Wavelength Admin</title>
    
    <!-- Bootstrap CSS for base styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Custom Group Management CSS -->
    <link rel="stylesheet" href="/css/group-management.css">
    
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .admin-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }
        
        .admin-nav {
            background: white;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }
        
        .nav-link {
            color: #495057;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 6px;
            transition: all 0.2s ease;
        }
        
        .nav-link:hover {
            background-color: #f8f9fa;
            color: #667eea;
        }
        
        .nav-link.active {
            background-color: #667eea;
            color: white;
        }
        
        .footer {
            margin-top: 40px;
            padding: 20px 0;
            text-align: center;
            color: #6c757d;
            border-top: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
    <!-- Admin Header -->
    <div class="admin-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fas fa-shield-alt"></i> Wavelength Admin Panel</h1>
                    <p class="mb-0">Group Management & User Permissions</p>
                </div>
                <div class="col-md-4 text-end">
                    <div class="admin-user-info">
                        <small>Logged in as:</small><br>
                        <strong id="current-admin-user">Loading...</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Navigation -->
        <nav class="admin-nav">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link active" href="#groups" data-bs-toggle="pill">
                        <i class="fas fa-users"></i> Group Management
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin">
                        <i class="fas fa-tachometer-alt"></i> Main Admin Panel
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/users">
                        <i class="fas fa-user-friends"></i> User Management
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/forum">
                        <i class="fas fa-comments"></i> Forum
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="tab-content">
            <div class="tab-pane fade show active" id="groups">
                <!-- Quick Stats -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h5 class="card-title text-primary">
                                    <i class="fas fa-layer-group"></i>
                                </h5>
                                <h4 id="total-groups" class="mb-0">-</h4>
                                <small class="text-muted">Total Groups</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h5 class="card-title text-success">
                                    <i class="fas fa-users"></i>
                                </h5>
                                <h4 id="total-users" class="mb-0">-</h4>
                                <small class="text-muted">Total Users</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h5 class="card-title text-warning">
                                    <i class="fas fa-key"></i>
                                </h5>
                                <h4 id="my-permissions" class="mb-0">-</h4>
                                <small class="text-muted">My Permissions</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h5 class="card-title text-info">
                                    <i class="fas fa-crown"></i>
                                </h5>
                                <h4 id="my-level" class="mb-0">-</h4>
                                <small class="text-muted">My Level</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Group Management Interface -->
                <div id="group-management-container"></div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="container">
                <p>&copy; 2024 Wavelength. All rights reserved. | Group Management System v1.0</p>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Firebase SDK (if needed for authentication) -->
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-auth-compat.js"></script>
    
    <!-- Group Management JavaScript -->
    <script src="/js/group-management.js"></script>
    
    <script>
        // Initialize Firebase if config is available
        if (window.firebaseConfig) {
            firebase.initializeApp(window.firebaseConfig);
            window.firebaseAuth = firebase.auth();
        }

        // Page initialization
        document.addEventListener('DOMContentLoaded', async function() {
            console.log('🚀 Group Management Admin Panel initializing...');
            
            try {
                // Wait for group manager to initialize
                if (window.groupManager) {
                    await waitForGroupManager();
                    updateQuickStats();
                } else {
                    console.log('⏳ Waiting for GroupManager to load...');
                    // Group manager will auto-initialize when the container is ready
                    setTimeout(async () => {
                        if (window.groupManager) {
                            await waitForGroupManager();
                            updateQuickStats();
                        }
                    }, 1000);
                }
                
                // Update current admin user display
                updateCurrentUserDisplay();
                
            } catch (error) {
                console.error('❌ Failed to initialize admin panel:', error);
            }
        });

        async function waitForGroupManager() {
            // Wait for group manager to be ready
            let attempts = 0;
            while (!window.groupManager?.userPermissions && attempts < 10) {
                await new Promise(resolve => setTimeout(resolve, 500));
                attempts++;
            }
        }

        function updateQuickStats() {
            if (!window.groupManager) return;
            
            const { userPermissions, groupHierarchy } = window.groupManager;
            
            if (groupHierarchy) {
                document.getElementById('total-groups').textContent = Object.keys(groupHierarchy).length;
            }
            
            if (userPermissions) {
                document.getElementById('my-permissions').textContent = userPermissions.permissions?.length || 0;
                
                // Find user's highest privilege level
                const userGroups = userPermissions.groups || [];
                let highestLevel = 0;
                
                userGroups.forEach(group => {
                    if (groupHierarchy?.[group]?.level > highestLevel) {
                        highestLevel = groupHierarchy[group].level;
                    }
                });
                
                document.getElementById('my-level').textContent = highestLevel;
            }
        }

        function updateCurrentUserDisplay() {
            const urlParams = new URLSearchParams(window.location.search);
            const adminKey = urlParams.get('adminKey');
            
            if (adminKey) {
                document.getElementById('current-admin-user').textContent = 'Admin (via key)';
            } else if (window.firebaseAuth?.currentUser) {
                window.firebaseAuth.onAuthStateChanged(user => {
                    if (user) {
                        document.getElementById('current-admin-user').textContent = 
                            user.displayName || user.email || 'Authenticated User';
                    } else {
                        document.getElementById('current-admin-user').textContent = 'Not authenticated';
                    }
                });
            } else {
                document.getElementById('current-admin-user').textContent = 'Authentication unknown';
            }
        }

        // Add some interactive features
        document.addEventListener('click', function(e) {
            // Handle quick actions
            if (e.target.matches('.quick-action-btn')) {
                const action = e.target.dataset.action;
                handleQuickAction(action);
            }
        });

        function handleQuickAction(action) {
            switch (action) {
                case 'refresh-stats':
                    updateQuickStats();
                    break;
                case 'export-groups':
                    exportGroupData();
                    break;
                default:
                    console.log('Unknown action:', action);
            }
        }

        function exportGroupData() {
            if (!window.groupManager?.groupHierarchy) {
                alert('Group data not available');
                return;
            }
            
            const data = {
                hierarchy: window.groupManager.groupHierarchy,
                exported: new Date().toISOString(),
                version: '1.0'
            };
            
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = `wavelength-groups-${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + R for refresh
            if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
                e.preventDefault();
                updateQuickStats();
                if (window.groupManager) {
                    window.groupManager.loadGroupHierarchy();
                }
            }
        });

        // Add periodic stats refresh
        setInterval(() => {
            if (document.visibilityState === 'visible') {
                updateQuickStats();
            }
        }, 30000); // Every 30 seconds when page is visible
    </script>
</body>
</html>