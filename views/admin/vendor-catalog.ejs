<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Vendor Catalog' %> - Wavelength Admin</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg">
    
    <!-- CSS Imports -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/forum.css">
    
    <style>
        .catalog-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .catalog-header {
            background: rgba(255, 255, 255, 0.9);
            border: 5px solid black;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }
        
        .stat-card {
            background: #f8f9fa;
            border: 2px solid #333;
            border-radius: 6px;
            padding: 15px;
            text-align: center;
        }
        
        .stat-number {
            font-size: 24px;
            font-weight: bold;
            color: #007bff;
        }
        
        .stat-label {
            font-size: 12px;
            color: #666;
            margin-top: 5px;
        }
        
        .filters {
            background: rgba(255, 255, 255, 0.9);
            border: 3px solid #333;
            border-radius: 6px;
            padding: 15px;
            margin-bottom: 20px;
        }
        
        .filter-group {
            display: inline-block;
            margin-right: 20px;
        }
        
        .filter-select, .filter-input {
            padding: 8px 12px;
            border: 2px solid #333;
            border-radius: 4px;
            margin-left: 10px;
        }
        
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 30px 0;
            gap: 10px;
        }
        
        .pagination button {
            padding: 8px 12px;
            border: 2px solid #333;
            background: white;
            cursor: pointer;
            border-radius: 4px;
        }
        
        .pagination button:hover {
            background: #f0f0f0;
        }
        
        .pagination button.active {
            background: #007bff;
            color: white;
        }
        
        .pagination button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .view-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 15px 0;
            padding: 10px;
            background: #f8f9fa;
            border: 2px solid #333;
            border-radius: 6px;
        }
        
        .view-mode {
            display: flex;
            gap: 10px;
        }
        
        .view-mode button {
            padding: 6px 12px;
            border: 2px solid #333;
            background: white;
            cursor: pointer;
            border-radius: 4px;
        }
        
        .view-mode button.active {
            background: #007bff;
            color: white;
        }
        
        .products-grid.compact {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 10px;
        }
        
        .products-grid.compact .product-card {
            padding: 10px;
        }
        
        .products-grid.compact .product-image-preview img {
            height: 100px;
        }
        
        .products-grid.list {
            grid-template-columns: 1fr;
            gap: 10px;
        }
        
        .products-grid.list .product-card {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
        }
        
        .products-grid.list .product-image-preview {
            flex-shrink: 0;
            width: 80px;
        }
        
        .products-grid.list .product-image-preview img {
            width: 80px;
            height: 80px;
        }
        
        .products-grid.list .product-content {
            flex-grow: 1;
        }
        
        .products-grid.list .product-actions {
            flex-shrink: 0;
            margin: 0;
        }
        
        .product-card {
            background: rgba(255, 255, 255, 0.95);
            border: 3px solid #333;
            border-radius: 8px;
            padding: 15px;
            transition: transform 0.2s;
        }
        
        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }
        
        .product-title {
            font-weight: bold;
            color: #007bff;
            margin-bottom: 10px;
        }
        
        .product-meta {
            font-size: 12px;
            color: #666;
            margin: 5px 0;
        }
        
        .product-actions {
            margin-top: 15px;
            text-align: center;
        }
        
        .btn {
            display: inline-block;
            padding: 8px 16px;
            margin: 5px;
            background: #007bff;
            color: white;
            text-decoration: none;
            border: 2px solid #333;
            border-radius: 4px;
            font-size: 12px;
            transition: all 0.2s;
        }
        
        .btn:hover {
            background: #0056b3;
            transform: translateY(-1px);
        }
        
        .btn-danger {
            background: #dc3545;
        }
        
        .btn-danger:hover {
            background: #c82333;
        }
        
        .btn-border {
            background: #28a745;
            border-color: #28a745;
        }
        
        .btn-border:hover {
            background: #218838;
            border-color: #1e7e34;
        }
        
        .product-image-preview {
            text-align: center;
            margin: 10px 0;
        }
        
        .product-image-preview img {
            transition: transform 0.2s;
        }
        
        .product-image-preview img:hover {
            transform: scale(1.05);
        }
        
        .loading {
            text-align: center;
            padding: 40px;
            color: #666;
        }
        
        .no-products {
            text-align: center;
            padding: 40px;
            color: #666;
            font-style: italic;
        }
    </style>
</head>

<body>
    <%- include('../partials/header') %>
    
    <div class="main-wrapper">
        <div class="catalog-container">
            <div class="catalog-header">
                <h1>🛍️ Product Catalog</h1>
                <p>Browse and manage all generated merchandise products across vendors</p>
                
                <% if (typeof catalog !== 'undefined' && catalog) { %>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-number"><%= catalog.totalProducts || 0 %></div>
                        <div class="stat-label">Total Products</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= Object.keys(catalog.byBlueprint || {}).length %></div>
                        <div class="stat-label">Product Types</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= Object.keys(catalog.byProvider || {}).length %></div>
                        <div class="stat-label">Providers</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= catalog.recentProducts ? catalog.recentProducts.length : 0 %></div>
                        <div class="stat-label">Recent Products</div>
                    </div>
                </div>
                <% } %>
            </div>
            
            <div class="filters">
                <h3>🔍 Filter & Search Products</h3>
                <div style="display: flex; flex-wrap: wrap; gap: 15px; align-items: center;">
                    <div class="filter-group">
                        <label>Blueprint:</label>
                        <select id="blueprint-filter" class="filter-select">
                            <option value="">All Types</option>
                            <% if (typeof catalog !== 'undefined' && catalog && catalog.byBlueprint) { %>
                                <% Object.keys(catalog.byBlueprint).forEach(blueprint => { 
                                    const blueprintNames = {
                                        '5': 'Unisex Heavy Cotton Tee',
                                        '6': 'Women\'s Favorite Tee',
                                        '9': 'Unisex Cotton Crew Tee',
                                        '11': 'Women\'s Jersey V-Neck Tee',
                                        '14': 'The Boyfriend Tee for Women',
                                        '17': 'Coffee Mug 11oz',
                                        '68': 'Coffee Mug 11oz',
                                        '7': 'Poster',
                                        '97': 'Satin Poster',
                                        '146': 'Unisex Heavy Blend Hoodie',
                                        '232': 'Faux Suede Square Pillowcase',
                                        '241': 'Indoor Wall Tapestry',
                                        '268': 'Slim Phone Case',
                                        '277': 'Wall Clock',
                                        '326': 'Weekender Bag',
                                        '384': 'Square Stickers',
                                        '400': 'Kiss-Cut Stickers'
                                    };
                                    const prettyName = blueprintNames[blueprint] || `Product Type ${blueprint}`;
                                %>
                                    <option value="<%= blueprint %>"><%= prettyName %> (<%= catalog.byBlueprint[blueprint].length %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label>Provider:</label>
                        <select id="provider-filter" class="filter-select">
                            <option value="">All Providers</option>
                            <% if (typeof catalog !== 'undefined' && catalog && catalog.byProvider) { %>
                                <% Object.keys(catalog.byProvider).forEach(provider => { 
                                    const providerNames = {
                                        '1': 'Print Provider',
                                        '2': 'Art Studio',
                                        '3': 'Marco Fine Arts',
                                        '4': 'Standard Print Co',
                                        '7': 'Budget Prints',
                                        '8': 'Premium Prints',
                                        '9': 'Monster Digital'
                                    };
                                    const prettyName = providerNames[provider] || `Vendor ${provider}`;
                                %>
                                    <option value="<%= provider %>"><%= prettyName %> (<%= catalog.byProvider[provider].length %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label>Search:</label>
                        <input type="text" id="search-filter" class="filter-input" placeholder="Search titles...">
                    </div>
                    
                    <div class="filter-group">
                        <label>Per Page:</label>
                        <select id="per-page-filter" class="filter-select">
                            <option value="12">12 per page</option>
                            <option value="24" selected>24 per page</option>
                            <option value="48">48 per page</option>
                            <option value="all">Show All</option>
                        </select>
                    </div>
                    
                    <button class="btn" onclick="clearAllFilters()">🔄 Clear Filters</button>
                </div>
            </div>
            
            <div class="view-controls">
                <div class="view-mode">
                    <button id="grid-view" class="active" onclick="setViewMode('grid')">🔲 Grid</button>
                    <button id="compact-view" onclick="setViewMode('compact')">📱 Compact</button>
                    <button id="list-view" onclick="setViewMode('list')">📋 List</button>
                </div>
                
                <div class="results-info">
                    <span id="results-count">Showing 0 products</span>
                </div>
            </div>
            
            <div id="products-container">
                <% if (typeof catalog !== 'undefined' && catalog && catalog.allProducts && catalog.allProducts.length > 0) { %>
                    <div class="pagination" id="top-pagination"></div>
                    <div class="products-grid" id="products-grid">
                        <% catalog.allProducts.forEach(product => { %>
                            <div class="product-card" 
                                 data-blueprint="<%= product.blueprintId || 'unknown' %>"
                                 data-provider="<%= product.providerId || 'unknown' %>"
                                 data-title="<%= (product.title || '').toLowerCase() %>"
                                 data-created="<%= product.createdAt || '' %>">
                                <div class="product-content">
                                    <div class="product-title">
                                        <%= product.title || 'Untitled Product' %>
                                    </div>
                                
                                <div class="product-meta">
                                    <strong>Product ID:</strong> <%= product.productId || 'N/A' %>
                                </div>
                                
                                <div class="product-meta">
                                    <strong>Product Type:</strong> 
                                    <% 
                                    const blueprintNames = {
                                        '5': 'Unisex Heavy Cotton Tee',
                                        '6': 'Women\'s Favorite Tee',
                                        '9': 'Unisex Cotton Crew Tee',
                                        '11': 'Women\'s Jersey V-Neck Tee',
                                        '14': 'The Boyfriend Tee for Women',
                                        '17': 'Coffee Mug 11oz',
                                        '68': 'Coffee Mug 11oz',
                                        '7': 'Poster',
                                        '97': 'Satin Poster',
                                        '146': 'Unisex Heavy Blend Hoodie',
                                        '232': 'Faux Suede Square Pillowcase',
                                        '241': 'Indoor Wall Tapestry',
                                        '268': 'Slim Phone Case',
                                        '277': 'Wall Clock',
                                        '326': 'Weekender Bag',
                                        '384': 'Square Stickers',
                                        '400': 'Kiss-Cut Stickers'
                                    };
                                    const blueprintName = blueprintNames[product.blueprintId] || `Product Type ${product.blueprintId}`;
                                    %>
                                    <%= blueprintName %>
                                </div>
                                
                                <div class="product-meta">
                                    <strong>Print Provider:</strong> 
                                    <% 
                                    const providerNames = {
                                        '1': 'Print Provider',
                                        '2': 'Art Studio',
                                        '3': 'Marco Fine Arts',
                                        '4': 'Standard Print Co',
                                        '7': 'Budget Prints',
                                        '8': 'Premium Prints',
                                        '9': 'Monster Digital'
                                    };
                                    const providerName = providerNames[product.providerId] || `Vendor ${product.providerId}`;
                                    %>
                                    <%= providerName %>
                                </div>
                                
                                <% if (product.sourceImage) { %>
                                <div class="product-meta">
                                    <strong>Source:</strong> <%= product.sourceImage %>
                                </div>
                                <% } %>
                                
                                <% if (product.createdAt) { %>
                                <div class="product-meta">
                                    <strong>Created:</strong> <%= new Date(product.createdAt).toLocaleDateString() %>
                                </div>
                                <% } %>
                                
                                <% 
                                const mockupUrl = product.mockupUrl || product.imageUrl || (product.images && product.images.length > 0 ? product.images[0].src : null);
                                if (mockupUrl) { %>
                                <div class="product-image-preview">
                                    <img src="<%= mockupUrl %>"
                                         alt="Product Preview" 
                                         class="product-image"
                                         style="max-width: 100%; height: 150px; object-fit: cover; border: 2px solid #333; border-radius: 4px; margin: 10px 0;">
                                </div>
                                <% } %>
                                
                                    <div class="product-actions">
                                        <% if (product.productId) { %>
                                            <a href="/merchandise/preview/<%= product.productId %>" 
                                               class="btn" target="_blank">
                                                👁️ View
                                            </a>
                                        <% } %>
                                        
                                        <% 
                                        const overlayImageUrl = product.mockupUrl || product.imageUrl || (product.images && product.images.length > 0 ? product.images[0].src : null);
                                        if (overlayImageUrl) { %>
                                            <button class="btn btn-border" 
                                                    data-image-url="<%= overlayImageUrl %>"
                                                    data-product-id="<%= product.productId %>"
                                                    data-vendor-id="<%= product.providerId %>"
                                                    data-product-type="<%= product.blueprintId %>"
                                                    data-title="<%= product.title || 'Untitled' %>"
                                                    data-border-type="solid"
                                                    onclick="openBorderModalFromCard(this)">
                                                🎨 Overlay
                                            </button>
                                        <% } %>
                                        
                                        <button class="btn btn-danger" 
                                                onclick="if(confirm('Delete this product?')) deleteProduct('<%= product.productId %>', this)">
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <div class="pagination" id="bottom-pagination"></div>
                <% } else { %>
                    <div class="no-products">
                        <h3>📦 No Products Found</h3>
                        <p>No vendor preview products are currently available.</p>
                        <a href="/admin/vendor-research/preview-generator" class="btn">
                            🎨 Create New Products
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <!-- Include Border Selection Modal -->
    <%- include('../components/border-selection') %>
    
    <script src="/static/js/border-selection.js"></script>
    <script>
        // Helper function to open border modal from card button
        function openBorderModalFromCard(button) {
            const imageUrl = button.dataset.imageUrl;
            if (!imageUrl) {
                console.error('No imageUrl found for border modal');
                return;
            }
            
            const imageData = {
                id: button.dataset.productId,
                vendorId: button.dataset.vendorId,
                productType: button.dataset.productType,
                title: button.dataset.title
            };
            
            openBorderModal(imageUrl, imageData);
        }
        
        // Refresh vendor catalog after border application
        function refreshVendorCatalog() {
            window.location.reload();
        }
        
        // Pagination and filtering state
        let currentPage = 1;
        let itemsPerPage = 24;
        let filteredProducts = [];
        let allProducts = [];
        
        // Initialize products array
        document.addEventListener('DOMContentLoaded', function() {
            allProducts = Array.from(document.querySelectorAll('.product-card'));
            filteredProducts = [...allProducts];
            updateDisplay();
        });
        
        // Filter functionality with pagination
        function filterProducts() {
            const blueprintFilter = document.getElementById('blueprint-filter').value;
            const providerFilter = document.getElementById('provider-filter').value;
            const searchFilter = document.getElementById('search-filter').value.toLowerCase();
            
            filteredProducts = allProducts.filter(product => {
                const blueprint = product.dataset.blueprint;
                const provider = product.dataset.provider;
                const title = product.dataset.title;
                
                const blueprintMatch = !blueprintFilter || blueprint === blueprintFilter;
                const providerMatch = !providerFilter || provider === providerFilter;
                const searchMatch = !searchFilter || title.includes(searchFilter);
                
                return blueprintMatch && providerMatch && searchMatch;
            });
            
            currentPage = 1; // Reset to first page
            updateDisplay();
        }
        
        // Update display with pagination
        function updateDisplay() {
            const perPageSelect = document.getElementById('per-page-filter');
            itemsPerPage = perPageSelect.value === 'all' ? filteredProducts.length : parseInt(perPageSelect.value);
            
            // Hide all products first
            allProducts.forEach(product => product.style.display = 'none');
            
            // Calculate pagination
            const totalPages = Math.ceil(filteredProducts.length / itemsPerPage);
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            
            // Show current page products
            const currentProducts = filteredProducts.slice(startIndex, endIndex);
            currentProducts.forEach(product => product.style.display = 'block');
            
            // Update results count
            const resultsCount = document.getElementById('results-count');
            if (resultsCount) {
                const start = filteredProducts.length > 0 ? startIndex + 1 : 0;
                const end = Math.min(endIndex, filteredProducts.length);
                resultsCount.textContent = `Showing ${start}-${end} of ${filteredProducts.length} products`;
            }
            
            // Update pagination controls
            updatePagination(totalPages);
            
            // Handle no results
            const grid = document.getElementById('products-grid');
            const noResults = document.getElementById('no-results');
            
            if (filteredProducts.length === 0) {
                if (!noResults) {
                    const message = document.createElement('div');
                    message.id = 'no-results';
                    message.className = 'no-products';
                    message.innerHTML = '<h3>🔍 No Matching Products</h3><p>Try adjusting your filters.</p>';
                    grid.parentNode.appendChild(message);
                }
            } else if (noResults) {
                noResults.remove();
            }
        }
        
        // Update pagination controls
        function updatePagination(totalPages) {
            const topPagination = document.getElementById('top-pagination');
            const bottomPagination = document.getElementById('bottom-pagination');
            
            if (totalPages <= 1) {
                topPagination.style.display = 'none';
                bottomPagination.style.display = 'none';
                return;
            }
            
            topPagination.style.display = 'flex';
            bottomPagination.style.display = 'flex';
            
            const paginationHTML = createPaginationHTML(totalPages);
            topPagination.innerHTML = paginationHTML;
            bottomPagination.innerHTML = paginationHTML;
        }
        
        // Create pagination HTML
        function createPaginationHTML(totalPages) {
            let html = '';
            
            // Previous button
            html += `<button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>← Prev</button>`;
            
            // Page numbers (show max 7 pages)
            let startPage = Math.max(1, currentPage - 3);
            let endPage = Math.min(totalPages, startPage + 6);
            
            if (endPage - startPage < 6) {
                startPage = Math.max(1, endPage - 6);
            }
            
            if (startPage > 1) {
                html += `<button onclick="changePage(1)">1</button>`;
                if (startPage > 2) html += '<span>...</span>';
            }
            
            for (let i = startPage; i <= endPage; i++) {
                html += `<button onclick="changePage(${i})" ${i === currentPage ? 'class="active"' : ''}>${i}</button>`;
            }
            
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += '<span>...</span>';
                html += `<button onclick="changePage(${totalPages})">${totalPages}</button>`;
            }
            
            // Next button
            html += `<button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>Next →</button>`;
            
            return html;
        }
        
        // Change page
        function changePage(page) {
            const totalPages = Math.ceil(filteredProducts.length / itemsPerPage);
            if (page < 1 || page > totalPages) return;
            
            currentPage = page;
            updateDisplay();
            
            // Scroll to top
            document.querySelector('.catalog-container').scrollIntoView({ behavior: 'smooth' });
        }
        
        // View mode functions
        function setViewMode(mode) {
            const grid = document.getElementById('products-grid');
            const buttons = document.querySelectorAll('.view-mode button');
            
            // Remove all view classes
            grid.className = 'products-grid';
            buttons.forEach(btn => btn.classList.remove('active'));
            
            // Add new view class and activate button
            if (mode !== 'grid') {
                grid.classList.add(mode);
            }
            document.getElementById(mode + '-view').classList.add('active');
        }
        
        // Clear all filters
        function clearAllFilters() {
            document.getElementById('blueprint-filter').value = '';
            document.getElementById('provider-filter').value = '';
            document.getElementById('search-filter').value = '';
            document.getElementById('per-page-filter').value = '24';
            filterProducts();
        }
        
        // Attach filter event listeners
        document.getElementById('blueprint-filter').addEventListener('change', filterProducts);
        document.getElementById('provider-filter').addEventListener('change', filterProducts);
        document.getElementById('search-filter').addEventListener('input', filterProducts);
        document.getElementById('per-page-filter').addEventListener('change', updateDisplay);
        
        // Delete product function
        async function deleteProduct(productId, button) {
            if (!confirm('Are you sure you want to delete this product?')) {
                return;
            }
            
            button.disabled = true;
            button.textContent = '⏳ Deleting...';
            
            try {
                const response = await fetch('/admin/vendor-research/delete-preview', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        cacheKey: productId
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Remove the product card from view
                    button.closest('.product-card').remove();
                    alert('Product deleted successfully');
                } else {
                    throw new Error(result.error || 'Delete failed');
                }
            } catch (error) {
                console.error('Delete error:', error);
                alert('Failed to delete product: ' + error.message);
                button.disabled = false;
                button.textContent = '🗑️ Delete';
            }
        }
        
        // Auto-refresh every 30 seconds
        setInterval(() => {
            const refreshBtn = document.createElement('button');
            refreshBtn.textContent = '🔄 Refresh';
            refreshBtn.className = 'btn';
            refreshBtn.onclick = () => window.location.reload();
            
            // Add refresh button to filters if not already present
            const filters = document.querySelector('.filters');
            if (filters && !filters.querySelector('.refresh-btn')) {
                refreshBtn.classList.add('refresh-btn');
                filters.appendChild(refreshBtn);
            }
        }, 30000);
    </script>
    

</body>
</html>