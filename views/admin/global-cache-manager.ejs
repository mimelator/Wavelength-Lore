<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Wavelength Lore</title>
    <link rel="stylesheet" href="/css/admin-styles.css">
    <style>
        .cache-manager-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .admin-header {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .admin-header h1 {
            margin: 0;
            font-size: 2.5em;
            font-weight: 300;
        }
        
        .admin-header p {
            margin: 10px 0 0 0;
            opacity: 0.9;
            font-size: 1.1em;
        }
        
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .metric-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border: 1px solid #e5e7eb;
        }
        
        .metric-header {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .metric-icon {
            font-size: 2em;
            margin-right: 15px;
        }
        
        .metric-title {
            font-size: 1.2em;
            font-weight: 600;
            color: #1f2937;
            margin: 0;
        }
        
        .metric-value {
            font-size: 2.5em;
            font-weight: 700;
            color: #6366f1;
            margin: 10px 0;
        }
        
        .metric-description {
            color: #6b7280;
            font-size: 0.9em;
            line-height: 1.4;
        }
        
        .metric-trend {
            display: flex;
            align-items: center;
            margin-top: 10px;
            font-size: 0.85em;
        }
        
        .trend-positive {
            color: #10b981;
        }
        
        .trend-negative {
            color: #ef4444;
        }
        
        .trend-neutral {
            color: #6b7280;
        }
        
        .cache-status {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }
        
        .status-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .status-title {
            font-size: 1.4em;
            font-weight: 600;
            color: #1f2937;
        }
        
        .status-indicator {
            display: flex;
            align-items: center;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 500;
            font-size: 0.9em;
        }
        
        .status-healthy {
            background: #dcfce7;
            color: #166534;
        }
        
        .status-warning {
            background: #fef3c7;
            color: #92400e;
        }
        
        .status-error {
            background: #fee2e2;
            color: #991b1b;
        }
        
        .cache-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
        
        .detail-item {
            padding: 15px;
            background: #f9fafb;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
        }
        
        .detail-label {
            font-size: 0.85em;
            color: #6b7280;
            margin-bottom: 5px;
        }
        
        .detail-value {
            font-size: 1.1em;
            font-weight: 600;
            color: #1f2937;
        }
        
        .recommendations {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }
        
        .recommendation-item {
            display: flex;
            align-items: flex-start;
            padding: 15px;
            margin: 10px 0;
            border-radius: 8px;
            border-left: 4px solid;
        }
        
        .recommendation-high {
            background: #fef2f2;
            border-left-color: #ef4444;
        }
        
        .recommendation-medium {
            background: #fffbeb;
            border-left-color: #f59e0b;
        }
        
        .recommendation-info {
            background: #f0f9ff;
            border-left-color: #3b82f6;
        }
        
        .recommendation-success {
            background: #f0fdf4;
            border-left-color: #10b981;
        }
        
        .recommendation-icon {
            font-size: 1.5em;
            margin-right: 15px;
            margin-top: 2px;
        }
        
        .recommendation-content {
            flex: 1;
        }
        
        .recommendation-title {
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .recommendation-description {
            color: #6b7280;
            font-size: 0.9em;
            line-height: 1.4;
        }
        
        .recommendation-actions {
            margin-top: 10px;
        }
        
        .action-button {
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            font-size: 0.85em;
            font-weight: 500;
            cursor: pointer;
            margin-right: 8px;
            transition: all 0.2s ease;
        }
        
        .action-primary {
            background: #6366f1;
            color: white;
        }
        
        .action-primary:hover {
            background: #5b21b6;
        }
        
        .action-secondary {
            background: #f3f4f6;
            color: #374151;
            border: 1px solid #d1d5db;
        }
        
        .action-secondary:hover {
            background: #e5e7eb;
        }
        
        .cache-operations {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }
        
        .operation-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .operation-card {
            padding: 20px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .operation-card:hover {
            border-color: #6366f1;
            transform: translateY(-2px);
        }
        
        .operation-icon {
            font-size: 3em;
            margin-bottom: 15px;
        }
        
        .operation-title {
            font-size: 1.2em;
            font-weight: 600;
            margin-bottom: 10px;
            color: #1f2937;
        }
        
        .operation-description {
            color: #6b7280;
            font-size: 0.9em;
            margin-bottom: 20px;
            line-height: 1.4;
        }
        
        .operation-button {
            background: #6366f1;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s ease;
        }
        
        .operation-button:hover {
            background: #5b21b6;
        }
        
        .operation-button:disabled {
            background: #9ca3af;
            cursor: not-allowed;
        }
        
        .progress-section {
            background: #fef3c7;
            border: 1px solid #f59e0b;
            color: #92400e;
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            display: none;
        }
        
        .progress-bar {
            width: 100%;
            height: 8px;
            background: #e5e7eb;
            border-radius: 4px;
            overflow: hidden;
            margin: 10px 0;
        }
        
        .progress-fill {
            height: 100%;
            background: #6366f1;
            transition: width 0.3s ease;
            width: 0%;
        }
        
        .cache-logs {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .log-entry {
            display: flex;
            align-items: flex-start;
            padding: 12px 0;
            border-bottom: 1px solid #f3f4f6;
        }
        
        .log-timestamp {
            font-size: 0.8em;
            color: #6b7280;
            margin-right: 15px;
            min-width: 80px;
        }
        
        .log-level {
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.75em;
            font-weight: 600;
            margin-right: 10px;
            min-width: 50px;
            text-align: center;
        }
        
        .log-info {
            background: #dbeafe;
            color: #1e40af;
        }
        
        .log-success {
            background: #dcfce7;
            color: #166534;
        }
        
        .log-warning {
            background: #fef3c7;
            color: #92400e;
        }
        
        .log-error {
            background: #fee2e2;
            color: #991b1b;
        }
        
        .log-message {
            flex: 1;
            font-size: 0.9em;
            line-height: 1.4;
        }
        
        .notification {
            background: #dbeafe;
            border: 1px solid #3b82f6;
            color: #1e40af;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }
        
        .notification.success {
            background: #dcfce7;
            border-color: #10b981;
            color: #065f46;
        }
        
        .notification.error {
            background: #fee2e2;
            border-color: #ef4444;
            color: #991b1b;
        }
        
        .notification.warning {
            background: #fef3c7;
            border-color: #f59e0b;
            color: #92400e;
        }
    </style>
</head>
<body>
    <div class="cache-manager-container">
        <!-- Admin Header -->
        <div class="admin-header">
            <h1>🗄️ Global Image Cache Manager</h1>
            <p>Monitor and optimize the global image enhancement cache system for maximum efficiency</p>
        </div>

        <!-- Notification Area -->
        <div id="notification" class="notification"></div>

        <!-- Performance Metrics -->
        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-header">
                    <div class="metric-icon">🎯</div>
                    <h3 class="metric-title">Cache Hit Rate</h3>
                </div>
                <div class="metric-value"><%= (metrics.summary.hitRate * 100).toFixed(1) %>%</div>
                <div class="metric-description">
                    Percentage of enhancement requests served from cache
                </div>
                <div class="metric-trend <%= metrics.summary.hitRate > 0.5 ? 'trend-positive' : 'trend-negative' %>">
                    <%= metrics.summary.hitRate > 0.5 ? '↗' : '↘' %> 
                    <%= metrics.summary.hitRate > 0.5 ? 'Excellent' : 'Needs improvement' %>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-header">
                    <div class="metric-icon">⚡</div>
                    <h3 class="metric-title">Processing Saved</h3>
                </div>
                <div class="metric-value"><%= metrics.summary.enhancementsReused || 0 %></div>
                <div class="metric-description">
                    Enhancement processes avoided through cache reuse
                </div>
                <div class="metric-trend trend-positive">
                    ↗ <%= metrics.summary.estimatedProcessingSaved?.estimatedTimeSavedMinutes || 0 %> minutes saved
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-header">
                    <div class="metric-icon">💾</div>
                    <h3 class="metric-title">Total Enhancements</h3>
                </div>
                <div class="metric-value"><%= metrics.summary.enhancementsCreated || 0 %></div>
                <div class="metric-description">
                    Unique enhanced images in global cache
                </div>
                <div class="metric-trend trend-neutral">
                    → Storage optimization active
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-header">
                    <div class="metric-icon">💰</div>
                    <h3 class="metric-title">Cost Savings</h3>
                </div>
                <div class="metric-value">$<%= metrics.summary.estimatedProcessingSaved?.estimatedCostSavedUSD || 0 %></div>
                <div class="metric-description">
                    Estimated processing cost savings from cache hits
                </div>
                <div class="metric-trend trend-positive">
                    ↗ <%= metrics.summary.estimatedProcessingSaved?.percentageOptimization || 0 %>% optimization
                </div>
            </div>
        </div>

        <!-- Cache Status -->
        <div class="cache-status">
            <div class="status-header">
                <h3 class="status-title">Cache System Status</h3>
                <div class="status-indicator <%= cacheStatus.overall === 'healthy' ? 'status-healthy' : cacheStatus.overall === 'warning' ? 'status-warning' : 'status-error' %>">
                    <span><%= cacheStatus.overall === 'healthy' ? '✅' : cacheStatus.overall === 'warning' ? '⚠️' : '❌' %></span>
                    <span><%= cacheStatus.overall.charAt(0).toUpperCase() + cacheStatus.overall.slice(1) %></span>
                </div>
            </div>
            
            <div class="cache-details">
                <div class="detail-item">
                    <div class="detail-label">Global Cache</div>
                    <div class="detail-value"><%= cacheStatus.globalCache ? 'Active' : 'Inactive' %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Total Requests</div>
                    <div class="detail-value"><%= metrics.summary.totalCacheHits + metrics.summary.totalCacheMisses %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Cache Hits</div>
                    <div class="detail-value"><%= metrics.summary.totalCacheHits || 0 %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Cache Misses</div>
                    <div class="detail-value"><%= metrics.summary.totalCacheMisses || 0 %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Last Updated</div>
                    <div class="detail-value"><%= new Date().toLocaleTimeString() %></div>
                </div>
            </div>
        </div>

        <!-- Recommendations -->
        <% if (recommendations && recommendations.length > 0) { %>
        <div class="recommendations">
            <h3 style="margin-bottom: 20px; color: #1f2937;">💡 Optimization Recommendations</h3>
            
            <% recommendations.forEach(rec => { %>
            <div class="recommendation-item recommendation-<%= rec.priority === 'high' ? 'high' : rec.priority === 'medium' ? 'medium' : rec.type === 'success' ? 'success' : 'info' %>">
                <div class="recommendation-icon">
                    <%= rec.priority === 'high' ? '🔴' : rec.priority === 'medium' ? '🟡' : rec.type === 'success' ? '🟢' : '🔵' %>
                </div>
                <div class="recommendation-content">
                    <div class="recommendation-title">
                        <%= rec.priority === 'high' ? 'High Priority' : rec.priority === 'medium' ? 'Medium Priority' : 'Information' %>
                        <% if (rec.estimatedSavings) { %>
                        (Est. <%= rec.estimatedSavings %> duplicates)
                        <% } %>
                    </div>
                    <div class="recommendation-description"><%= rec.message %></div>
                    <% if (rec.action && rec.action !== 'continue_monitoring') { %>
                    <div class="recommendation-actions">
                        <button class="action-button action-primary" onclick="executeRecommendation('<%= rec.action %>')">
                            <%= rec.action === 'run_migration' ? 'Run Migration' : rec.action === 'schedule_migration' ? 'Schedule Migration' : 'Take Action' %>
                        </button>
                        <button class="action-button action-secondary" onclick="dismissRecommendation('<%= rec.type %>')">
                            Dismiss
                        </button>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }); %>
        </div>
        <% } %>

        <!-- Cache Operations -->
        <div class="cache-operations">
            <h3 style="margin-bottom: 20px; color: #1f2937;">🔧 Cache Management Operations</h3>
            
            <div class="operation-grid">
                <div class="operation-card">
                    <div class="operation-icon">🔄</div>
                    <h4 class="operation-title">Refresh Cache Metrics</h4>
                    <p class="operation-description">
                        Update cache performance statistics and regenerate recommendations
                    </p>
                    <button class="operation-button" onclick="refreshMetrics()">
                        Refresh Now
                    </button>
                </div>

                <div class="operation-card">
                    <div class="operation-icon">🚀</div>
                    <h4 class="operation-title">Run Migration</h4>
                    <p class="operation-description">
                        Migrate legacy user-specific enhancements to global cache
                    </p>
                    <button class="operation-button" onclick="runMigration()">
                        Start Migration
                    </button>
                </div>

                <div class="operation-card">
                    <div class="operation-icon">📊</div>
                    <h4 class="operation-title">Generate Report</h4>
                    <p class="operation-description">
                        Create detailed cache performance and optimization report
                    </p>
                    <button class="operation-button" onclick="generateReport()">
                        Generate Report
                    </button>
                </div>

                <div class="operation-card">
                    <div class="operation-icon">🧹</div>
                    <h4 class="operation-title">Cache Cleanup</h4>
                    <p class="operation-description">
                        Remove old or unused cache entries to optimize storage
                    </p>
                    <button class="operation-button" onclick="runCleanup()" style="background: #ef4444;">
                        Run Cleanup
                    </button>
                </div>
            </div>
        </div>

        <!-- Progress Section -->
        <div id="progressSection" class="progress-section">
            <h4 id="progressTitle">Operation in Progress...</h4>
            <div class="progress-bar">
                <div id="progressFill" class="progress-fill"></div>
            </div>
            <p id="progressText">Starting operation...</p>
        </div>

        <!-- Recent Cache Activity -->
        <div class="cache-logs">
            <h3 style="margin-bottom: 20px; color: #1f2937;">📋 Recent Cache Activity</h3>
            
            <div id="cacheLogEntries">
                <div class="log-entry">
                    <div class="log-timestamp">12:34</div>
                    <div class="log-level log-success">HIT</div>
                    <div class="log-message">Enhanced image served from global cache (content hash: abc123...)</div>
                </div>
                
                <div class="log-entry">
                    <div class="log-timestamp">12:33</div>
                    <div class="log-level log-info">STORE</div>
                    <div class="log-message">New enhancement stored in global cache (scale factor: 4x)</div>
                </div>
                
                <div class="log-entry">
                    <div class="log-timestamp">12:32</div>
                    <div class="log-level log-warning">MISS</div>
                    <div class="log-message">Cache miss - generating new enhancement for unique content</div>
                </div>
                
                <div class="log-entry">
                    <div class="log-timestamp">12:30</div>
                    <div class="log-level log-success">HIT</div>
                    <div class="log-message">Enhanced image served from global cache (processing time saved: 45s)</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Auto-refresh metrics every 30 seconds
        setInterval(refreshMetrics, 30000);

        async function refreshMetrics() {
            try {
                showNotification('Refreshing cache metrics...', 'info');
                
                const response = await fetch('/admin/vendor-research/cache-metrics', {
                    method: 'GET'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showNotification('Cache metrics updated successfully', 'success');
                    // Update the page with new metrics
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    showNotification('Failed to refresh metrics: ' + result.error, 'error');
                }
                
            } catch (error) {
                showNotification('Error refreshing metrics: ' + error.message, 'error');
            }
        }

        async function runMigration() {
            if (!confirm('Run cache migration? This will process legacy enhancements and may take some time.')) {
                return;
            }
            
            try {
                showProgress('Migration in Progress', 'Starting cache migration...');
                
                const response = await fetch('/admin/vendor-research/cache-migration', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        batchSize: 50
                    })
                });
                
                const result = await response.json();
                hideProgress();
                
                if (result.success) {
                    showNotification(`Migration completed. Processed ${result.processed} items.`, 'success');
                    setTimeout(refreshMetrics, 2000);
                } else {
                    showNotification('Migration failed: ' + result.error, 'error');
                }
                
            } catch (error) {
                hideProgress();
                showNotification('Migration error: ' + error.message, 'error');
            }
        }

        async function generateReport() {
            try {
                showNotification('Generating cache performance report...', 'info');
                
                const response = await fetch('/admin/vendor-research/cache-report', {
                    method: 'GET'
                });
                
                const blob = await response.blob();
                
                if (blob.size > 0) {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `cache-performance-report-${new Date().toISOString().split('T')[0]}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                    
                    showNotification('Report downloaded successfully', 'success');
                } else {
                    showNotification('Failed to generate report', 'error');
                }
                
            } catch (error) {
                showNotification('Report generation error: ' + error.message, 'error');
            }
        }

        async function runCleanup() {
            if (!confirm('Run cache cleanup? This will remove old and unused cache entries. This action cannot be undone.')) {
                return;
            }
            
            try {
                showProgress('Cache Cleanup', 'Analyzing cache entries...');
                
                const response = await fetch('/admin/vendor-research/cache-cleanup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        maxAgeMonths: 6,
                        confirmAction: 'CLEANUP_CONFIRMED'
                    })
                });
                
                const result = await response.json();
                hideProgress();
                
                if (result.success) {
                    showNotification(`Cleanup completed. ${result.removed || 0} entries removed.`, 'success');
                    setTimeout(refreshMetrics, 2000);
                } else {
                    showNotification('Cleanup failed: ' + result.error, 'error');
                }
                
            } catch (error) {
                hideProgress();
                showNotification('Cleanup error: ' + error.message, 'error');
            }
        }

        function executeRecommendation(action) {
            if (action === 'run_migration' || action === 'schedule_migration') {
                runMigration();
            } else {
                showNotification('Action executed: ' + action, 'info');
            }
        }

        function dismissRecommendation(type) {
            showNotification('Recommendation dismissed', 'info');
            // In a real implementation, this would make an API call to dismiss the recommendation
        }

        function showProgress(title, message) {
            const progressSection = document.getElementById('progressSection');
            const progressTitle = document.getElementById('progressTitle');
            const progressText = document.getElementById('progressText');
            const progressFill = document.getElementById('progressFill');
            
            progressTitle.textContent = title;
            progressText.textContent = message;
            progressFill.style.width = '0%';
            progressSection.style.display = 'block';
            
            // Animate progress
            let progress = 0;
            const interval = setInterval(() => {
                progress += 2;
                progressFill.style.width = Math.min(progress, 90) + '%';
                
                if (progress >= 90) {
                    clearInterval(interval);
                }
            }, 100);
        }

        function hideProgress() {
            const progressSection = document.getElementById('progressSection');
            const progressFill = document.getElementById('progressFill');
            
            progressFill.style.width = '100%';
            
            setTimeout(() => {
                progressSection.style.display = 'none';
            }, 500);
        }

        function showNotification(message, type = 'info') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type}`;
            notification.style.display = 'block';
            
            setTimeout(() => {
                notification.style.display = 'none';
            }, 5000);
        }

        // Initialize real-time updates
        function startRealTimeUpdates() {
            // In a production environment, this would use WebSockets or Server-Sent Events
            // for real-time cache activity updates
            console.log('Real-time cache monitoring active');
        }

        // Start monitoring when page loads
        document.addEventListener('DOMContentLoaded', function() {
            startRealTimeUpdates();
        });
    </script>
</body>
