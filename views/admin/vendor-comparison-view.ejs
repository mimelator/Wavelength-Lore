<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Wavelength Lore</title>
    <link rel="stylesheet" href="/css/admin-styles.css">
</head>
<body>
    
    <div class="admin-container">
        <div class="admin-header">
            <h1><%= title %></h1>
            <p>Detailed vendor comparison results</p>
        </div>

        <div class="comparison-overview">
            <div class="comparison-meta">
                <h2>Comparison Details</h2>
                <div class="meta-grid">
                    <div class="meta-item">
                        <strong>Image ID:</strong> <%= comparison.imageId %>
                    </div>
                    <div class="meta-item">
                        <strong>Product Type:</strong> <%= comparison.productType %>
                    </div>
                    <div class="meta-item">
                        <strong>Vendors Tested:</strong> <%= comparison.vendorIds.length %>
                    </div>
                    <div class="meta-item">
                        <strong>Generated:</strong> <%= new Date(comparison.report.generatedAt).toLocaleString() %>
                    </div>
                </div>
            </div>
        </div>

        <div class="vendor-results">
            <h2>Vendor Comparison Results</h2>
            
            <% if (comparison.previews && comparison.previews.length > 0) { %>
                <div class="vendor-grid">
                    <% comparison.previews.forEach(preview => { %>
                        <div class="vendor-card">
                            <div class="vendor-header">
                                <h3><%= preview.vendorName %></h3>
                                <span class="vendor-id">ID: <%= preview.vendorId %></span>
                                <span class="status-badge status-<%= preview.status %>"><%= preview.status %></span>
                            </div>
                            
                            <div class="vendor-details">
                                <% if (preview.vendorLocation) { %>
                                    <p><strong>Location:</strong> <%= preview.vendorLocation %></p>
                                <% } %>
                                
                                <p><strong>Pricing:</strong> <%= preview.pricing?.range || 'N/A' %></p>
                                <p><strong>Mockups:</strong> <%= (preview.mockupImages || []).length %> images</p>
                                <p><strong>Variants:</strong> <%= (preview.variants || []).length %> options</p>
                                
                                <% if (preview.error) { %>
                                    <div class="error-message">
                                        <strong>Error:</strong> <%= preview.error %>
                                    </div>
                                <% } %>
                            </div>
                            
                            <% if (preview.mockupImages && preview.mockupImages.length > 0) { %>
                                <div class="mockup-gallery">
                                    <h4>Mockup Images</h4>
                                    <div class="mockup-grid">
                                        <% preview.mockupImages.slice(0, 4).forEach(image => { %>
                                            <img src="<%= typeof image === 'string' ? image : image.src || image.url %>" alt="Mockup" class="mockup-thumb">
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="no-results">
                    <p>No vendor previews available for this comparison.</p>
                </div>
            <% } %>
        </div>

        <% if (comparison.report && comparison.report.recommendations && comparison.report.recommendations.length > 0) { %>
            <div class="recommendations">
                <h2>Recommendations</h2>
                <div class="recommendation-grid">
                    <% comparison.report.recommendations.forEach(rec => { %>
                        <div class="recommendation-card">
                            <h3><%= rec.title %></h3>
                            <p><strong>Vendor:</strong> <%= rec.vendor %></p>
                            <p><%= rec.reason %></p>
                            <span class="rec-type"><%= rec.type %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <div class="actions">
            <a href="/admin/vendor-research" class="btn btn-secondary">Back to Vendor Research</a>
            <button onclick="deleteComparison('<%= comparison.id %>')" class="btn btn-danger">Delete Comparison</button>
        </div>
    </div>

    <style>
        .comparison-overview {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
        }
        
        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        
        .vendor-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .vendor-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            background: white;
        }
        
        .vendor-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }
        
        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
        
        .status-success { background: #d4edda; color: #155724; }
        .status-failed { background: #f8d7da; color: #721c24; }
        .status-partial { background: #fff3cd; color: #856404; }
        
        .mockup-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 10px;
        }
        
        .mockup-thumb {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 4px;
        }
        
        .recommendation-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        
        .recommendation-card {
            border: 1px solid #007bff;
            border-radius: 8px;
            padding: 15px;
            background: #f8f9ff;
        }
        
        .rec-type {
            background: #007bff;
            color: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 11px;
        }
        
        .error-message {
            background: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-top: 10px;
        }
        
        .actions {
            margin-top: 30px;
            display: flex;
            gap: 15px;
        }
    </style>

    <script>
        async function deleteComparison(comparisonId) {
            if (!confirm('Are you sure you want to delete this comparison?')) {
                return;
            }
            
            try {
                const response = await fetch(`/admin/vendor-research/comparison/${comparisonId}`, {
                    method: 'DELETE'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('Comparison deleted successfully');
                    window.location.href = '/admin/vendor-research';
                } else {
                    alert('Failed to delete comparison: ' + result.error);
                }
            } catch (error) {
                alert('Error deleting comparison: ' + error.message);
            }
        }
    </script>
</body>
</html>