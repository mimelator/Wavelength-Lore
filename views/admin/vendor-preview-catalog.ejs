<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Wavelength Lore</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-panel.css">
    <style>
        .catalog-container {
            max-width: 1800px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .admin-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .admin-header h1 {
            margin: 0 0 10px 0;
            font-size: 2.5em;
            font-weight: 300;
        }
        
        .admin-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 1.1em;
        }
        
        .catalog-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            text-align: center;
            border: 1px solid #e1e8ed;
        }
        
        .stat-number {
            font-size: 2.5em;
            font-weight: 700;
            color: #667eea;
            margin-bottom: 5px;
        }
        
        .stat-label {
            color: #718096;
            font-size: 0.9em;
        }
        
        .section-tabs {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            border-bottom: 2px solid #e2e8f0;
        }
        
        .tab-button {
            padding: 15px 25px;
            background: none;
            border: none;
            color: #718096;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
        }
        
        .tab-button.active {
            color: #667eea;
            border-bottom-color: #667eea;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        /* Preview Grid Styles */
        .preview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
        }
        
        .preview-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            border: 1px solid #e1e8ed;
            transition: all 0.3s ease;
        }
        
        .preview-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
        }
        
        .preview-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        
        .preview-title {
            font-size: 1.2em;
            font-weight: 600;
            color: #1a202c;
            margin: 0;
            word-break: break-word;
        }
        
        .preview-id {
            font-size: 0.8em;
            color: #718096;
            background: #f7fafc;
            padding: 4px 8px;
            border-radius: 6px;
            font-family: monospace;
        }
        
        .preview-meta {
            margin: 15px 0;
        }
        
        .meta-row {
            display: flex;
            justify-content: space-between;
            margin: 8px 0;
            font-size: 0.9em;
        }
        
        .meta-label {
            color: #718096;
        }
        
        .meta-value {
            font-weight: 600;
            color: #2d3748;
        }
        
        .preview-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }
        
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            text-decoration: none;
            font-size: 0.9em;
            font-weight: 500;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        
        .btn-primary {
            background: #667eea;
            color: white;
        }
        
        .btn-primary:hover {
            background: #5a6fd8;
        }
        
        .btn-secondary {
            background: #e2e8f0;
            color: #4a5568;
        }
        
        .btn-secondary:hover {
            background: #cbd5e0;
        }
        
        .btn-danger {
            background: #e53e3e;
            color: white;
        }
        
        .btn-danger:hover {
            background: #c53030;
        }
        
        /* Generator Styles */
        .generator-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            border: 1px solid #e1e8ed;
        }
        
        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .section-icon {
            font-size: 2em;
            margin-right: 15px;
        }
        
        .section-title {
            font-size: 1.4em;
            margin: 0;
            color: #1a202c;
        }
        
        .image-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }
        
        .image-item {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }
        
        .image-item:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        
        .image-item.selected {
            border-color: #10b981;
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        }
        
        .image-preview {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 8px;
        }
        
        .image-title {
            font-size: 0.8em;
            color: #4a5568;
            margin: 0;
            word-break: break-word;
        }
        
        .selected-badge {
            position: absolute;
            top: 5px;
            right: 5px;
            background: #10b981;
            color: white;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.7em;
            font-weight: 500;
        }
        
        .product-types {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }
        
        .product-type-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .product-type-card:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        
        .product-type-card.selected {
            border-color: #10b981;
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        }
        
        .product-icon {
            font-size: 2.5em;
            margin-bottom: 8px;
        }
        
        .product-name {
            font-size: 1em;
            font-weight: 600;
            margin: 0;
            color: #1a202c;
        }
        
        .generate-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            padding: 15px 30px;
            border: none;
            border-radius: 8px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 20px 0;
            width: 100%;
        }
        
        .generate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.25);
        }
        
        .generate-btn:disabled {
            background: #9ca3af;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #718096;
        }
        
        .empty-icon {
            font-size: 4em;
            margin-bottom: 20px;
            opacity: 0.5;
        }
        
        .notification {
            background: #fef3c7;
            border: 1px solid #f59e0b;
            color: #92400e;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }
        
        .notification.success {
            background: #d1fae5;
            border-color: #10b981;
            color: #065f46;
        }
        
        .notification.error {
            background: #fee2e2;
            border-color: #dc2626;
            color: #991b1b;
        }
    </style>
</head>
<body>
    <div class="catalog-container">
        <!-- Admin Header -->
        <div class="admin-header">
            <h1>🎨 Vendor Preview Catalog</h1>
            <p>Complete catalog of all vendor preview products with generation capabilities for custom artwork</p>
        </div>

        <!-- Statistics Cards -->
        <div class="catalog-stats">
            <div class="stat-card">
                <div class="stat-number"><%= allPreviews.length %></div>
                <div class="stat-label">Total Preview Products</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= userImages.length %></div>
                <div class="stat-label">Available Gallery Images</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">4</div>
                <div class="stat-label">Product Types</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">3</div>
                <div class="stat-label">Active Vendors</div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="section-tabs">
            <button class="tab-button active" onclick="switchTab('catalog')">📋 All Previews</button>
            <button class="tab-button" onclick="switchTab('generator')">🎨 Generate New</button>
        </div>

        <!-- Notification Area -->
        <div id="notification" class="notification" style="display: none;"></div>

        <!-- Catalog Tab -->
        <div id="catalog-tab" class="tab-content active">
            <% if (allPreviews.length > 0) { %>
                <div class="preview-grid">
                    <% allPreviews.forEach(preview => { %>
                        <div class="preview-card">
                            <div class="preview-header">
                                <h3 class="preview-title"><%= preview.title %></h3>
                                <span class="preview-id"><%= preview.productId.substring(0, 8) %>...</span>
                            </div>
                            
                            <div class="preview-meta">
                                <div class="meta-row">
                                    <span class="meta-label">Source Image:</span>
                                    <span class="meta-value"><%= preview.sourceImage %></span>
                                </div>
                                <% if (preview.blueprintName) { %>
                                    <div class="meta-row">
                                        <span class="meta-label">Product Type:</span>
                                        <span class="meta-value"><%= preview.blueprintName %></span>
                                    </div>
                                    <div class="meta-row">
                                        <span class="meta-label">Category:</span>
                                        <span class="meta-value"><%= preview.blueprintCategory %></span>
                                    </div>
                                <% } else { %>
                                    <div class="meta-row">
                                        <span class="meta-label">Blueprint ID:</span>
                                        <span class="meta-value"><%= preview.blueprintId || 'N/A' %></span>
                                    </div>
                                <% } %>
                                <% if (preview.providerName) { %>
                                    <div class="meta-row">
                                        <span class="meta-label">Print Provider:</span>
                                        <span class="meta-value"><%= preview.providerName %></span>
                                    </div>
                                    <div class="meta-row">
                                        <span class="meta-label">Provider Location:</span>
                                        <span class="meta-value"><%= preview.providerLocation %></span>
                                    </div>
                                    <div class="meta-row">
                                        <span class="meta-label">Provider Rating:</span>
                                        <span class="meta-value">⭐ <%= preview.providerRating %>/5.0</span>
                                    </div>
                                <% } else { %>
                                    <div class="meta-row">
                                        <span class="meta-label">Provider ID:</span>
                                        <span class="meta-value"><%= preview.providerId || 'N/A' %></span>
                                    </div>
                                <% } %>
                                <div class="meta-row">
                                    <span class="meta-label">Created:</span>
                                    <span class="meta-value"><%= preview.createdAt ? new Date(preview.createdAt).toLocaleDateString() : 'Unknown' %></span>
                                </div>
                                <div class="meta-row">
                                    <span class="meta-label">Created By:</span>
                                    <span class="meta-value"><%= preview.createdBy %></span>
                                </div>
                            </div>
                            
                            <div class="preview-actions">
                                <a href="<%= preview.viewUrl %>" class="btn btn-primary" target="_blank">
                                    👁️ View Product
                                </a>
                                <button class="btn btn-secondary" onclick="copyProductUrl('<%= preview.productId %>')">
                                    📋 Copy URL
                                </button>
                                <button class="btn btn-danger" onclick="deletePreview('<%= preview.cacheKey %>')">
                                    🗑️ Delete
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-icon">📦</div>
                    <h3>No Preview Products Yet</h3>
                    <p>Use the "Generate New" tab to create your first vendor preview products</p>
                </div>
            <% } %>
        </div>

        <!-- Generator Tab -->
        <div id="generator-tab" class="tab-content">
            <div class="generator-section">
                <div class="section-header">
                    <div class="section-icon">🖼️</div>
                    <h2 class="section-title">Select Your Artwork</h2>
                </div>
                <p>Choose an image from your gallery to create a new vendor preview:</p>
                
                <div class="image-gallery">
                    <% userImages.forEach(image => { %>
                        <div class="image-item" onclick="selectImage('<%= image.relativePath %>')" data-image-id="<%= image.relativePath %>">
                            <img src="<%= image.url %>" alt="<%= image.originalName %>" class="image-preview">
                            <p class="image-title"><%= image.originalName || image.fileName %></p>
                        </div>
                    <% }); %>
                </div>
            </div>

            <div class="generator-section">
                <div class="section-header">
                    <div class="section-icon">👕</div>
                    <h2 class="section-title">Choose Product Type</h2>
                </div>
                <p>Select the type of product you want to create:</p>
                
                <div class="product-types">
                    <div class="product-type-card" onclick="selectProductType('premium-tshirt')" data-product-type="premium-tshirt">
                        <div class="product-icon">👕</div>
                        <h3 class="product-name">Premium T-Shirt</h3>
                    </div>
                    <div class="product-type-card" onclick="selectProductType('mug')" data-product-type="mug">
                        <div class="product-icon">☕</div>
                        <h3 class="product-name">Ceramic Mug</h3>
                    </div>
                    <div class="product-type-card" onclick="selectProductType('poster')" data-product-type="poster">
                        <div class="product-icon">🖼️</div>
                        <h3 class="product-name">Premium Poster</h3>
                    </div>
                    <div class="product-type-card" onclick="selectProductType('hoodie')" data-product-type="hoodie">
                        <div class="product-icon">🧥</div>
                        <h3 class="product-name">Pullover Hoodie</h3>
                    </div>
                </div>
            </div>

            <div class="generator-section">
                <button id="generateSingleBtn" class="generate-btn" onclick="generateSinglePreview()" disabled>
                    🎨 Generate Single Preview Product
                </button>
                <p style="text-align: center; color: #718096; margin-top: 10px;">
                    <span id="selectionStatus">Select an image and product type to continue</span>
                </p>
            </div>
        </div>
    </div>

    <script>
        let selectedImage = null;
        let selectedProductType = null;

        function switchTab(tabName) {
            // Remove active class from all tabs and content
            document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            // Add active class to selected tab and content
            event.target.classList.add('active');
            document.getElementById(tabName + '-tab').classList.add('active');
        }

        function selectImage(imageId) {
            // Remove previous selection
            document.querySelectorAll('.image-item').forEach(item => {
                item.classList.remove('selected');
                const badge = item.querySelector('.selected-badge');
                if (badge) badge.remove();
            });

            // Add selection to clicked item
            const clickedItem = document.querySelector(`[data-image-id="${imageId}"]`);
            clickedItem.classList.add('selected');
            clickedItem.innerHTML += '<div class="selected-badge">✓</div>';

            selectedImage = imageId;
            updateGenerateButton();
        }

        function selectProductType(productType) {
            // Remove previous selection
            document.querySelectorAll('.product-type-card').forEach(card => {
                card.classList.remove('selected');
            });

            // Add selection to clicked card
            const clickedCard = document.querySelector(`[data-product-type="${productType}"]`);
            clickedCard.classList.add('selected');

            selectedProductType = productType;
            updateGenerateButton();
        }

        function updateGenerateButton() {
            const generateBtn = document.getElementById('generateSingleBtn');
            const statusSpan = document.getElementById('selectionStatus');
            const canGenerate = selectedImage && selectedProductType;
            
            generateBtn.disabled = !canGenerate;
            
            if (canGenerate) {
                statusSpan.textContent = `Ready to generate ${selectedProductType} with selected image`;
            } else {
                statusSpan.textContent = 'Select an image and product type to continue';
            }
        }

        async function generateSinglePreview() {
            if (!selectedImage || !selectedProductType) {
                showNotification('Please select an image and product type', 'error');
                return;
            }

            const generateBtn = document.getElementById('generateSingleBtn');
            const originalText = generateBtn.textContent;
            
            generateBtn.disabled = true;
            generateBtn.textContent = '⏳ Generating...';

            try {
                const response = await fetch('/admin/vendor-research/generate-single-preview', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        imageId: selectedImage,
                        productType: selectedProductType
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    showNotification(`Successfully generated preview product: ${result.productId}`, 'success');
                    // Refresh the catalog tab to show the new product
                    setTimeout(() => location.reload(), 2000);
                } else {
                    showNotification(`Failed to generate preview: ${result.error}`, 'error');
                }

            } catch (error) {
                showNotification(`Error: ${error.message}`, 'error');
            } finally {
                generateBtn.disabled = false;
                generateBtn.textContent = originalText;
            }
        }

        function copyProductUrl(productId) {
            const url = `${window.location.origin}/merchandise/product/${productId}`;
            navigator.clipboard.writeText(url).then(() => {
                showNotification('Product URL copied to clipboard', 'success');
            }).catch(() => {
                showNotification('Failed to copy URL', 'error');
            });
        }

        async function deletePreview(cacheKey) {
            if (!confirm('Are you sure you want to delete this preview product?')) return;

            try {
                const response = await fetch('/admin/vendor-research/delete-preview', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ cacheKey })
                });

                const result = await response.json();
                
                if (result.success) {
                    showNotification('Preview product deleted successfully', 'success');
                    location.reload();
                } else {
                    showNotification(`Failed to delete: ${result.error}`, 'error');
                }

            } catch (error) {
                showNotification(`Error: ${error.message}`, 'error');
            }
        }

        function showNotification(message, type = 'info') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type}`;
            notification.style.display = 'block';
            
            setTimeout(() => {
                notification.style.display = 'none';
            }, 5000);
        }

        // Initialize the page
        document.addEventListener('DOMContentLoaded', function() {
            updateGenerateButton();
        });
    </script>
</body>
</html>