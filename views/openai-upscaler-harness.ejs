<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OpenAI Upscaler Harness</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .card h2 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.3em;
            border-bottom: 3px solid #667eea;
            padding-bottom: 10px;
        }

        .control-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #333;
            font-weight: 500;
        }

        input[type="file"],
        input[type="text"],
        input[type="number"],
        select {
            width: 100%;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 6px;
            font-size: 0.95em;
            transition: border-color 0.3s;
        }

        input[type="file"]:focus,
        input[type="text"]:focus,
        input[type="number"]:focus,
        select:focus {
            outline: none;
            border-color: #667eea;
        }

        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        button {
            flex: 1;
            padding: 12px 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
        }

        button:active {
            transform: translateY(0);
        }

        .secondary-btn {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 15px;
        }

        .stat-box {
            background: #f5f5f5;
            padding: 10px;
            border-radius: 6px;
            text-align: center;
        }

        .stat-label {
            font-size: 0.85em;
            color: #666;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 1.3em;
            font-weight: bold;
            color: #667eea;
        }

        .log-container {
            background: #1e1e1e;
            color: #0f0;
            padding: 15px;
            border-radius: 6px;
            height: 400px;
            overflow-y: auto;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            margin-top: 15px;
        }

        .log-entry {
            margin-bottom: 5px;
            padding: 3px 0;
            border-left: 3px solid transparent;
            padding-left: 8px;
        }

        .log-info {
            color: #0f0;
            border-left-color: #0f0;
        }

        .log-warn {
            color: #ff0;
            border-left-color: #ff0;
        }

        .log-error {
            color: #f00;
            border-left-color: #f00;
        }

        .log-success {
            color: #0f0;
            border-left-color: #0f0;
        }

        .timestamp {
            color: #666;
            font-size: 0.8em;
            margin-right: 8px;
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: #ddd;
            border-radius: 3px;
            margin-top: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            width: 0%;
            transition: width 0.3s ease;
        }

        .image-preview {
            width: 100%;
            max-height: 300px;
            border-radius: 6px;
            margin-top: 15px;
            object-fit: contain;
            background: #f5f5f5;
            border: 2px dashed #667eea;
        }

        .test-modes {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 15px;
        }

        .mode-btn {
            padding: 10px;
            border: 2px solid #667eea;
            background: white;
            color: #667eea;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .mode-btn:hover {
            background: #667eea;
            color: white;
        }

        .mode-btn.active {
            background: #667eea;
            color: white;
        }

        .full-width {
            grid-column: 1 / -1;
        }

        @media (max-width: 768px) {
            .main-grid {
                grid-template-columns: 1fr;
            }

            .test-modes {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 1.8em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🤖 OpenAI Upscaler Harness</h1>
            <p>Test, debug, and optimize OpenAI image upscaling integration</p>
        </div>

        <div class="main-grid">
            <!-- Control Panel -->
            <div class="card">
                <h2>Test Controls</h2>

                <div class="control-group">
                    <label>Test Mode:</label>
                    <div class="test-modes">
                        <button class="mode-btn active" onclick="setMode('single')">Single Image</button>
                        <button class="mode-btn" onclick="setMode('batch')">Batch Test</button>
                        <button class="mode-btn" onclick="setMode('gallery')">Gallery Random</button>
                    </div>
                </div>

                <div class="control-group" id="singleImageGroup">
                    <label>Select Gallery Image:</label>
                    <select id="gallerySelect" style="width: 100%; padding: 10px; border: 2px solid #ddd; border-radius: 6px;">
                        <option value="">Loading gallery images...</option>
                    </select>
                    <small style="color: #666; margin-top: 5px; display: block;">Images from your registered Wavelength gallery</small>
                </div>

                <div class="control-group">
                    <label>Product Template:</label>
                    <select id="templateSelect" style="width: 100%; padding: 10px; border: 2px solid #ddd; border-radius: 6px;" onchange="updateTemplateInfo()">
                        <option value="">Loading templates...</option>
                    </select>
                    <small style="color: #666; margin-top: 5px; display: block;">Choose a template with predefined optimization settings</small>
                </div>

                <div class="control-group" id="templateInfoGroup" style="display: none; background: #f5f5f5; padding: 12px; border-radius: 6px; margin-top: 10px;">
                    <div style="margin-bottom: 8px;">
                        <strong style="color: #333;">Template Configuration:</strong>
                    </div>
                    <div id="templateInfo" style="font-size: 0.9em; color: #555; line-height: 1.6;">
                    </div>
                </div>

                <div class="control-group" id="batchCountGroup" style="display: none;">
                    <label>Number of Tests:</label>
                    <input type="number" id="batchCount" value="3" min="1" max="10">
                </div>

                <div class="button-group">
                    <button onclick="runTest()">▶ Run Test</button>
                    <button class="secondary-btn" onclick="clearLogs()">🗑️ Clear Logs</button>
                </div>

                <div class="stats">
                    <div class="stat-box">
                        <div class="stat-label">Tests Run</div>
                        <div class="stat-value" id="testCount">0</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-label">Success Rate</div>
                        <div class="stat-value" id="successRate">0%</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-label">Avg Time</div>
                        <div class="stat-value" id="avgTime">0ms</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-label">Status</div>
                        <div class="stat-value" id="status">Ready</div>
                    </div>
                </div>

                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
            </div>

            <!-- Image Preview -->
            <div class="card">
                <h2>Image Preview</h2>
                <div id="previewContainer" style="text-align: center;">
                    <p style="color: #999;">No image selected</p>
                </div>
            </div>
        </div>

        <!-- Effect Customization Panel -->
        <div class="card full-width" id="effectsPanel" style="display: none;">
            <h2>✨ Customize with Effects</h2>

            <!-- Effect Presets -->
            <div class="control-group">
                <label>Effect Presets:</label>
                <div class="preset-buttons" id="presetButtons" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 15px;"></div>
            </div>

            <!-- Custom Effect Sliders -->
            <div class="control-group" id="customEffectsContainer">
                <label>Custom Effect Parameters:</label>
                <div id="effectSliders" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px;"></div>
            </div>

            <!-- Before/After Toggle -->
            <div class="control-group">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: normal;">
                    <input type="checkbox" id="beforeAfterToggle" style="width: auto; cursor: pointer;">
                    <span>Show Before/After Comparison</span>
                </label>
            </div>

            <!-- Action Buttons -->
            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button onclick="applyEffects()" style="flex: 1;">🎨 Apply Effects</button>
                <button onclick="closeEffectsPanel()" style="flex: 1; background: #ccc; color: #333;">Cancel</button>
            </div>

            <!-- Effect Preview -->
            <div id="effectsPreview" style="margin-top: 20px; text-align: center; display: none;">
                <h3 style="color: #667eea; margin-bottom: 10px;">Customized Preview</h3>
                <img id="effectsPreviewImage" src="" alt="Effects Preview" style="max-height: 400px; max-width: 100%; border-radius: 6px; border: 2px solid #667eea;">
            </div>
        </div>

        <!-- Logs -->
        <div class="card full-width">
            <h2>Live Logs</h2>
            <div class="log-container" id="logContainer"></div>
        </div>
    </div>

    <script>
        let currentMode = 'single';
        let testStats = {
            total: 0,
            success: 0,
            failed: 0,
            totalTime: 0,
            times: []
        };

        function setMode(mode) {
            currentMode = mode;

            // Update button states
            document.querySelectorAll('.mode-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            // Show/hide relevant controls
            document.getElementById('singleImageGroup').style.display = mode === 'single' ? 'block' : 'none';
            document.getElementById('batchCountGroup').style.display = mode === 'batch' ? 'block' : 'none';

            addLog(`Switched to ${mode} mode`, 'info');
        }

        function addLog(message, type = 'info') {
            const timestamp = new Date().toLocaleTimeString();
            const logContainer = document.getElementById('logContainer');
            const entry = document.createElement('div');
            entry.className = `log-entry log-${type}`;
            entry.innerHTML = `<span class="timestamp">[${timestamp}]</span>${message}`;
            logContainer.appendChild(entry);
            logContainer.scrollTop = logContainer.scrollHeight;
        }

        function clearLogs() {
            document.getElementById('logContainer').innerHTML = '';
            addLog('Logs cleared', 'info');
        }

        function updateProgress(percent) {
            document.getElementById('progressFill').style.width = percent + '%';
        }

        function updateStats() {
            document.getElementById('testCount').textContent = testStats.total;
            const successRate = testStats.total > 0 ? Math.round((testStats.success / testStats.total) * 100) : 0;
            document.getElementById('successRate').textContent = successRate + '%';
            const avgTime = testStats.times.length > 0
                ? Math.round(testStats.times.reduce((a, b) => a + b, 0) / testStats.times.length)
                : 0;
            document.getElementById('avgTime').textContent = avgTime + 'ms';
        }

        function displayUpscaledImage(imageUrl, imageName) {
            const previewContainer = document.getElementById('previewContainer');
            const img = document.createElement('img');
            img.src = imageUrl;
            img.alt = `Upscaled: ${imageName}`;
            img.className = 'image-preview';
            img.style.maxHeight = '400px';
            img.style.maxWidth = '100%';

            // Create a download link
            const downloadLink = document.createElement('a');
            downloadLink.href = imageUrl;
            downloadLink.download = `upscaled-${imageName}.jpg`;
            downloadLink.style.marginTop = '10px';
            downloadLink.style.display = 'inline-block';
            downloadLink.style.padding = '8px 15px';
            downloadLink.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
            downloadLink.style.color = 'white';
            downloadLink.style.borderRadius = '6px';
            downloadLink.style.textDecoration = 'none';
            downloadLink.style.fontWeight = '600';
            downloadLink.textContent = '📥 Download Upscaled Image';

            // Create a new view link
            const viewLink = document.createElement('a');
            viewLink.href = imageUrl;
            viewLink.target = '_blank';
            viewLink.style.marginTop = '10px';
            viewLink.style.marginLeft = '10px';
            viewLink.style.display = 'inline-block';
            viewLink.style.padding = '8px 15px';
            viewLink.style.background = '#f5f5f5';
            viewLink.style.color = '#667eea';
            viewLink.style.border = '2px solid #667eea';
            viewLink.style.borderRadius = '6px';
            viewLink.style.textDecoration = 'none';
            viewLink.style.fontWeight = '600';
            viewLink.textContent = '🔗 Open in New Tab';

            previewContainer.innerHTML = '';
            previewContainer.appendChild(img);
            previewContainer.appendChild(document.createElement('br'));
            previewContainer.appendChild(downloadLink);
            previewContainer.appendChild(viewLink);

            addLog(`Image ready at: ${imageUrl}`, 'info');

            // Show effects panel when image is displayed
            setTimeout(() => showEffectsPanel(), 500);
        }

        // ============================================================
        // EFFECTS SYSTEM FUNCTIONS
        // ============================================================

        let availableEffects = {};
        let currentEffectParams = {};
        let lastUpscaledImageUrl = null;

        async function loadEffects() {
            try {
                const response = await fetch('/api/merchandise/openai-upscaler/effects-list');
                const data = await response.json();

                if (data.success) {
                    availableEffects = data;
                    console.log('✨ Loaded effects:', data);
                    renderEffectsUI();
                }
            } catch (error) {
                console.error('Error loading effects:', error);
                addLog(`❌ Could not load effects: ${error.message}`, 'error');
            }
        }

        function renderEffectsUI() {
            // Render preset buttons
            const presetsContainer = document.getElementById('presetButtons');
            presetsContainer.innerHTML = '';

            availableEffects.presets.forEach(preset => {
                const btn = document.createElement('button');
                btn.textContent = `${preset.icon} ${preset.name}`;
                btn.className = 'preset-btn';
                btn.style.padding = '10px';
                btn.style.background = 'white';
                btn.style.border = '2px solid #667eea';
                btn.style.borderRadius = '6px';
                btn.style.cursor = 'pointer';
                btn.style.fontWeight = '600';
                btn.style.color = '#667eea';
                btn.style.transition = 'all 0.3s';

                btn.onclick = () => selectPreset(preset.id, btn);
                presetsContainer.appendChild(btn);
            });

            // Render effect sliders
            const slidersContainer = document.getElementById('effectSliders');
            slidersContainer.innerHTML = '';

            // Custom category has all effects
            const customCategory = availableEffects.categories.find(c => c.id === 'custom');
            if (customCategory) {
                customCategory.effects.forEach(effectKey => {
                    const effect = availableEffects.effectTypes[effectKey];
                    if (effect && effect.type === 'slider') {
                        const sliderGroup = createEffectSlider(effectKey, effect);
                        slidersContainer.appendChild(sliderGroup);
                    }
                });
            }
        }

        function createEffectSlider(effectKey, effectConfig) {
            const container = document.createElement('div');
            container.style.display = 'flex';
            container.style.flexDirection = 'column';
            container.style.gap = '5px';

            const label = document.createElement('label');
            label.textContent = `${effectConfig.name}`;
            label.style.fontSize = '0.9em';
            label.style.fontWeight = '600';
            label.style.color = '#333';

            const input = document.createElement('input');
            input.type = 'range';
            input.min = effectConfig.min;
            input.max = effectConfig.max;
            input.step = effectConfig.step || 0.1;
            input.value = effectConfig.default;
            input.id = `effect-${effectKey}`;
            input.style.cursor = 'pointer';
            input.style.width = '100%';

            const valueDisplay = document.createElement('span');
            valueDisplay.textContent = `${effectConfig.default.toFixed(2)} ${effectConfig.unit || ''}`;
            valueDisplay.style.fontSize = '0.85em';
            valueDisplay.style.color = '#666';
            valueDisplay.style.textAlign = 'center';

            input.oninput = () => {
                currentEffectParams[effectKey] = parseFloat(input.value);
                valueDisplay.textContent = `${parseFloat(input.value).toFixed(2)} ${effectConfig.unit || ''}`;
            };

            // Initialize current param
            currentEffectParams[effectKey] = effectConfig.default;

            container.appendChild(label);
            container.appendChild(input);
            container.appendChild(valueDisplay);

            return container;
        }

        function selectPreset(presetId, buttonElement) {
            // Update active button
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.style.background = 'white';
                btn.style.color = '#667eea';
            });
            buttonElement.style.background = '#667eea';
            buttonElement.style.color = 'white';

            // Load preset effects
            const preset = availableEffects.presets.find(p => p.id === presetId);
            if (preset) {
                currentEffectParams = { ...preset.effects };
                updateSliders();
                addLog(`✨ Loaded preset: ${preset.name}`, 'info');
            }
        }

        function updateSliders() {
            Object.entries(currentEffectParams).forEach(([key, value]) => {
                const slider = document.getElementById(`effect-${key}`);
                if (slider) {
                    slider.value = value;
                    // Trigger display update
                    slider.dispatchEvent(new Event('input'));
                }
            });
        }

        function showEffectsPanel() {
            const panel = document.getElementById('effectsPanel');
            if (panel) {
                panel.style.display = 'block';
                addLog('💡 Effects customization panel is ready!', 'info');
            }
        }

        function closeEffectsPanel() {
            const panel = document.getElementById('effectsPanel');
            if (panel) {
                panel.style.display = 'none';
            }
        }

        async function applyEffects() {
            if (!lastUpscaledImageUrl) {
                addLog('❌ No upscaled image available. Run a test first!', 'error');
                return;
            }

            addLog('🎨 Applying effects to image...', 'info');
            updateProgress(30);

            try {
                // Find selected preset
                let presetId = 'custom';
                const presetButtons = document.querySelectorAll('.preset-btn');
                presetButtons.forEach(btn => {
                    if (btn.style.background === 'rgb(102, 126, 234)') {
                        // Extract preset ID from button (approximate)
                        presetId = 'custom'; // Default to custom
                    }
                });

                const response = await fetch('/api/merchandise/openai-upscaler/apply-effects', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        upscaledImageUrl: lastUpscaledImageUrl,
                        effectsPreset: presetId,
                        effectParams: currentEffectParams
                    })
                });

                updateProgress(70);

                const data = await response.json();

                if (response.ok && data.success) {
                    addLog(`✅ Effects applied successfully in ${data.analysis.processingTime}ms`, 'success');
                    addLog(`   Processed size: ${(data.analysis.processedSize / 1024).toFixed(2)} KB`, 'info');

                    if (data.metadata.customizedImageUrl) {
                        // Display customized image
                        displayCustomizedImage(data.metadata.customizedImageUrl, 'Customized Image');
                        addLog(`🖼️ Customized image ready for viewing`, 'success');
                    }
                } else {
                    addLog(`❌ Effects failed: ${data.error}`, 'error');
                    if (data.details) {
                        addLog(`   Details: ${data.details}`, 'error');
                    }
                }

                updateProgress(100);

            } catch (error) {
                addLog(`❌ Error applying effects: ${error.message}`, 'error');
                updateProgress(100);
            }
        }

        function displayCustomizedImage(imageUrl, imageName) {
            const previewDiv = document.getElementById('effectsPreview');
            const previewImg = document.getElementById('effectsPreviewImage');

            previewImg.src = imageUrl;
            previewDiv.style.display = 'block';

            // Also add to main preview
            const mainPreviewContainer = document.getElementById('previewContainer');
            const existingDownloadBtn = mainPreviewContainer.querySelector('a');
            if (existingDownloadBtn) {
                // Replace existing preview with customized version
                const img = mainPreviewContainer.querySelector('img');
                if (img) {
                    img.src = imageUrl;
                }
            }

            addLog(`Image customized: ${imageUrl}`, 'info');
        }

        async function runTest() {
            addLog('Starting OpenAI upscaler test...', 'info');
            updateProgress(0);
            document.getElementById('status').textContent = 'Running...';

            if (currentMode === 'single') {
                await runSingleTest();
            } else if (currentMode === 'batch') {
                await runBatchTest();
            } else if (currentMode === 'gallery') {
                await runGalleryTest();
            }

            document.getElementById('status').textContent = 'Complete';
            updateProgress(100);
        }

        async function runSingleTest() {
            const selectedImageId = document.getElementById('gallerySelect').value;
            const selectedTemplateId = document.getElementById('templateSelect').value;

            if (!selectedImageId) {
                addLog('❌ Please select a gallery image first', 'error');
                return;
            }

            if (!selectedTemplateId) {
                addLog('❌ Please select a product template first', 'error');
                return;
            }

            const template = availableTemplates[selectedTemplateId];
            const targetDimensions = template.imageOptimization.targetDimensions;

            try {
                updateProgress(20);
                addLog(`📁 Selected image ID: ${selectedImageId}`, 'info');
                addLog(`📦 Using template: ${template.name}`, 'info');
                addLog(`📏 Target: ${targetDimensions.width}×${targetDimensions.height}px @ ${template.imageOptimization.targetDpi}DPI`, 'info');

                const startTime = Date.now();

                const response = await fetch('/api/merchandise/openai-upscaler/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        imageId: selectedImageId,
                        templateId: selectedTemplateId,
                        targetWidth: targetDimensions.width,
                        targetHeight: targetDimensions.height
                    })
                });

                updateProgress(50);

                const data = await response.json();
                const duration = Date.now() - startTime;

                testStats.total++;
                testStats.times.push(duration);

                if (response.ok) {
                    testStats.success++;
                    addLog(`✅ OpenAI upscaling successful (${duration}ms)`, 'success');
                    addLog(`   Strategy: ${data.analysis.action}`, 'success');
                    addLog(`   Scale Factor: ${data.analysis.scaleFactor}`, 'success');
                    addLog(`   Image URL: ${data.metadata.imageUrl}`, 'info');

                    // Display upscaled image
                    if (data.metadata.upscaledImageUrl) {
                        lastUpscaledImageUrl = data.metadata.upscaledImageUrl;
                        displayUpscaledImage(data.metadata.upscaledImageUrl, data.metadata.imageName);
                        addLog(`🖼️ Upscaled image ready for viewing`, 'success');
                    }
                } else {
                    testStats.failed++;
                    addLog(`❌ Upscaling failed: ${data.error}`, 'error');
                    if (data.details) {
                        addLog(`   Details: ${data.details}`, 'error');
                    }
                }

                updateProgress(80);
                updateStats();
                updateProgress(100);

            } catch (error) {
                testStats.failed++;
                testStats.total++;
                addLog(`❌ Request error: ${error.message}`, 'error');
                updateStats();
            }
        }

        async function runBatchTest() {
            const count = parseInt(document.getElementById('batchCount').value);
            const selectedTemplateId = document.getElementById('templateSelect').value;

            if (!selectedTemplateId) {
                addLog('❌ Please select a product template first', 'error');
                return;
            }

            const template = availableTemplates[selectedTemplateId];
            const targetDimensions = template.imageOptimization.targetDimensions;

            addLog(`Starting batch test with ${count} random gallery images...`, 'info');
            addLog(`📦 Using template: ${template.name}`, 'info');

            for (let i = 0; i < count; i++) {
                try {
                    addLog(`[Batch ${i + 1}/${count}] Running test with random gallery image...`, 'info');

                    const response = await fetch('/api/merchandise/openai-upscaler/test-batch', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            templateId: selectedTemplateId,
                            targetWidth: targetDimensions.width,
                            targetHeight: targetDimensions.height
                        })
                    });

                    const data = await response.json();

                    testStats.total++;
                    if (response.ok) {
                        testStats.success++;
                        testStats.times.push(data.analysis.processingTime);
                        addLog(`  ✅ Test ${i + 1} passed - ${data.analysis.processingTime}ms`, 'success');

                        // Display the last upscaled image
                        if (data.metadata.upscaledImageUrl) {
                            displayUpscaledImage(data.metadata.upscaledImageUrl, data.metadata.imageName);
                        }
                    } else {
                        testStats.failed++;
                        addLog(`  ❌ Test ${i + 1} failed: ${data.error}`, 'error');
                    }

                    updateProgress((i + 1) / count * 100);
                } catch (error) {
                    testStats.failed++;
                    testStats.total++;
                    addLog(`  ❌ Test ${i + 1} error: ${error.message}`, 'error');
                }
            }

            updateStats();
            updateProgress(100);
        }

        async function runGalleryTest() {
            try {
                addLog('Fetching random gallery image...', 'info');
                updateProgress(15);

                // Call API to get a random gallery image
                const galleryResponse = await fetch('/api/merchandise/gallery-random-image', {
                    method: 'GET',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (!galleryResponse.ok) {
                    throw new Error(`Gallery API error: ${galleryResponse.status}`);
                }

                const galleryData = await galleryResponse.json();

                if (!galleryData.success || !galleryData.imageUrl) {
                    throw new Error(galleryData.error || 'No image returned');
                }

                addLog(`✅ Retrieved image: ${galleryData.imageName}`, 'success');
                addLog(`   Size: ${galleryData.size} KB`, 'info');
                updateProgress(30);

                // Download the image
                addLog('Downloading image...', 'info');
                const imageResponse = await fetch(galleryData.imageUrl);
                const imageBlob = await imageResponse.blob();

                addLog(`✅ Downloaded: ${(imageBlob.size / 1024).toFixed(2)} KB`, 'success');
                updateProgress(50);

                // Convert blob to base64
                addLog('Converting image to base64...', 'info');
                const reader = new FileReader();
                const base64Promise = new Promise((resolve, reject) => {
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsDataURL(imageBlob);
                });
                const imageDataUrl = await base64Promise;

                addLog('Testing OpenAI upscaler...', 'info');
                updateProgress(60);

                const startTime = Date.now();
                const testResponse = await fetch('/api/merchandise/openai-upscaler/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        image: imageDataUrl,
                        targetWidth: document.getElementById('targetWidth').value,
                        targetHeight: document.getElementById('targetHeight').value
                    })
                });

                const testData = await testResponse.json();
                const duration = Date.now() - startTime;

                testStats.total++;
                testStats.times.push(duration);

                if (testResponse.ok) {
                    testStats.success++;
                    addLog(`✅ OpenAI upscaling successful (${duration}ms)`, 'success');
                    addLog(`   Strategy: ${testData.analysis.action}`, 'success');
                    addLog(`   Scale Factor: ${testData.analysis.scaleFactor.toFixed(2)}`, 'success');
                } else {
                    testStats.failed++;
                    addLog(`❌ Upscaling failed: ${testData.error}`, 'error');
                    if (testData.details) {
                        addLog(`   Details: ${testData.details}`, 'error');
                    }
                }

                updateProgress(90);
                updateStats();
                updateProgress(100);

            } catch (error) {
                testStats.failed++;
                testStats.total++;
                addLog(`❌ Gallery test error: ${error.message}`, 'error');
                updateStats();
            }
        }

        // Store templates globally for easy access
        let availableTemplates = {};

        // Load available templates
        async function loadTemplates() {
            try {
                addLog('Loading product templates...', 'info');
                const response = await fetch('/api/merchandise/templates-list');
                const data = await response.json();

                if (!data.success || !data.templates || data.templates.length === 0) {
                    addLog('⚠️ No templates found', 'warn');
                    return;
                }

                const select = document.getElementById('templateSelect');
                select.innerHTML = ''; // Clear loading message

                data.templates.forEach(template => {
                    availableTemplates[template.id] = template;
                    const option = document.createElement('option');
                    option.value = template.id;
                    option.text = template.name;
                    select.appendChild(option);
                });

                // Select first template by default
                if (select.options.length > 0) {
                    select.selectedIndex = 0;
                    updateTemplateInfo();
                    addLog(`✅ Loaded ${data.templates.length} product templates`, 'success');
                }
            } catch (error) {
                addLog(`❌ Failed to load templates: ${error.message}`, 'error');
            }
        }

        // Update template info display
        function updateTemplateInfo() {
            const templateId = document.getElementById('templateSelect').value;
            if (!templateId || !availableTemplates[templateId]) {
                document.getElementById('templateInfoGroup').style.display = 'none';
                return;
            }

            const template = availableTemplates[templateId];
            const info = template.imageOptimization;

            let infoHtml = `
                <div>📦 <strong>${template.name}</strong></div>
                <div>🎨 Category: ${template.category}</div>
                <div>📏 Dimensions: ${info.targetDimensions.width} × ${info.targetDimensions.height} px</div>
                <div>📐 DPI: ${info.targetDpi}</div>
                <div>🤖 Upscaling: ${info.allowUpscaling ? 'Enabled' : 'Disabled'}</div>
                ${template.userMessages ? `<div style="margin-top: 8px; font-style: italic;">💬 "${template.userMessages.complete}"</div>` : ''}
            `;

            document.getElementById('templateInfo').innerHTML = infoHtml;
            document.getElementById('templateInfoGroup').style.display = 'block';
        }

        // Load gallery images on page load
        async function loadGalleryImages() {
            try {
                addLog('Loading gallery images from server...', 'info');
                const response = await fetch('/api/merchandise/gallery-list');
                const data = await response.json();

                if (!data.success || !data.images || data.images.length === 0) {
                    addLog('⚠️ No gallery images found', 'warn');
                    return;
                }

                const select = document.getElementById('gallerySelect');
                select.innerHTML = ''; // Clear loading message

                data.images.forEach(img => {
                    const option = document.createElement('option');
                    option.value = img.id;
                    option.text = img.name || img.title || 'Unnamed Image';
                    select.appendChild(option);
                });

                // Select first image by default
                if (select.options.length > 0) {
                    select.selectedIndex = 0;
                    addLog(`✅ Loaded ${data.images.length} gallery images`, 'success');
                }
            } catch (error) {
                addLog(`❌ Failed to load gallery images: ${error.message}`, 'error');
            }
        }

        // Load templates and gallery on startup
        loadTemplates();
        loadGalleryImages();
        loadEffects();

        // Initial log
        addLog('OpenAI Upscaler Harness Ready', 'success');
        addLog('Select a template and gallery image to begin', 'info');
    </script>
</body>
</html>
