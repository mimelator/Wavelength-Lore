<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
    <%- include('partials/banner') %>

    <div class="hero-section">
        <h1>Where Music is Magic: Survive the Battle for the Shire</h1>
        <p class="hero-subtitle">Enter the immersive fantasy universe of Wavelength Lore</p>
    </div>

    <style>
        .hero-section {
            text-align: center;
            padding: 2rem 0;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            margin-bottom: 2rem;
            border-radius: 8px;
        }
        
        .hero-section h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }
        
        .hero-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            font-style: italic;
        }
        
        @media (max-width: 768px) {
            .hero-section h1 {
                font-size: 2rem;
            }
            .hero-subtitle {
                font-size: 1rem;
            }
        }
        .youtube-link {
            font-size: 0.5em; /* Reduce text size by 2x */
            display: block;
            text-align: center; /* Center align with the description */
            margin-top: 5px; /* Add some spacing from the description */
            text-decoration: none; /* Remove underline from YouTube links */
        }
        .season-description {
            font-size: 0.33em; /* Shrink text size by 3x */
            color: #666; /* Subtle color for better readability */
        }
        
        /* Visibility indicator styles */
        .episode-visibility-indicator {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.9);
            color: #f1c40f;
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }
        
        .carousel .slick-slide {
            position: relative;
        }
        
        .carousel .slick-slide > div {
            position: relative;
        }
        
        .carousel .hidden-episode {
            opacity: 0.7;
        }
        
        .carousel .hidden-episode img {
            border: 2px dashed #f1c40f;
        }
        
        .carousel .hidden-episode:hover {
            opacity: 1;
        }

        /* Season divider with NPC character */
        .season-divider {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 1.5rem 0;
            padding: 1rem 0;
        }

        .season-divider .npc-image {
            max-height: 120px;
            width: auto;
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
            transition: transform 0.3s ease;
        }

        .season-divider .npc-image:hover {
            transform: scale(1.1) translateY(-5px);
        }

        @media (max-width: 768px) {
            .season-divider {
                margin: 1rem 0;
            }

            .season-divider .npc-image {
                max-height: 80px;
            }
        }
    </style>
    
    <section class="summary">
        <h2>WAVELENGTH LORE  An animated fantasy universe where music is the key to magic—and survival.</h2>
    </section>

    <section class="next-episode-cta" style="background: linear-gradient(135deg, rgba(138, 43, 226, 0.1), rgba(75, 0, 130, 0.1)); border: 2px solid rgba(138, 43, 226, 0.3); border-radius: 15px; padding: 25px; margin: 30px 0; text-align: center; position: relative; overflow: hidden;">
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 50% 50%, rgba(255, 215, 0, 0.05), transparent 70%); pointer-events: none;"></div>
    
    <div style="position: relative; z-index: 1;">
        <h3 style="color: #ffd700; font-size: 1.8rem; margin-bottom: 15px; text-shadow: 0 0 20px rgba(255, 215, 0, 0.3);">Next
            <a href="/about" class="cta-button">Learn More About Wavelength</a>
                <a href="/radio" class="cta-button">Listen to the Wavelength Radio Player</a>
        </h3>
    </div>
    </section>


    <% for (var season in videos) { %>
        <div class="season-title">
            <h2><%= videos[season].title %></h2>
            <p class="season-description"><%= videos[season].description %></p>
            <a href="<%= videos[season].seasonLink %>" target="_blank" class="center-link">Watch Complete <%= videos[season].title %> on YouTube</a>
        </div>
        <br /><br />
        <div class="carousel" id="carousel-<%= season %>">
            <%
            // Sort episodes numerically by episode number
            const episodeKeys = Object.keys(videos[season].episodes).sort((a, b) => {
                const numA = parseInt(a.replace('episode', ''));
                const numB = parseInt(b.replace('episode', ''));
                return numA - numB;
            });
            episodeKeys.forEach(episode => {
                const episodeData = videos[season].episodes[episode];
                // Skip hidden/unpublished episodes for non-content creators
                // Check multiple visibility fields: visible, published, hidden
                const isHidden = episodeData.visible === false || 
                                episodeData.published === false || 
                                episodeData.hidden === true;
                
                if (isHidden && !isContentCreator) {
                    return;
                }
            %>
                <div class="<%= episodeData.visible === false ? 'hidden-episode' : '' %>">
                    <% if (isContentCreator && episodeData.visible === false) { %>
                        <div class="episode-visibility-indicator" title="This episode is hidden from public view">
                            🔒 <span>HIDDEN</span>
                        </div>
                    <% } %>
                    <h3 class="episode-title">
                        <a href="/season/<%= season.replace('season', '') %>/episode/<%= episode.replace('episode', '') %>" title="Read the full lore and story of <%= episodeData.title %>">
                            <%= episodeData.title %>
                        </a>
                    </h3>
                    <a href="/season/<%= season.replace('season', '') %>/episode/<%= episode.replace('episode', '') %>" title="Explore <%= episodeData.title %> in Wavelength Lore">
                        <img src="<%= cdnUrl %><%= episodeData.image %>" alt="<%= episodeData.title %> - from Wavelength Lore animated series" loading="lazy">
                    </a>
                    <p><%= episodeData.description %></p>
                    <a href="<%= episodeData.youtubeLink %>" target="_blank" class="youtube-link" title="Watch <%= episodeData.title %> episode on YouTube">Watch <%= episodeData.title %> on YouTube</a>
                </div>
            <% }); %>
        </div>

        <!-- Season Divider with Rotating NPC Character -->
        <div class="season-divider" title="<%= seasonBoundaries[season] ? seasonBoundaries[season].description : 'Wavelength NPC' %>">
            <img src="<%= seasonBoundaries[season] ? seasonBoundaries[season].path : 'https://df5sj8f594cdx.cloudfront.net/images/npc-characters/sneaky-goblin.png' %>"
                 alt="<%= seasonBoundaries[season] ? seasonBoundaries[season].altText : 'Sneaky Goblin - Wavelength Lore NPC' %>"
                 class="npc-image">
        </div>
    <% } %>

    <%- include('partials/footer') %>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
    <script src="/js/wavelength-data-loader.js"></script>
    <!-- Site tour script loaded in footer.ejs - no need to load twice -->
    <script>
        // Safe data loading - no more JSON parsing errors!
        $(document).ready(async function(){
            try {
                await window.WavelengthLoader.initializeCarousels();
                console.log('✅ Wavelength site initialized successfully');
            } catch (error) {
                console.error('❌ Failed to initialize Wavelength:', error);
                // Fallback: Show loading message or retry
                $('.loading-indicator').text('Failed to load content. Please refresh the page.');
            }
        });
        
        // Legacy code removed - now using safe API loading approach
    </script>
</body>
</html>