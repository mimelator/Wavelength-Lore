<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>

    <div class="hero-section">
        <h1>Where Music is Magic: Survive the Battle for the Shire</h1>
        <p class="hero-subtitle">Enter the immersive fantasy universe of Wavelength Lore</p>
    </div>

    <style>
        .hero-section {
            text-align: center;
            padding: 2rem 0;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            margin-bottom: 2rem;
            border-radius: 8px;
        }
        
        .hero-section h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }
        
        .hero-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            font-style: italic;
        }
        
        @media (max-width: 768px) {
            .hero-section h1 {
                font-size: 2rem;
            }
            .hero-subtitle {
                font-size: 1rem;
            }
        }
        .youtube-link {
            font-size: 0.5em; /* Reduce text size by 2x */
            display: block;
            text-align: center; /* Center align with the description */
            margin-top: 5px; /* Add some spacing from the description */
            text-decoration: none; /* Remove underline from YouTube links */
        }
        .season-description {
            font-size: 0.33em; /* Shrink text size by 3x */
            color: #666; /* Subtle color for better readability */
        }
        
        /* Visibility indicator styles */
        .episode-visibility-indicator {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.9);
            color: #f1c40f;
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }
        
        .carousel .slick-slide {
            position: relative;
        }
        
        .carousel .slick-slide > div {
            position: relative;
        }
        
        .carousel .hidden-episode {
            opacity: 0.7;
        }
        
        .carousel .hidden-episode img {
            border: 2px dashed #f1c40f;
        }
        
        .carousel .hidden-episode:hover {
            opacity: 1;
        }
    </style>
    
    <section class="summary">
        <h2>About This Original Animated Fantasy Web Series</h2>
        <p><strong>Wavelength Lore</strong> is an original animated fantasy web series that reimagines the relationship between music and magic. This lore-rich storytelling universe presents an immersive animated experience where music is not just entertainment—it's the key to survival. Through a series of animated episodes, Wavelength Lore invites viewers to embark on a transformative journey through a richly detailed fantasy world filled with
            compelling characters, intricate narratives, stunning visuals, and an evocative original soundtrack.</p>

            <p>
                Each season explores unique themes and story arcs within the larger fantasy narrative, allowing for a comprehensive exploration of the Wavelength universe. Central to the mythology is the <strong>Battle for the Shire</strong> and the legendary <strong>Goblin King</strong>—key story elements that drive the conflict and mystery throughout the series.
                The Wavelength Lore universe continues to expand and evolve, creating an increasingly complex and captivating storytelling experience for fans of original fantasy animation.

            </p>
    </section>


    <% for (var season in videos) { %>
        <div class="season-title">
            <h2><%= videos[season].title %></h2>
            <p class="season-description"><%= videos[season].description %></p>
            <a href="<%= videos[season].seasonLink %>" target="_blank" class="center-link">Watch Complete <%= videos[season].title %> on YouTube</a>
        </div>
        <br /><br />
        <div class="carousel" id="carousel-<%= season %>">
            <% 
            // Sort episodes numerically by episode number
            const episodeKeys = Object.keys(videos[season].episodes).sort((a, b) => {
                const numA = parseInt(a.replace('episode', ''));
                const numB = parseInt(b.replace('episode', ''));
                return numA - numB;
            });
            episodeKeys.forEach(episode => {
                const episodeData = videos[season].episodes[episode];
                // Skip hidden episodes for non-content creators
                if (episodeData.visible === false && !isContentCreator) {
                    return;
                }
            %>
                <div class="<%= episodeData.visible === false ? 'hidden-episode' : '' %>">
                    <% if (isContentCreator && episodeData.visible === false) { %>
                        <div class="episode-visibility-indicator" title="This episode is hidden from public view">
                            🔒 <span>HIDDEN</span>
                        </div>
                    <% } %>
                    <h3 class="episode-title">
                        <a href="/season/<%= season.replace('season', '') %>/episode/<%= episode.replace('episode', '') %>" title="Read the full lore and story of <%= episodeData.title %>">
                            <%= episodeData.title %>
                        </a>
                    </h3>
                    <a href="/season/<%= season.replace('season', '') %>/episode/<%= episode.replace('episode', '') %>" title="Explore <%= episodeData.title %> in Wavelength Lore">
                        <img src="<%= cdnUrl %><%= episodeData.image %>" alt="<%= episodeData.title %> - from Wavelength Lore animated series" loading="lazy">
                    </a>
                    <p><%= episodeData.description %></p>
                    <a href="<%= episodeData.youtubeLink %>" target="_blank" class="youtube-link" title="Watch <%= episodeData.title %> episode on YouTube">Watch <%= episodeData.title %> on YouTube</a>
                </div>
            <% }); %>
        </div>
        <br /><br />
        <br /><hr /><br />
    <% } %>

    <%- include('partials/footer') %>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
    <script src="/js/wavelength-data-loader.js"></script>
    <script>
        // Safe data loading - no more JSON parsing errors!
        $(document).ready(async function(){
            try {
                await window.WavelengthLoader.initializeCarousels();
                console.log('✅ Wavelength site initialized successfully');
            } catch (error) {
                console.error('❌ Failed to initialize Wavelength:', error);
                // Fallback: Show loading message or retry
                $('.loading-indicator').text('Failed to load content. Please refresh the page.');
            }
        });
        
        // Legacy code removed - now using safe API loading approach
    </script>
</body>
</html>