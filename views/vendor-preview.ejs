<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Vendor Preview</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .preview-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        
        .preview-header {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            text-align: center;
        }
        
        .preview-badge {
            display: inline-block;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9em;
            font-weight: 600;
            margin-bottom: 15px;
        }
        
        .preview-title {
            font-size: 2.5em;
            margin: 0 0 10px 0;
            color: #1a202c;
            font-weight: 300;
        }
        
        .preview-subtitle {
            color: #718096;
            font-size: 1.1em;
            margin: 0;
        }
        
        .product-showcase {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        .product-images {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .main-image {
            width: 100%;
            border-radius: 12px;
            margin-bottom: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .image-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
            gap: 10px;
        }
        
        .thumbnail {
            width: 100%;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        
        .thumbnail:hover,
        .thumbnail.active {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        
        .product-details {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .detail-section {
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e2e8f0;
        }
        
        .detail-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }
        
        .detail-title {
            font-size: 1.2em;
            font-weight: 600;
            color: #1a202c;
            margin-bottom: 10px;
        }
        
        .detail-content {
            color: #4a5568;
            line-height: 1.6;
        }
        
        .variant-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        
        .variant-item {
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .variant-item:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        
        .variant-color {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin: 0 auto 8px;
            border: 2px solid #e2e8f0;
        }
        
        .variant-name {
            font-size: 0.9em;
            font-weight: 600;
            color: #1a202c;
            margin-bottom: 5px;
        }
        
        .variant-price {
            font-size: 0.8em;
            color: #10b981;
            font-weight: 600;
        }
        
        .meta-info {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }
        
        .meta-item {
            text-align: center;
        }
        
        .meta-label {
            font-size: 0.9em;
            color: #718096;
            margin-bottom: 5px;
        }
        
        .meta-value {
            font-size: 1.1em;
            font-weight: 600;
            color: #1a202c;
        }
        
        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
        }
        
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.25);
        }
        
        .btn-secondary {
            background: #e2e8f0;
            color: #4a5568;
        }
        
        .btn-secondary:hover {
            background: #cbd5e0;
        }
        
        @media (max-width: 768px) {
            .product-showcase {
                grid-template-columns: 1fr;
            }
            
            .preview-title {
                font-size: 2em;
            }
            
            .action-buttons {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="preview-container">
        <!-- Preview Header -->
        <div class="preview-header">
            <div class="preview-badge">🎨 Vendor Preview</div>
            <h1 class="preview-title"><%= product.title %></h1>
            <p class="preview-subtitle">Professional print-on-demand product preview</p>
        </div>

        <!-- Product Showcase -->
        <div class="product-showcase">
            <!-- Product Images -->
            <div class="product-images">
                <% if (product.images && product.images.length > 0) { %>
                    <img src="<%= product.images[0].src %>" alt="<%= product.title %>" class="main-image" id="mainImage">
                    
                    <% if (product.images.length > 1) { %>
                        <div class="image-gallery">
                            <% product.images.forEach((image, index) => { %>
                                <img src="<%= image.src %>" 
                                     alt="<%= product.title %> - View <%= index + 1 %>" 
                                     class="thumbnail <%= index === 0 ? 'active' : '' %>"
                                     onclick="changeMainImage('<%= image.src %>', this)">
                            <% }); %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div style="background: #f7fafc; padding: 60px; text-align: center; border-radius: 12px;">
                        <p style="color: #718096; font-size: 1.1em;">📷 Product images loading...</p>
                    </div>
                <% } %>
            </div>

            <!-- Product Details -->
            <div class="product-details">
                <div class="detail-section">
                    <h2 class="detail-title">📋 Product Information</h2>
                    <div class="detail-content">
                        <p><strong>Product ID:</strong> <%= productId %></p>
                        <% if (typeof friendlyNames !== 'undefined' && friendlyNames.blueprint) { %>
                            <p><strong>Product Type:</strong> <%= friendlyNames.blueprint.display %></p>
                            <p><strong>Category:</strong> <%= friendlyNames.blueprint.category %></p>
                        <% } else { %>
                            <p><strong>Blueprint:</strong> <%= product.blueprint_id || 'Standard' %></p>
                        <% } %>
                        <% if (typeof friendlyNames !== 'undefined' && friendlyNames.provider) { %>
                            <p><strong>Print Provider:</strong> <%= friendlyNames.provider.display %></p>
                            <p><strong>Provider Location:</strong> <%= friendlyNames.provider.location %></p>
                            <p><strong>Provider Rating:</strong> ⭐ <%= friendlyNames.provider.rating %>/5.0</p>
                        <% } else { %>
                            <p><strong>Print Provider:</strong> Provider <%= product.print_provider_id || '3' %></p>
                        <% } %>
                        <% if (product.sourceImage) { %>
                            <p><strong>Source Image:</strong> <%= product.sourceImage %></p>
                        <% } %>
                        <% if (product.createdAt) { %>
                            <p><strong>Created:</strong> <%= new Date(product.createdAt).toLocaleDateString() %></p>
                        <% } %>
                        <% if (product.createdBy) { %>
                            <p><strong>Created By:</strong> <%= product.createdBy %></p>
                        <% } %>
                    </div>
                </div>

                <% if (product.description) { %>
                    <div class="detail-section">
                        <h2 class="detail-title">📝 Description</h2>
                        <div class="detail-content">
                            <p><%= product.description %></p>
                        </div>
                    </div>
                <% } %>

                <% if (product.tags && product.tags.length > 0) { %>
                    <div class="detail-section">
                        <h2 class="detail-title">🏷️ Tags</h2>
                        <div class="detail-content">
                            <% product.tags.forEach(tag => { %>
                                <span style="background: #e2e8f0; padding: 4px 8px; border-radius: 4px; margin-right: 8px; font-size: 0.9em;"><%= tag %></span>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <% if (product.variants && product.variants.length > 0) { %>
                    <div class="detail-section">
                        <h2 class="detail-title">🎨 Available Variants (<%= product.variants.length %>)</h2>
                        <div class="variant-grid">
                            <% product.variants.slice(0, 6).forEach(variant => { %>
                                <div class="variant-item">
                                    <% if (variant.options && variant.options.find(opt => opt.name === 'color')) { %>
                                        <div class="variant-color" style="background-color: <%= variant.options.find(opt => opt.name === 'color').value.toLowerCase() %>"></div>
                                    <% } %>
                                    <div class="variant-name">
                                        <%= variant.options ? variant.options.map(opt => opt.value).join(' / ') : 'Standard' %>
                                    </div>
                                    <% if (variant.price) { %>
                                        <div class="variant-price">$<%= (variant.price / 100).toFixed(2) %></div>
                                    <% } %>
                                </div>
                            <% }); %>
                            <% if (product.variants.length > 6) { %>
                                <div class="variant-item" style="background: #f7fafc; color: #718096;">
                                    <div style="font-size: 2em; margin-bottom: 8px;">+</div>
                                    <div class="variant-name"><%= product.variants.length - 6 %> more</div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Meta Information -->
        <div class="meta-info">
            <div class="meta-grid">
                <div class="meta-item">
                    <div class="meta-label">Product Status</div>
                    <div class="meta-value">✅ Preview Ready</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Total Variants</div>
                    <div class="meta-value"><%= product.variants ? product.variants.length : 0 %></div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Images Available</div>
                    <div class="meta-value"><%= product.images ? product.images.length : 0 %></div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Preview Type</div>
                    <div class="meta-value">🎨 Vendor Preview</div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a href="/admin/vendor-research/catalog" class="btn btn-secondary">
                ← Back to Catalog
            </a>
            <button class="btn btn-primary" onclick="copyProductUrl()">
                📋 Copy Preview URL
            </button>
        </div>
    </div>

    <script>
        function changeMainImage(src, thumbnail) {
            document.getElementById('mainImage').src = src;
            
            // Update active thumbnail
            document.querySelectorAll('.thumbnail').forEach(thumb => {
                thumb.classList.remove('active');
            });
            thumbnail.classList.add('active');
        }

        function copyProductUrl() {
            const url = window.location.href;
            navigator.clipboard.writeText(url).then(() => {
                const btn = event.target;
                const originalText = btn.textContent;
                btn.textContent = '✅ Copied!';
                btn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
                
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
                }, 2000);
            }).catch(() => {
                alert('Failed to copy URL to clipboard');
            });
        }
    </script>
</body>
</html>