<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .leaderboard-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 20px;
        }

        .leaderboard-header {
            text-align: center;
            margin-bottom: 40px;
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.2), rgba(75, 0, 130, 0.2));
            padding: 40px 20px;
            border-radius: 20px;
            border: 2px solid rgba(138, 43, 226, 0.3);
        }

        .leaderboard-header h1 {
            font-size: 3rem;
            margin: 0 0 10px 0;
            background: linear-gradient(135deg, #ffd700, #ffa500);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
        }

        .leaderboard-header .trophy {
            font-size: 4rem;
            margin-bottom: 10px;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .leaderboard-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px 30px;
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-box .label {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-box .value {
            font-size: 2rem;
            font-weight: bold;
            color: #ffd700;
            margin-top: 5px;
        }

        .leaderboard-table {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 20px;
            overflow: hidden;
            border: 2px solid rgba(138, 43, 226, 0.3);
        }

        .leaderboard-row {
            display: grid;
            grid-template-columns: 80px 1fr 150px 150px;
            gap: 20px;
            padding: 20px 30px;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .leaderboard-row:hover {
            background: rgba(138, 43, 226, 0.1);
            transform: translateX(5px);
        }

        .leaderboard-row.header {
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(75, 0, 130, 0.3));
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .leaderboard-row.header:hover {
            transform: none;
        }

        .leaderboard-row.top-1 {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 165, 0, 0.1));
            border-left: 5px solid #ffd700;
        }

        .leaderboard-row.top-2 {
            background: linear-gradient(135deg, rgba(192, 192, 192, 0.2), rgba(169, 169, 169, 0.1));
            border-left: 5px solid #c0c0c0;
        }

        .leaderboard-row.top-3 {
            background: linear-gradient(135deg, rgba(205, 127, 50, 0.2), rgba(184, 115, 51, 0.1));
            border-left: 5px solid #cd7f32;
        }

        .leaderboard-row.current-user {
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(75, 0, 130, 0.2));
            border: 2px solid rgba(138, 43, 226, 0.5);
            box-shadow: 0 0 20px rgba(138, 43, 226, 0.3);
        }

        .rank {
            font-size: 1.5rem;
            font-weight: bold;
            text-align: center;
        }

        .rank .medal {
            font-size: 2rem;
        }

        .player-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .player-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .player-name {
            font-size: 1.2rem;
            font-weight: 600;
        }

        .player-badge {
            display: inline-block;
            background: rgba(138, 43, 226, 0.3);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            margin-left: 10px;
            border: 1px solid rgba(138, 43, 226, 0.5);
        }

        .points {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ffd700;
            text-align: right;
        }

        .level {
            font-size: 1.2rem;
            text-align: center;
            color: rgba(255, 255, 255, 0.8);
        }

        .level-badge {
            display: inline-block;
            background: linear-gradient(135deg, #667eea, #764ba2);
            padding: 5px 15px;
            border-radius: 15px;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .no-data {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.2rem;
        }

        .game-filter-tabs {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: rgba(138, 43, 226, 0.2);
            border: 2px solid rgba(138, 43, 226, 0.3);
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1rem;
            font-weight: 600;
        }

        .tab-btn:hover {
            background: rgba(138, 43, 226, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(138, 43, 226, 0.3);
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #8a2be2, #4b0082);
            color: white;
            border-color: #8a2be2;
            box-shadow: 0 0 20px rgba(138, 43, 226, 0.5);
        }

        .game-badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 5px;
        }

        .game-badge {
            background: rgba(138, 43, 226, 0.3);
            padding: 3px 8px;
            border-radius: 10px;
            font-size: 0.7rem;
            border: 1px solid rgba(138, 43, 226, 0.5);
        }

        .game-badge.radio { background: rgba(255, 140, 0, 0.3); border-color: rgba(255, 140, 0, 0.5); }
        .game-badge.gems { background: rgba(0, 191, 255, 0.3); border-color: rgba(0, 191, 255, 0.5); }

        .loading {
            text-align: center;
            padding: 60px 20px;
            font-size: 1.5rem;
        }

        .loading-spinner {
            display: inline-block;
            width: 50px;
            height: 50px;
            border: 5px solid rgba(138, 43, 226, 0.3);
            border-top-color: #8a2be2;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            .leaderboard-row {
                grid-template-columns: 60px 1fr 100px;
                gap: 10px;
                padding: 15px;
            }

            .level {
                display: none;
            }

            .player-name {
                font-size: 1rem;
            }

            .rank {
                font-size: 1.2rem;
            }

            .points {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <div class="leaderboard-container">
            <div class="leaderboard-header">
                <div class="trophy">🏆</div>
                <h1>THE WAVELENGTH LOREKEEPER'S HONOR ROLL</h1>
                <p>Recognizing the most dedicated Lorekeepers! See which members have contributed the most to the Wavelength Atlas, shared the best theories, and earned the highest honor.</p>
                
                <!-- Call-to-Action for Non-Listed Users -->
                <div class="honor-roll-cta" style="margin-top: 30px; padding: 25px; background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(255, 165, 0, 0.1)); border: 2px solid rgba(255, 215, 0, 0.3); border-radius: 15px;">
                    <h3 style="color: #ffd700; margin: 0 0 15px 0; font-size: 1.3rem;">🌟 Want to join the ranks?</h3>
                    <p style="margin: 0 0 15px 0; color: rgba(255, 255, 255, 0.9);">Every post counts! Climb the Honor Roll and gain respect, exclusive forum flair, and a chance for a feature in a community spotlight!</p>
                    <a href="/forum" style="display: inline-block; background: linear-gradient(135deg, #ffd700, #ffa500); color: #000; padding: 12px 25px; border-radius: 25px; text-decoration: none; font-weight: bold; margin-right: 15px; transition: transform 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">📜 Share Your First Theory</a>
                    <a href="/forum/categories/fan-theories" style="display: inline-block; background: rgba(138, 43, 226, 0.8); color: #fff; padding: 12px 25px; border-radius: 25px; text-decoration: none; font-weight: bold; transition: transform 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">🧠 Explore Fan Theories</a>
                </div>
                
                <div class="leaderboard-stats" id="leaderboardStats">
                    <div class="stat-box">
                        <div class="label">Total Lorekeepers</div>
                        <div class="value" id="totalPlayers">-</div>
                    </div>
                    <div class="stat-box">
                        <div class="label">Combined Lore Points</div>
                        <div class="value" id="totalPoints">-</div>
                    </div>
                    <div class="stat-box">
                        <div class="label">Active Channels</div>
                        <div class="value" id="activeGames">-</div>
                    </div>
                    <div class="stat-box">
                        <div class="label">Your Honor Rank</div>
                        <div class="value" id="yourRank">-</div>
                    </div>
                </div>
            </div>

            <!-- Game Filter Tabs -->
            <div class="game-filter-tabs">
                <button class="tab-btn active" data-game="all">🏆 All Achievements</button>
                <button class="tab-btn" data-game="radio">🎵 Audio Archive</button>
                <button class="tab-btn" data-game="wavelength-gems">💎 THE SHIRE BATTLEGAMES: Crystal Harvest</button>
                <button class="tab-btn" data-game="other-games">🎮 Other Quests</button>
            </div>

            <div class="leaderboard-table">
                <div class="leaderboard-row header">
                    <div>Honor Rank</div>
                    <div>Lorekeeper</div>
                    <div>Contributions</div>
                    <div>Lore Points</div>
                </div>
                <div id="leaderboardContent">
                    <div class="loading">
                        <div class="loading-spinner"></div>
                        <p>Loading leaderboard...</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Global leaderboard data
        let allPlayersData = [];
        let currentFilter = 'all';
        let activeGames = new Set();

        // Load leaderboard data from multiple sources
        async function loadLeaderboard() {
            console.log('🏆 loadLeaderboard() called');
            try {
                // Wait for Firebase to be ready
                if (!window.firebaseDB || !window.firebaseUtils) {
                    console.log('⏳ Firebase not ready, retrying...');
                    setTimeout(loadLeaderboard, 500);
                    return;
                }
                
                console.log('✅ Firebase ready, loading multi-game leaderboard data...');
                console.log('🔍 About to call loadMultiGameLeaderboard');
                console.log('Function exists:', typeof loadMultiGameLeaderboard);
                loadMultiGameLeaderboard().then(() => {
                    console.log('✅ loadMultiGameLeaderboard completed');
                }).catch(error => {
                    console.error('❌ loadMultiGameLeaderboard failed:', error);
                    document.getElementById('leaderboardContent').innerHTML = 
                        '<div class="no-data">❌ Failed to load leaderboard data.<br><br>Error: ' + error.message + '</div>';
                });

            } catch (error) {
                console.error('Error setting up leaderboard:', error);
                document.getElementById('leaderboardContent').innerHTML = 
                    '<div class="no-data">Failed to initialize leaderboard. Please try refreshing the page.</div>';
            }
        }

        async function loadMultiGameLeaderboard() {
            console.log('🚀 loadMultiGameLeaderboard() START');
            console.log('Firebase DB:', !!window.firebaseDB);
            console.log('Firebase Utils:', !!window.firebaseUtils);
            try {
                console.log('🔄 Loading leaderboard data from multiple sources...');
                
                // Test Firebase connection first
                console.log('🔍 Testing Firebase connection...');
                const testRef = window.firebaseUtils.ref(window.firebaseDB, '/');
                const testSnapshot = await window.firebaseUtils.get(testRef);
                console.log('📊 Firebase root data exists:', testSnapshot.exists());
                if (testSnapshot.exists()) {
                    const rootData = testSnapshot.val();
                    console.log('📊 Firebase root keys:', Object.keys(rootData));
                }
                
                // Load both radio player stats and game scores in parallel
                const [radioPlayersData, gameScoresData] = await Promise.all([
                    loadRadioPlayerStats(),
                    loadGameScores()
                ]);

                console.log('📊 Radio players loaded:', radioPlayersData.length);
                console.log('🎮 Game scores loaded:', gameScoresData.length);

                // Combine all player data
                const combinedData = combinePlayerData(radioPlayersData, gameScoresData);
                console.log('🏆 Combined leaderboard data:', combinedData.length, 'total players');
                
                allPlayersData = combinedData;
                updateStats(combinedData);
                renderLeaderboard(combinedData, currentFilter);

                // If no data found, show helpful message
                if (combinedData.length === 0) {
                    document.getElementById('leaderboardContent').innerHTML = 
                        '<div class="no-data">📚 The Honor Roll awaits its first Lorekeepers!<br><br>Begin your journey to lore mastery:<br><br><a href="/forum" style="color: #ffd700; font-weight: bold;">📜 Share Your First Theory</a> or <a href="/radio" style="color: #667eea; font-weight: bold;">� Explore the Audio Archive</a><br><br>Every contribution earns you honor and recognition in the Wavelength community!</div>';
                }

            } catch (error) {
                console.error('Error loading multi-game leaderboard:', error);
                document.getElementById('leaderboardContent').innerHTML = 
                    '<div class="no-data">❌ Error loading leaderboard data.<br><br>Please check your internet connection and try refreshing the page.</div>';
            }
        }

        async function loadRadioPlayerStats() {
            return new Promise((resolve) => {
                const usersRef = window.firebaseUtils.ref(window.firebaseDB, 'users');
                
                // Set a timeout to prevent infinite loading
                const timeout = setTimeout(() => {
                    console.warn('Radio player stats loading timed out');
                    resolve([]);
                }, 10000);
                
                window.firebaseUtils.onValue(usersRef, async (snapshot) => {
                    try {
                        clearTimeout(timeout);
                        const players = [];
                        
                        if (!snapshot.exists()) {
                            console.log('No users data found in Firebase');
                            resolve(players);
                            return;
                        }

                        const users = snapshot.val();
                        console.log(`Found ${Object.keys(users).length} users in database`);
                        
                        // Get forum user data for display names
                        const forumUsersRef = window.firebaseUtils.ref(window.firebaseDB, 'forum/users');
                        const forumSnapshot = await window.firebaseUtils.get(forumUsersRef);
                        const forumUsers = forumSnapshot.exists() ? forumSnapshot.val() : {};
                        console.log(`Found ${Object.keys(forumUsers).length} forum users`);

                        Object.keys(users).forEach(userId => {
                            const user = users[userId];
                            const stats = user.radioPlayerStats || {};
                            
                            // Calculate total points from individual stats
                            const pointValues = {
                                mushrooms: 10, stars: 5, horseshoes: 15, sparkles: 5,
                                crystals: 8, moons: 7, goblins: 25
                            };
                            
                            let calculatedTotal = 0;
                            for (const [stat, count] of Object.entries(stats)) {
                                if (pointValues[stat]) {
                                    calculatedTotal += (count || 0) * pointValues[stat];
                                }
                            }
                            calculatedTotal += (stats.gameModePoints || 0);
                            
                            const totalPoints = Math.max(stats.totalPoints || 0, calculatedTotal);
                            
                            if (totalPoints > 0) {
                                const forumUser = forumUsers[userId] || {};
                                const userName = forumUser.name || forumUser.displayName || `Player ${userId.substring(0, 6)}`;
                                
                                players.push({
                                    userId,
                                    userName,
                                    radioPoints: totalPoints,
                                    radioLevel: stats.magicLevel || 1,
                                    isCurrentUser: window.forumState?.currentUser?.uid === userId
                                });
                                
                                activeGames.add('radio');
                            }
                        });
                        
                        console.log(`Found ${players.length} players with radio stats`);
                        resolve(players);
                    } catch (error) {
                        clearTimeout(timeout);
                        console.error('Error processing radio player data:', error);
                        resolve([]);
                    }
                }, (error) => {
                    clearTimeout(timeout);
                    console.error('Firebase onValue error:', error);
                    resolve([]);
                });
            });
        }

        async function loadGameScores() {
            try {
                console.log('Loading game scores from API...');
                const response = await fetch('/api/games/leaderboard/global?limit=1000');
                const data = await response.json();
                
                console.log('Game scores API response:', data);
                
                if (data.success && data.leaderboard) {
                    console.log(`Found ${data.leaderboard.length} game players`);
                    
                    // Track which games are active
                    data.leaderboard.forEach(player => {
                        if (player.gamesPlayed > 0) {
                            activeGames.add('games');
                            // You could track specific games here if needed
                        }
                    });
                    
                    return data.leaderboard.map(player => ({
                        userId: player.userId,
                        userName: player.userName,
                        gamePoints: player.totalScore,
                        gamesPlayed: player.gamesPlayed,
                        isCurrentUser: window.forumState?.currentUser?.uid === player.userId
                    }));
                }
                console.log('No game leaderboard data found');
                return [];
            } catch (error) {
                console.error('Error loading game scores:', error);
                return [];
            }
        }

        function combinePlayerData(radioPlayers, gamePlayers) {
            const playerMap = new Map();
            
            // Add radio player data
            radioPlayers.forEach(player => {
                playerMap.set(player.userId, {
                    ...player,
                    gamePoints: 0,
                    gamesPlayed: 0,
                    totalCombinedPoints: player.radioPoints
                });
            });
            
            // Add/merge game player data
            gamePlayers.forEach(player => {
                if (playerMap.has(player.userId)) {
                    const existing = playerMap.get(player.userId);
                    existing.gamePoints = player.gamePoints;
                    existing.gamesPlayed = player.gamesPlayed;
                    existing.totalCombinedPoints = (existing.radioPoints || 0) + player.gamePoints;
                } else {
                    playerMap.set(player.userId, {
                        ...player,
                        radioPoints: 0,
                        radioLevel: 1,
                        totalCombinedPoints: player.gamePoints
                    });
                }
            });
            
            // Convert to array and sort by total combined points
            return Array.from(playerMap.values())
                .filter(player => player.totalCombinedPoints > 0)
                .sort((a, b) => b.totalCombinedPoints - a.totalCombinedPoints);
        }

        function updateStats(players) {
            const totalPlayers = players.length;
            const totalPoints = players.reduce((sum, p) => sum + p.totalCombinedPoints, 0);
            const currentUserIndex = players.findIndex(p => p.isCurrentUser);
            
            document.getElementById('totalPlayers').textContent = totalPlayers.toLocaleString();
            document.getElementById('totalPoints').textContent = totalPoints.toLocaleString();
            document.getElementById('activeGames').textContent = activeGames.size;
            document.getElementById('yourRank').textContent = currentUserIndex >= 0 ? `#${currentUserIndex + 1}` : 'N/A';
        }

        function renderLeaderboard(players, filter = 'all') {
            const content = document.getElementById('leaderboardContent');
            
            // Filter players based on selected filter
            let filteredPlayers = players;
            
            switch (filter) {
                case 'radio':
                    filteredPlayers = players.filter(p => p.radioPoints > 0);
                    break;
                case 'wavelength-gems':
                case 'other-games':
                    filteredPlayers = players.filter(p => p.gamePoints > 0);
                    break;
                case 'all':
                default:
                    filteredPlayers = players;
                    break;
            }
            
            // Re-sort and re-rank based on filter
            if (filter === 'radio') {
                filteredPlayers.sort((a, b) => b.radioPoints - a.radioPoints);
            } else if (filter === 'wavelength-gems' || filter === 'other-games') {
                filteredPlayers.sort((a, b) => b.gamePoints - a.gamePoints);
            } else {
                filteredPlayers.sort((a, b) => b.totalCombinedPoints - a.totalCombinedPoints);
            }
            
            if (filteredPlayers.length === 0) {
                content.innerHTML = '<div class="no-data">📜 No Lorekeepers found in this category!<br><br>Be the first to earn honor in this achievement area!</div>';
                return;
            }

            // Render top players (limit to top 100)
            const topPlayers = filteredPlayers.slice(0, 100);
            
            content.innerHTML = topPlayers.map((player, index) => {
                const rank = index + 1;
                let rankDisplay = rank;
                let rowClass = '';

                // Add medal for top 3
                if (rank === 1) {
                    rankDisplay = '<span class="medal">🥇</span>';
                    rowClass = 'top-1';
                } else if (rank === 2) {
                    rankDisplay = '<span class="medal">🥈</span>';
                    rowClass = 'top-2';
                } else if (rank === 3) {
                    rankDisplay = '<span class="medal">🥉</span>';
                    rowClass = 'top-3';
                }

                // Add current user class
                if (player.isCurrentUser) {
                    rowClass += ' current-user';
                }

                // Get display points based on filter
                let displayPoints = player.totalCombinedPoints;
                if (filter === 'radio') displayPoints = player.radioPoints;
                else if (filter === 'wavelength-gems' || filter === 'other-games') displayPoints = player.gamePoints;

                // Get first letter for avatar
                const avatarLetter = player.userName.charAt(0).toUpperCase();

                // Get prestigious honor rank
                const honorRank = getHonorRank(rank, displayPoints);

                // Create game badges with lore-themed names
                let gameBadges = '';
                if (filter === 'all') {
                    if (player.radioPoints > 0) {
                        gameBadges += '<span class="game-badge radio">🎵 Audio Archive</span>';
                    }
                    if (player.gamePoints > 0) {
                        gameBadges += '<span class="game-badge gems">💎 Quest Master</span>';
                    }
                }

                return `
                    <div class="leaderboard-row ${rowClass}">
                        <div class="rank">
                            ${rankDisplay}
                            <div style="font-size: 0.7rem; margin-top: 2px; color: rgba(255,255,255,0.7);">#${rank}</div>
                        </div>
                        <div class="player-info">
                            <div class="player-avatar">${avatarLetter}</div>
                            <div>
                                <span class="player-name">${escapeHtml(player.userName)}</span>
                                ${player.isCurrentUser ? '<span class="player-badge">You</span>' : ''}
                                <div style="font-size: 0.8rem; color: #ffd700; margin-top: 3px; font-weight: bold;">
                                    ${honorRank.title}
                                </div>
                                <div class="game-badges">${gameBadges}</div>
                            </div>
                        </div>
                        <div class="level">
                            ${filter === 'all' ? 
                                `Audio: ${player.radioPoints.toLocaleString()}<br>Quests: ${player.gamePoints.toLocaleString()}` :
                                filter === 'radio' ? 
                                    `<span class="level-badge">Level ${player.radioLevel}</span>` :
                                    `${player.gamesPlayed} quests`
                            }
                        </div>
                        <div class="points">${displayPoints.toLocaleString()}</div>
                    </div>
                `;
            }).join('');
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Get prestigious lore-themed rank based on position
        function getHonorRank(position, totalPoints) {
            if (position <= 3) {
                return {
                    title: position === 1 ? "🏆 Grand Archivist" : position === 2 ? "👑 Wavelength Champion" : "⭐ Master Chronicler",
                    description: "Ultimate prestige and exclusive status",
                    tier: "legendary"
                };
            } else if (position <= 10) {
                return {
                    title: "🎖️ Master Lorekeeper",
                    description: "High achievement, recognized expert status",
                    tier: "master"
                };
            } else if (position <= 25) {
                return {
                    title: "📜 Certified Bard",
                    description: "Respected storyteller and theorist",
                    tier: "expert"
                };
            } else if (totalPoints >= 100) {
                return {
                    title: "🎭 Shire Messenger",
                    description: "Active community contributor",
                    tier: "veteran"
                };
            } else {
                return {
                    title: "🌟 Apprentice Bard",
                    description: "Beginning the journey to lore mastery",
                    tier: "apprentice"
                };
            }
        }

        // Setup filter tab event listeners
        function setupFilterTabs() {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    // Update active tab
                    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    
                    // Update filter and re-render
                    currentFilter = btn.dataset.game;
                    renderLeaderboard(allPlayersData, currentFilter);
                });
            });
        }

        // Initialize everything when page loads
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                loadLeaderboard();
                setupFilterTabs();
            });
        } else {
            loadLeaderboard();
            setupFilterTabs();
        }
        
        // Fallback timeout in case Firebase never loads
        setTimeout(() => {
            if (!window.firebaseDB || !window.firebaseUtils) {
                console.warn('Firebase failed to load within 15 seconds, showing fallback message');
                document.getElementById('leaderboardContent').innerHTML = 
                    '<div class="no-data">⚠️ Firebase connection timeout.<br><br>The leaderboard requires a connection to our database.<br>Please check your internet connection and refresh the page.</div>';
            }
        }, 15000);
    </script>
</body>
</html>
