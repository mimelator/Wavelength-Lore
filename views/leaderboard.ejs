<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .leaderboard-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 20px;
        }

        .leaderboard-header {
            text-align: center;
            margin-bottom: 40px;
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.2), rgba(75, 0, 130, 0.2));
            padding: 40px 20px;
            border-radius: 20px;
            border: 2px solid rgba(138, 43, 226, 0.3);
        }

        .leaderboard-header h1 {
            font-size: 3rem;
            margin: 0 0 10px 0;
            background: linear-gradient(135deg, #ffd700, #ffa500);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
        }

        .leaderboard-header .trophy {
            font-size: 4rem;
            margin-bottom: 10px;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .leaderboard-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px 30px;
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-box .label {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-box .value {
            font-size: 2rem;
            font-weight: bold;
            color: #ffd700;
            margin-top: 5px;
        }

        .leaderboard-table {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 20px;
            overflow: hidden;
            border: 2px solid rgba(138, 43, 226, 0.3);
        }

        .leaderboard-row {
            display: grid;
            grid-template-columns: 80px 1fr 150px 150px;
            gap: 20px;
            padding: 20px 30px;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .leaderboard-row:hover {
            background: rgba(138, 43, 226, 0.1);
            transform: translateX(5px);
        }

        .leaderboard-row.header {
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(75, 0, 130, 0.3));
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .leaderboard-row.header:hover {
            transform: none;
        }

        .leaderboard-row.top-1 {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 165, 0, 0.1));
            border-left: 5px solid #ffd700;
        }

        .leaderboard-row.top-2 {
            background: linear-gradient(135deg, rgba(192, 192, 192, 0.2), rgba(169, 169, 169, 0.1));
            border-left: 5px solid #c0c0c0;
        }

        .leaderboard-row.top-3 {
            background: linear-gradient(135deg, rgba(205, 127, 50, 0.2), rgba(184, 115, 51, 0.1));
            border-left: 5px solid #cd7f32;
        }

        .leaderboard-row.current-user {
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(75, 0, 130, 0.2));
            border: 2px solid rgba(138, 43, 226, 0.5);
            box-shadow: 0 0 20px rgba(138, 43, 226, 0.3);
        }

        .rank {
            font-size: 1.5rem;
            font-weight: bold;
            text-align: center;
        }

        .rank .medal {
            font-size: 2rem;
        }

        .player-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .player-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .player-name {
            font-size: 1.2rem;
            font-weight: 600;
        }

        .player-badge {
            display: inline-block;
            background: rgba(138, 43, 226, 0.3);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            margin-left: 10px;
            border: 1px solid rgba(138, 43, 226, 0.5);
        }

        .points {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ffd700;
            text-align: right;
        }

        .level {
            font-size: 1.2rem;
            text-align: center;
            color: rgba(255, 255, 255, 0.8);
        }

        .level-badge {
            display: inline-block;
            background: linear-gradient(135deg, #667eea, #764ba2);
            padding: 5px 15px;
            border-radius: 15px;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .no-data {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.2rem;
        }

        .loading {
            text-align: center;
            padding: 60px 20px;
            font-size: 1.5rem;
        }

        .loading-spinner {
            display: inline-block;
            width: 50px;
            height: 50px;
            border: 5px solid rgba(138, 43, 226, 0.3);
            border-top-color: #8a2be2;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            .leaderboard-row {
                grid-template-columns: 60px 1fr 100px;
                gap: 10px;
                padding: 15px;
            }

            .level {
                display: none;
            }

            .player-name {
                font-size: 1rem;
            }

            .rank {
                font-size: 1.2rem;
            }

            .points {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <div class="leaderboard-container">
            <div class="leaderboard-header">
                <div class="trophy">🏆</div>
                <h1>Global Leaderboard</h1>
                <p>Top Players by Total Points</p>
                
                <div class="leaderboard-stats" id="leaderboardStats">
                    <div class="stat-box">
                        <div class="label">Total Players</div>
                        <div class="value" id="totalPlayers">-</div>
                    </div>
                    <div class="stat-box">
                        <div class="label">Total Points</div>
                        <div class="value" id="totalPoints">-</div>
                    </div>
                    <div class="stat-box">
                        <div class="label">Your Rank</div>
                        <div class="value" id="yourRank">-</div>
                    </div>
                </div>
            </div>

            <div class="leaderboard-table">
                <div class="leaderboard-row header">
                    <div>Rank</div>
                    <div>Player</div>
                    <div>Level</div>
                    <div>Total Points</div>
                </div>
                <div id="leaderboardContent">
                    <div class="loading">
                        <div class="loading-spinner"></div>
                        <p>Loading leaderboard...</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Load leaderboard data from Firebase
        function loadLeaderboard() {
            console.log('🏆 loadLeaderboard() called');
            try {
                // Wait for Firebase to be ready
                if (!window.firebaseDB || !window.firebaseUtils) {
                    console.log('⏳ Firebase not ready, retrying...');
                    setTimeout(loadLeaderboard, 500);
                    return;
                }
                
                console.log('✅ Firebase ready, loading leaderboard data...');

                // Use onValue for real-time updates
                // User data with radioPlayerStats is stored under /forum/users
                const usersRef = window.firebaseUtils.ref(window.firebaseDB, 'forum/users');
                console.log('📡 Setting up listener on forum/users path...');
                
                window.firebaseUtils.onValue(usersRef, (snapshot) => {
                    console.log('📥 onValue callback triggered, snapshot exists:', snapshot.exists());
                    try {
                        if (!snapshot.exists()) {
                            document.getElementById('leaderboardContent').innerHTML = 
                                '<div class="no-data">No players found yet. Be the first!</div>';
                            return;
                        }

                        const users = snapshot.val();
                        const leaderboardData = [];
                        let totalPointsSum = 0;

                        // Debug: Log received data
                        console.log('Received users data:', users);
                        console.log('Number of users:', Object.keys(users || {}).length);

                        // Ensure users exists
                        if (!users || typeof users !== 'object') {
                            console.error('Invalid users data:', users);
                            document.getElementById('leaderboardContent').innerHTML = 
                                '<div class="no-data">Invalid data format. Please try again.</div>';
                            return;
                        }

                        // Process users and extract leaderboard data
                        Object.keys(users).forEach(userId => {
                            const user = users[userId];
                            const stats = user.radioPlayerStats || {};
                            
                            // Debug: Log each user's stats
                            console.log(`User ${userId}:`, { stats, totalPoints: stats.totalPoints });
                            const totalPoints = stats.totalPoints || 0;
                            const magicLevel = stats.magicLevel || 1;

                            // Get user name from forum profile or use ID
                            const forumUser = users[userId];
                            const userName = forumUser.name || user.displayName || `Player ${userId.substring(0, 6)}`;

                            if (totalPoints > 0) {
                                leaderboardData.push({
                                    userId,
                                    userName,
                                    totalPoints,
                                    magicLevel,
                                    isCurrentUser: window.forumState?.currentUser?.uid === userId
                                });
                                totalPointsSum += totalPoints;
                            }
                        });

                        // Sort by total points
                        leaderboardData.sort((a, b) => b.totalPoints - a.totalPoints);

                        // Update stats
                        document.getElementById('totalPlayers').textContent = leaderboardData.length.toLocaleString();
                        document.getElementById('totalPoints').textContent = totalPointsSum.toLocaleString();

                        // Find current user's rank
                        const currentUserIndex = leaderboardData.findIndex(p => p.isCurrentUser);
                        if (currentUserIndex >= 0) {
                            document.getElementById('yourRank').textContent = `#${currentUserIndex + 1}`;
                        } else {
                            document.getElementById('yourRank').textContent = 'N/A';
                        }

                        // Render leaderboard
                        renderLeaderboard(leaderboardData);
                    } catch (error) {
                        console.error('Error processing leaderboard data:', error);
                        document.getElementById('leaderboardContent').innerHTML = 
                            '<div class="no-data">Error processing data. Please try again.</div>';
                    }
                }, (error) => {
                    console.error('Error loading leaderboard:', error);
                    document.getElementById('leaderboardContent').innerHTML = 
                        '<div class="no-data">Failed to load leaderboard. Please try again later.</div>';
                });

            } catch (error) {
                console.error('Error setting up leaderboard:', error);
                document.getElementById('leaderboardContent').innerHTML = 
                    '<div class="no-data">Failed to initialize leaderboard.</div>';
            }
        }

        function renderLeaderboard(data) {
            const content = document.getElementById('leaderboardContent');
            
            if (data.length === 0) {
                content.innerHTML = '<div class="no-data">No players on the leaderboard yet!</div>';
                return;
            }

            // Render top players (limit to top 100)
            const topPlayers = data.slice(0, 100);
            
            content.innerHTML = topPlayers.map((player, index) => {
                const rank = index + 1;
                let rankDisplay = rank;
                let rowClass = '';

                // Add medal for top 3
                if (rank === 1) {
                    rankDisplay = '<span class="medal">🥇</span>';
                    rowClass = 'top-1';
                } else if (rank === 2) {
                    rankDisplay = '<span class="medal">🥈</span>';
                    rowClass = 'top-2';
                } else if (rank === 3) {
                    rankDisplay = '<span class="medal">🥉</span>';
                    rowClass = 'top-3';
                }

                // Add current user class
                if (player.isCurrentUser) {
                    rowClass += ' current-user';
                }

                // Get first letter for avatar
                const avatarLetter = player.userName.charAt(0).toUpperCase();

                return `
                    <div class="leaderboard-row ${rowClass}">
                        <div class="rank">${rankDisplay}</div>
                        <div class="player-info">
                            <div class="player-avatar">${avatarLetter}</div>
                            <div>
                                <span class="player-name">${escapeHtml(player.userName)}</span>
                                ${player.isCurrentUser ? '<span class="player-badge">You</span>' : ''}
                            </div>
                        </div>
                        <div class="level">
                            <span class="level-badge">Lv ${player.magicLevel}</span>
                        </div>
                        <div class="points">${player.totalPoints.toLocaleString()}</div>
                    </div>
                `;
            }).join('');
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Load when page is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadLeaderboard);
        } else {
            loadLeaderboard();
        }
    </script>
</body>
</html>
