    // Edit prompt
    async function editPrompt(promptId) {
        try {
            const prompt = allPrompts.find(p => p.id === promptId);
            if (!prompt) {
                alert('Prompt not found');
                return;
            }

            document.getElementById('promptModalTitle').textContent = 'Edit Prompt';
            document.getElementById('promptId').value = prompt.id;
            document.getElementById('promptTitle').value = prompt.title;
            document.getElementById('promptContent').value = prompt.content;
            document.getElementById('promptCategory').value = prompt.category || 'general';
            document.getElementById('promptKeywords').value = prompt.keywords.join(', ');
            document.getElementById('promptTags').value = prompt.tags.join(', ');

            document.getElementById('promptModal').classList.add('active');
        } catch (error) {
            console.error('Error loading prompt for edit:', error);
            alert('Error loading prompt');
        }
    }

    // Clone prompt for experimentation
    async function clonePrompt(promptId) {
        try {
            const prompt = allPrompts.find(p => p.id === promptId);
            if (!prompt) {
                alert('Prompt not found');
                return;
            }

            // Open create modal with cloned data
            document.getElementById('promptModalTitle').textContent = 'Clone Prompt';
            document.getElementById('promptId').value = ''; // Empty ID = create new
            document.getElementById('promptTitle').value = `${prompt.title} (Copy)`;
            document.getElementById('promptContent').value = prompt.content;
            document.getElementById('promptCategory').value = prompt.category || 'general';
            document.getElementById('promptKeywords').value = prompt.keywords.join(', ');
            document.getElementById('promptTags').value = prompt.tags.join(', ');

            document.getElementById('promptModal').classList.add('active');
            
            // Focus on title so user can rename
            setTimeout(() => {
                const titleInput = document.getElementById('promptTitle');
                titleInput.focus();
                titleInput.select(); // Select the text so they can easily rename
            }, 100);

        } catch (error) {
            console.error('Error cloning prompt:', error);
            alert('Error cloning prompt');
        }
    }

    // Delete prompt
    async function deletePrompt(promptId) {
        if (!confirm('Are you sure you want to delete this prompt? This action cannot be undone.')) {
            return;
        }

        try {
            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            const response = await fetch(`/api/prompts/${promptId}?hard=true`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${idToken}`
                }
            });

            if (response.ok) {
                console.log('✅ Prompt deleted successfully');
                await loadPrompts(); // Reload to update UI
                alert('Prompt deleted successfully');
            } else {
                const error = await response.json();
                alert('Failed to delete prompt: ' + error.message);
            }
        } catch (error) {
            console.error('Error deleting prompt:', error);
            alert('Error deleting prompt');
        }
    }

    // Handle prompt form submission
    document.getElementById('promptForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const statusEl = document.getElementById('promptSaveStatus');
        statusEl.className = 'save-status saving';
        statusEl.textContent = '⏳ Saving...';

        try {
            const promptId = document.getElementById('promptId').value;
            const isEdit = promptId !== '';

            const formData = {
                title: document.getElementById('promptTitle').value.trim(),
                content: document.getElementById('promptContent').value.trim(),
                category: document.getElementById('promptCategory').value,
                keywords: document.getElementById('promptKeywords').value.split(',').map(k => k.trim()).filter(k => k),
                tags: document.getElementById('promptTags').value.split(',').map(t => t.trim()).filter(t => t)
            };

            // Generate ID from title if creating new
            if (!isEdit) {
                formData.id = formData.title.toLowerCase()
                    .replace(/[^a-z0-9\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-|-$/g, '');

                // Add current content as linked
                if (contentType === 'character') {
                    formData.linkedCharacters = [contentId];
                    formData.linkedEpisodes = [];
                    formData.linkedLore = [];
                } else if (contentType === 'episode') {
                    formData.linkedCharacters = [];
                    formData.linkedEpisodes = [contentId];
                    formData.linkedLore = [];
                } else if (contentType === 'lore') {
                    formData.linkedCharacters = [];
                    formData.linkedEpisodes = [];
                    formData.linkedLore = [contentId];
                }
            }

            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            const url = isEdit ? `/api/prompts/${promptId}` : '/api/prompts';
            const method = isEdit ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${idToken}`
                },
                body: JSON.stringify(formData)
            });

            if (response.ok) {
                statusEl.className = 'save-status success';
                statusEl.textContent = '✅ Saved!';

                setTimeout(() => {
                    closePromptModal();
                    loadPrompts(); // Reload prompts
                }, 1000);
            } else {
                const error = await response.json();
                throw new Error(error.message || 'Failed to save prompt');
            }
        } catch (error) {
            console.error('Error saving prompt:', error);
            statusEl.className = 'save-status error';
            statusEl.textContent = '❌ Error: ' + error.message;
        }
    });

    // Close modals when clicking outside
    document.getElementById('promptModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closePromptModal();
        }
    });

    document.getElementById('promptViewModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closePromptViewModal();
        }
    });

    // ===========================
    // AI IMAGE GENERATION
    // ===========================

    let currentPromptForGeneration = null;
    let generatedImagesData = [];

    // Generate AI images
    async function generateAIImages() {
        if (!currentPromptForGeneration) {
            alert('No prompt loaded');
            return;
        }

        // Get the current prompt content from the editable textarea
        const promptTextarea = document.getElementById('editablePromptContent');
        const promptText = promptTextarea ? promptTextarea.value.trim() : currentPromptForGeneration.content;

        if (!promptText) {
            alert('Prompt content is empty');
            return;
        }

        const generateBtn = document.getElementById('generateBtn');
        const statusEl = document.getElementById('generationStatus');
        const count = parseInt(document.getElementById('imageCount').value);

        // Immediate visual feedback
        generateBtn.disabled = true;
        generateBtn.style.opacity = '0.6';
        generateBtn.style.cursor = 'not-allowed';
        generateBtn.innerHTML = '⏳ Generating...';
        
        statusEl.style.display = 'inline-block';
        statusEl.className = 'save-status saving';
        statusEl.textContent = `⏳ Generating ${count} image(s)... This may take 10-30 seconds`;

        // Hide previous results if any
        document.getElementById('generatedImagesContainer').style.display = 'none';

        try {
            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            const response = await fetch('/api/generate/image', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${idToken}`
                },
                body: JSON.stringify({
                    promptId: currentPromptForGeneration.id,
                    promptText: promptText,  // Use the current textarea value
                    count: count,
                    width: 1024,
                    height: 1024,
                    style: currentPromptForGeneration.category || 'photorealistic'
                })
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Generation failed');
            }

            const result = await response.json();

            if (result.success && result.images && result.images.length > 0) {
                generatedImagesData = result.images;
                displayGeneratedImages(result.images);
                
                statusEl.className = 'save-status success';
                statusEl.textContent = `✅ Generated ${result.images.length} image(s)!`;

                // Show the images container
                document.getElementById('generatedImagesContainer').style.display = 'block';
            } else {
                throw new Error('No images generated');
            }

        } catch (error) {
            console.error('Error generating images:', error);
            statusEl.className = 'save-status error';
            statusEl.textContent = `❌ Error: ${error.message}`;
        } finally {
            // Reset button state
            generateBtn.disabled = false;
            generateBtn.style.opacity = '1';
            generateBtn.style.cursor = 'pointer';
            generateBtn.innerHTML = '🎨 Generate Images';
        }
    }

    // Display generated images in grid
    function displayGeneratedImages(images) {
        const grid = document.getElementById('generatedImagesGrid');
        
        grid.innerHTML = images.map((img, index) => `
            <div style="position: relative; border: 2px solid #e0e0e0; border-radius: 8px; overflow: hidden; transition: all 0.2s ease;"
                 onmouseover="this.style.borderColor='#667eea'; this.style.transform='scale(1.05)'"
                 onmouseout="this.style.borderColor='#e0e0e0'; this.style.transform='scale(1)'">
                <input type="checkbox" 
                       id="img-${index}" 
                       data-index="${index}"
                       style="position: absolute; top: 10px; left: 10px; width: 20px; height: 20px; cursor: pointer; z-index: 10;"
                       checked>
                <img src="${img.dataUrl}" 
                     alt="Generated image ${index + 1}"
                     style="width: 100%; height: 200px; object-fit: cover; display: block; cursor: zoom-in;"
                     onclick="event.stopPropagation(); openLightbox('${img.dataUrl}', 'AI Generated Image ${index + 1}')">
                <div style="padding: 8px; background: #f8f9fa; font-size: 12px; color: #666; cursor: pointer;"
                     onclick="document.getElementById('img-${index}').checked = !document.getElementById('img-${index}').checked">
                    Image ${index + 1} • Click to view full size
                </div>
            </div>
        `).join('');
    }

    // Add selected images to content gallery
    async function addSelectedToGallery() {
        const checkboxes = document.querySelectorAll('#generatedImagesGrid input[type="checkbox"]:checked');
        
        if (checkboxes.length === 0) {
            alert('Please select at least one image to add');
            return;
        }

        // Extract only the image IDs - server has the full data cached
        const selectedImageIds = Array.from(checkboxes).map(cb => {
            const index = parseInt(cb.dataset.index);
            return generatedImagesData[index].id;
        });

        const addBtn = document.getElementById('addToGalleryBtn');
        const statusEl = document.getElementById('addToGalleryStatus');

        addBtn.disabled = true;
        statusEl.className = 'save-status saving';
        statusEl.textContent = `⏳ Adding ${selectedImageIds.length} image(s) to gallery...`;

        try {
            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            const response = await fetch('/api/generate/add-to-gallery', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${idToken}`
                },
                body: JSON.stringify({
                    contentType: contentType,
                    contentId: contentId,
                    firebasePath: firebasePath,
                    imageIds: selectedImageIds  // Send only IDs, not full data
                })
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Failed to add images');
            }

            const result = await response.json();

            statusEl.className = 'save-status success';
            statusEl.textContent = `✅ Added ${result.imagesAdded} image(s) to gallery!`;

            // Clear selected images after adding
            setTimeout(() => {
                document.getElementById('generatedImagesContainer').style.display = 'none';
                generatedImagesData = [];
                statusEl.style.display = 'none';
                
                // Suggest refreshing the page to see new images
                if (confirm('Images added successfully! Would you like to refresh the page to see them in the gallery?')) {
                    location.reload();
                }
            }, 2000);

        } catch (error) {
            console.error('Error adding to gallery:', error);
            statusEl.className = 'save-status error';
            statusEl.textContent = `❌ Error: ${error.message}`;
        } finally {
            addBtn.disabled = false;
        }
    }

    // ===== End Generation Functions =====

    // Load prompts when page is ready
    window.addEventListener('DOMContentLoaded', loadPrompts);

    // Client-side permission check
    let permissionVerified = false;

    function checkPagePermission() {
        const userGroups = window.wavelengthUserGroups;

        if (userGroups && Array.isArray(userGroups)) {
            const hasPermission = userGroups.includes('content_manager') ||
                                userGroups.includes('admin') ||
                                userGroups.includes('super_admin');

            if (hasPermission) {
                permissionVerified = true;
            } else {
                alert('Access denied. You need content_manager role or higher.');
                window.location.href = '<%= backUrl %>';
            }
        }
    }

    // Listen for user authentication
    window.addEventListener('wavelengthUserLoaded', checkPagePermission);

    // Fallback: redirect if permission not verified after 3 seconds
    setTimeout(() => {
        if (!permissionVerified) {
            alert('Please sign in via the Forum to access this page.');
            window.location.href = '/forum';
        }
    }, 3000);
    </script>
</body>
</html>
