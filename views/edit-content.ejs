    // Link prompt to this content
    async function linkPrompt(promptId) {
        try {
            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            const response = await fetch(`/api/prompts/${promptId}/link`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${idToken}`
                },
                body: JSON.stringify({
                    contentType: contentType,
                    contentId: contentId
                })
            });

            if (response.ok) {
                console.log('✅ Prompt linked successfully');
                await loadPrompts(); // Reload to update UI
                document.getElementById('promptSearch').value = '';
                document.getElementById('promptSearchResults').innerHTML = '';
            } else {
                const error = await response.json();
                alert('Failed to link prompt: ' + error.message);
            }
        } catch (error) {
            console.error('Error linking prompt:', error);
            alert('Error linking prompt');
        }
    }

    // Unlink prompt from this content
    async function unlinkPrompt(promptId) {
        if (!confirm('Remove this prompt link?')) return;

        try {
            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            const response = await fetch(`/api/prompts/${promptId}/unlink`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${idToken}`
                },
                body: JSON.stringify({
                    contentType: contentType,
                    contentId: contentId
                })
            });

            if (response.ok) {
                console.log('✅ Prompt unlinked successfully');
                await loadPrompts(); // Reload to update UI
            } else {
                const error = await response.json();
                alert('Failed to unlink prompt: ' + error.message);
            }
        } catch (error) {
            console.error('Error unlinking prompt:', error);
            alert('Error unlinking prompt');
        }
    }

