    // Search prompts
    function searchPrompts(query) {
        const searchResults = document.getElementById('promptSearchResults');

        if (!query || query.length < 2) {
            searchResults.innerHTML = '';
            return;
        }

        const results = allPrompts.filter(p => {
            const searchText = (p.title + ' ' + p.keywords.join(' ') + ' ' + p.tags.join(' ')).toLowerCase();
            return searchText.includes(query.toLowerCase()) && !linkedPrompts.find(lp => lp.id === p.id);
        });

        if (results.length === 0) {
            searchResults.innerHTML = '<div style="padding: 10px; color: #999;">No prompts found</div>';
            return;
        }

        searchResults.innerHTML = results.slice(0, 10).map(prompt => `
            <div class="search-result-card" onclick="linkPrompt('${prompt.id}')">
                <div class="prompt-title">${prompt.title}</div>
                <div class="prompt-meta">
                    <span class="prompt-tag">${prompt.category}</span>
                    ${prompt.tags.slice(0, 3).map(tag => `<span class="prompt-tag">${tag}</span>`).join('')}
                </div>
            </div>
        `).join('');
    }

    // Show all prompts
    function showAllPrompts() {
        const searchResults = document.getElementById('promptSearchResults');
        const unlinked = allPrompts.filter(p => !linkedPrompts.find(lp => lp.id === p.id));

        searchResults.innerHTML = unlinked.slice(0, 20).map(prompt => `
