    <%- include('partials/footer') %>

    <!-- Lightbox Component -->
    <script src="/js/lightbox.js"></script>

    <script>
    // Store original data and Firebase path
    const contentType = '<%= contentType %>';
    const firebasePath = '<%= firebasePath %>';
    const contentId = '<%= contentId %>';

    // Keyword management
    function addKeyword(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            const input = event.target;
            const keyword = input.value.trim();

            if (keyword) {
                const tag = document.createElement('span');
                tag.className = 'keyword-tag';
                tag.innerHTML = `${keyword} <span class="keyword-remove" onclick="removeKeyword(this)">×</span>`;

                input.parentElement.insertBefore(tag, input);
                input.value = '';
            }
        }
    }

    function removeKeyword(element) {
        element.parentElement.remove();
    }

    function getKeywords() {
        const container = document.getElementById('keywordsContainer');
        const tags = container.querySelectorAll('.keyword-tag');
        return Array.from(tags).map(tag => tag.textContent.trim().replace('×', '').trim());
    }

    // Array management functions
    function removeArrayItem(button) {
        button.parentElement.remove();
    }

    function addCarouselImage() {
        const container = document.getElementById('carouselImagesContainer');
        const div = document.createElement('div');
        div.className = 'array-list-item';
        div.innerHTML = `
            <div class="no-image">No image</div>
            <input type="text" class="form-input" placeholder="Enter image URL" data-array="carouselImages" onchange="updateImagePreview(this)">
            <button type="button" class="btn btn-danger btn-small" onclick="removeArrayItem(this)">Remove</button>
        `;
        container.appendChild(div);
    }

    function addImageGalleryItem() {
        const container = document.getElementById('imageGalleryContainer');
        const div = document.createElement('div');
        div.className = 'array-list-item';
        div.innerHTML = `
            <input type="checkbox" class="gallery-checkbox" data-image-url="" onchange="updateSelectedCount()" style="width: 20px; height: 20px; cursor: pointer;">
            <div class="no-image">No image</div>
            <input type="text" class="form-input" placeholder="Enter image URL" data-array="image_gallery" onchange="updateGalleryImagePreview(this)">
            <button type="button" class="btn btn-danger btn-small" onclick="removeArrayItem(this)">Remove</button>
        `;
        container.appendChild(div);
    }

    // ===========================
    // MEDIA UPLOAD
    // ===========================
    
    async function handleMediaUpload(event) {
        const file = event.target.files[0];
        if (!file) return;
        
        const uploadStatus = document.getElementById('uploadStatus');
        const isVideo = file.type.startsWith('video/');
        const fileType = isVideo ? 'video' : 'image';
        
        // Validate file size (100MB max)
        const maxSize = 100 * 1024 * 1024; // 100MB
        if (file.size > maxSize) {
            alert(`File is too large. Maximum size is 100MB. Your file is ${(file.size / 1024 / 1024).toFixed(2)}MB`);
            event.target.value = ''; // Clear the input
            return;
        }
        
        // Validate file type
        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp', 
                            'video/mp4', 'video/mov', 'video/avi', 'video/webm'];
        if (!allowedTypes.includes(file.type)) {
            alert('Invalid file type. Please upload an image (jpeg, png, gif, webp) or video (mp4, mov, avi, webm).');
            event.target.value = '';
            return;
        }
        
        uploadStatus.textContent = `Uploading ${fileType} (${(file.size / 1024 / 1024).toFixed(2)}MB)...`;
        uploadStatus.style.color = '#667eea';
        
        try {
            // Create FormData
            const formData = new FormData();
            formData.append('file', file);
            formData.append('contentType', contentType);
            formData.append('contentId', contentId);
            
            console.log(`📤 Uploading ${fileType}:`, file.name, `(${(file.size / 1024 / 1024).toFixed(2)}MB)`);
            
            // Upload to server
            const response = await fetch('/api/upload/media', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (!result.success) {
                throw new Error(result.error || 'Upload failed');
            }
            
            console.log(`✅ ${fileType} uploaded successfully:`, result.url);
            console.log(`   Relative path for storage:`, result.relativePath);
            
            // Add the uploaded media to the gallery
            const container = document.getElementById('imageGalleryContainer');
            const div = document.createElement('div');
            div.className = 'array-list-item';
            
            // Use full URL for display (src, data-image-url) but relative path for storage (input value)
            const displayUrl = result.url;
            const storageValue = result.relativePath || result.url; // Fallback to full URL if relativePath not available
            
            if (isVideo) {
                // For videos, show a video preview
                div.innerHTML = `
                    <input type="checkbox" class="gallery-checkbox" data-image-url="${displayUrl}" onchange="updateSelectedCount()" style="width: 20px; height: 20px; cursor: pointer;">
                    <video src="${displayUrl}" 
                           class="image-preview"
                           controls
                           style="max-width: 150px; max-height: 100px; cursor: pointer;"
                           title="Click to view full size"
                           onclick="openLightbox('${displayUrl}', 'Uploaded Video')">
                    </video>
                    <input type="text" class="form-input" value="${storageValue}" data-array="image_gallery" onchange="updateGalleryImagePreview(this)">
                    <button type="button" class="btn btn-danger btn-small" onclick="removeArrayItem(this)">Remove</button>
                `;
            } else {
                // For images, show an image preview
                div.innerHTML = `
                    <input type="checkbox" class="gallery-checkbox" data-image-url="${displayUrl}" onchange="updateSelectedCount()" style="width: 20px; height: 20px; cursor: pointer;">
                    <img src="${displayUrl}" 
                         alt="Uploaded image"
                         class="image-preview"
                         onclick="openLightbox('${displayUrl}', 'Uploaded Image')"
                         onerror="this.className='no-image'; this.alt='Failed to load';"
                         title="Click to view full size">
                    <input type="text" class="form-input" value="${storageValue}" data-array="image_gallery" onchange="updateGalleryImagePreview(this)">
                    <button type="button" class="btn btn-danger btn-small" onclick="removeArrayItem(this)">Remove</button>
                `;
            }
            
            container.appendChild(div);
            
            uploadStatus.textContent = `✅ ${fileType} uploaded successfully!`;
            uploadStatus.style.color = '#4CAF50';
            
            // Clear status after 3 seconds
            setTimeout(() => {
                uploadStatus.textContent = '';
            }, 3000);
            
            // Clear the file input
            event.target.value = '';
            
        } catch (error) {
            console.error('❌ Upload error:', error);
            uploadStatus.textContent = `❌ Upload failed: ${error.message}`;
            uploadStatus.style.color = '#f44336';
            event.target.value = '';
        }
    }

    // ===========================
    // BULK IMAGE DOWNLOAD
    // ===========================
    // Note: Lightbox functions (openLightbox, closeLightbox) are loaded from lightbox.js

    // Update selected count display
    function updateSelectedCount() {
        const checkboxes = document.querySelectorAll('.gallery-checkbox:checked');
        document.getElementById('selectedCount').textContent = checkboxes.length;
    }

    // Select all gallery images
    function selectAllGalleryImages() {
        const checkboxes = document.querySelectorAll('.gallery-checkbox');
        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
        
        checkboxes.forEach(cb => {
            cb.checked = !allChecked;
        });
        
        updateSelectedCount();
    }

    // Download selected images as ZIP (using server proxy to avoid CORS)
    async function downloadSelectedImages() {
        const checkboxes = document.querySelectorAll('.gallery-checkbox:checked');
        
        if (checkboxes.length === 0) {
            alert('Please select at least one image to download');
            return;
        }

        const downloadBtn = document.getElementById('downloadBtn');
        const originalText = downloadBtn.innerHTML;
        
        downloadBtn.disabled = true;
        downloadBtn.innerHTML = '⏳ Preparing download...';

        try {
            // Get selected image URLs
            const imageUrls = Array.from(checkboxes).map(cb => cb.dataset.imageUrl).filter(url => url);

            if (imageUrls.length === 0) {
                alert('No valid image URLs selected');
                downloadBtn.innerHTML = originalText;
                downloadBtn.disabled = false;
                return;
            }

            downloadBtn.innerHTML = `⏳ Downloading ${imageUrls.length} image(s) from server...`;

            // Use server proxy to download images (avoids CORS issues)
            const response = await fetch('/api/download/images', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    imageUrls: imageUrls,
                    filename: `${contentType}-${contentId}-gallery-${Date.now()}.zip`
                })
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Download failed');
            }

            // Get the ZIP file as blob
            const blob = await response.blob();

            // Trigger download
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `${contentType}-${contentId}-gallery-${Date.now()}.zip`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);

            downloadBtn.innerHTML = '✅ Downloaded!';
            setTimeout(() => {
                downloadBtn.innerHTML = originalText;
                downloadBtn.disabled = false;
            }, 2000);

        } catch (error) {
            console.error('Error downloading images:', error);
            alert('Failed to download images: ' + error.message);
            downloadBtn.innerHTML = originalText;
            downloadBtn.disabled = false;
        }
    }

    // VIDEO GENERATION FROM IMAGE
    let selectedVideoImageUrl = null;

    async function generateVideoFromImage() {
        const checkboxes = document.querySelectorAll('.gallery-checkbox:checked');
        
        console.log('🎬 generateVideoFromImage called, found', checkboxes.length, 'checked boxes');
        
        if (checkboxes.length === 0) {
            alert('Please select one image to generate a video from');
            return;
        }

        if (checkboxes.length > 1) {
            alert('Please select only one image for video generation');
            return;
        }

        const imageUrl = checkboxes[0].dataset.imageUrl;
        console.log('🎬 Image URL from checkbox:', imageUrl);
        
        if (!imageUrl) {
            alert('No valid image URL selected');
            return;
        }

        // Store the selected image URL
        selectedVideoImageUrl = imageUrl;
        console.log('🎬 Stored selectedVideoImageUrl:', selectedVideoImageUrl);

        // Show the image preview in modal
        document.getElementById('videoGenImagePreview').src = imageUrl;

        // Load prompts into dropdown
        await loadVideoGenPrompts();

        // Reset form
        document.getElementById('videoGenPromptSelect').value = '';
        document.getElementById('videoGenMotion').value = '';
        updateVideoPromptPreview();

        // Open modal
        document.getElementById('videoGenModal').classList.add('active');
    }

    async function loadVideoGenPrompts() {
        try {
            const response = await fetch('/api/prompts');
            if (!response.ok) throw new Error('Failed to load prompts');
            
            const result = await response.json();
            const prompts = result.data || [];
            const select = document.getElementById('videoGenPromptSelect');
            
            // Clear existing options except first one
            while (select.options.length > 1) {
                select.remove(1);
            }

            // Add prompts as options
            prompts.forEach(prompt => {
                const option = document.createElement('option');
                option.value = prompt.id;
                option.textContent = prompt.title;
                option.dataset.content = prompt.content;
                select.appendChild(option);
            });
        } catch (error) {
            console.error('Error loading prompts:', error);
        }
    }

    function updateVideoPromptPreview() {
        const select = document.getElementById('videoGenPromptSelect');
        const promptPreview = document.getElementById('videoPromptPreview');
        const motionInput = document.getElementById('videoGenMotion');
        const fullPromptDiv = document.getElementById('videoFullPrompt');

        const selectedOption = select.options[select.selectedIndex];
        const promptContent = selectedOption.dataset.content || '';
        const motionGuidance = motionInput.value.trim();

        // Update prompt preview
        if (promptContent) {
            promptPreview.textContent = promptContent;
            promptPreview.style.fontStyle = 'normal';
            promptPreview.style.color = '#333';
        } else {
            promptPreview.textContent = 'No prompt selected';
            promptPreview.style.fontStyle = 'italic';
            promptPreview.style.color = '#666';
        }

        // Update full combined prompt
        let fullPrompt = '';
        if (promptContent && motionGuidance) {
            fullPrompt = `${promptContent}. ${motionGuidance}`;
        } else if (promptContent) {
            fullPrompt = promptContent;
        } else if (motionGuidance) {
            fullPrompt = motionGuidance;
        } else {
            fullPrompt = 'Enter motion guidance above';
        }

        fullPromptDiv.textContent = fullPrompt;
        fullPromptDiv.style.color = (promptContent || motionGuidance) ? '#333' : '#999';
    }

    function closeVideoGenModal() {
        document.getElementById('videoGenModal').classList.remove('active');
        selectedVideoImageUrl = null;
    }

    async function startVideoGeneration() {
        console.log('🎬 startVideoGeneration called, selectedVideoImageUrl:', selectedVideoImageUrl);
        
        const motionInput = document.getElementById('videoGenMotion');
        const select = document.getElementById('videoGenPromptSelect');
        
        // Check if we have an image selected and save it BEFORE closing modal
        if (!selectedVideoImageUrl) {
            console.error('❌ No selectedVideoImageUrl! This should have been set by generateVideoFromImage');
            alert('No image selected. Please close this modal and select an image first.');
            return;
        }
        
        // Save the image URL before closing modal (which resets it)
        const imageUrlToUse = selectedVideoImageUrl;
        
        const selectedOption = select.options[select.selectedIndex];
        const promptContent = selectedOption.dataset.content || '';
        const motionGuidance = motionInput.value.trim();

        if (!motionGuidance && !promptContent) {
            alert('Please enter camera motion guidance or select a prompt');
            return;
        }

        // Combine prompt and motion
        let fullPrompt = '';
        if (promptContent && motionGuidance) {
            fullPrompt = `${promptContent}. ${motionGuidance}`;
        } else if (promptContent) {
            fullPrompt = promptContent;
        } else {
            fullPrompt = motionGuidance;
        }

        console.log('🎬 Full video prompt:', fullPrompt);

        // Close modal (this will reset selectedVideoImageUrl, but we saved it above)
        closeVideoGenModal();

        const videoGenBtn = document.getElementById('videoGenBtn');
        const originalText = videoGenBtn.innerHTML;
        
        videoGenBtn.disabled = true;
        videoGenBtn.innerHTML = '⏳ Starting Veo 3.1 generation...';

        try {
            // Convert relative URL to absolute if needed
            let fullImageUrl = imageUrlToUse;
            console.log('🎬 Before conversion - imageUrlToUse:', imageUrlToUse);
            console.log('🎬 window.location.origin:', window.location.origin);
            
            if (fullImageUrl && fullImageUrl.startsWith('/')) {
                fullImageUrl = window.location.origin + fullImageUrl;
                console.log('🎬 After conversion - fullImageUrl:', fullImageUrl);
            }

            console.log('🎬 Starting Veo 3.1 video generation from:', fullImageUrl);

            // Start video generation with Google Veo 3.1
            const response = await fetch('/api/generate/video', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    imageUrl: fullImageUrl,
                    prompt: fullPrompt,
                    contentType: contentType,
                    contentId: contentId
                })
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Video generation failed');
            }

            const result = await response.json();
            console.log('✅ Video generation started:', result.operationId);

            videoGenBtn.innerHTML = '⏳ Generating video with Veo 3.1 (2-5 minutes)...';

            // Poll for completion
            await pollVideoGeneration(result.operationId, videoGenBtn, originalText);

        } catch (error) {
            console.error('Error generating video:', error);
            alert('Failed to generate video: ' + error.message);
            videoGenBtn.innerHTML = originalText;
            videoGenBtn.disabled = false;
        }
    }

    // Add event listener for motion input to update preview
    document.addEventListener('DOMContentLoaded', function() {
        const motionInput = document.getElementById('videoGenMotion');
        if (motionInput) {
            motionInput.addEventListener('input', updateVideoPromptPreview);
        }
    });

    // Poll for video generation completion
    async function pollVideoGeneration(operationId, button, originalText) {
        const maxAttempts = 60; // 5 minutes with 5-second intervals
        let attempts = 0;

        const pollInterval = setInterval(async () => {
            attempts++;

            try {
                // URL-encode the operation ID since it contains slashes
                const encodedOperationId = encodeURIComponent(operationId);
                const response = await fetch(`/api/generate/video/status/${encodedOperationId}`);
                
                if (!response.ok) {
                    throw new Error('Failed to check video status');
                }

                const result = await response.json();

                if (result.status === 'succeeded') {
                    clearInterval(pollInterval);
                    
                    button.innerHTML = '💾 Downloading video...';
                    
                    // Download the video
                    try {
                        const downloadResponse = await fetch(`/api/generate/video/download/${encodedOperationId}`, {
                            method: 'POST'
                        });
                        
                        if (!downloadResponse.ok) {
                            throw new Error('Failed to download video');
                        }
                        
                        // Get the video as blob
                        const blob = await downloadResponse.blob();
                        
                        // Trigger download
                        const link = document.createElement('a');
                        link.href = URL.createObjectURL(blob);
                        link.download = `veo-video-${Date.now()}.mp4`;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        URL.revokeObjectURL(link.href);
                        
                        button.innerHTML = '✅ Video generated and downloaded!';
                        
                        setTimeout(() => {
                            button.innerHTML = originalText;
                            button.disabled = false;
                        }, 3000);
                        
                    } catch (downloadError) {
                        console.error('Download error:', downloadError);
                        alert('Video generated but download failed: ' + downloadError.message);
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }
                    
                } else if (result.status === 'failed') {
                    clearInterval(pollInterval);
                    alert('Video generation failed: ' + (result.error || 'Unknown error'));
                    button.innerHTML = originalText;
                    button.disabled = false;
                    
                } else {
                    // Still processing
                    const elapsed = Math.floor((attempts * 5) / 60);
                    button.innerHTML = `⏳ Generating with Veo 3.1... (${elapsed}m ${(attempts * 5) % 60}s)`;
                }

                // Timeout after max attempts
                if (attempts >= maxAttempts) {
                    clearInterval(pollInterval);
                    alert('Video generation is taking longer than expected. Please check back later.');
                    button.innerHTML = originalText;
                    button.disabled = false;
                }

            } catch (error) {
                console.error('Error polling video status:', error);
                clearInterval(pollInterval);
                alert('Error checking video status: ' + error.message);
                button.innerHTML = originalText;
                button.disabled = false;
            }

        }, 5000); // Poll every 5 seconds
    }

    // Update image preview when URL changes
    function updateImagePreview(input) {
        const url = input.value.trim();
        const parent = input.parentElement;
        let preview = parent.querySelector('.image-preview, .no-image');

        if (url) {
            if (preview.classList.contains('no-image')) {
                // Replace no-image div with actual image
                const img = document.createElement('img');
                img.className = 'image-preview';
                img.src = url;
                img.title = 'Click to zoom';
                img.onerror = function() {
                    this.className = 'no-image';
                    this.alt = 'Failed to load';
                };
                parent.replaceChild(img, preview);
            } else {
                // Update existing image
                preview.src = url;
            }
        }
    }

    // Update gallery image preview and checkbox data-image-url
    function updateGalleryImagePreview(input) {
        const url = input.value.trim();
        const parent = input.parentElement;
        
        // Find the checkbox and update its data-image-url
        const checkbox = parent.querySelector('.gallery-checkbox');
        if (checkbox) {
            checkbox.dataset.imageUrl = url;
        }
        
        // Find and update the image preview
        let preview = parent.querySelector('.image-preview, .no-image');
        
        if (url) {
            if (preview && preview.classList.contains('no-image')) {
                // Replace no-image div with actual image
                const img = document.createElement('img');
                img.className = 'image-preview';
                img.src = url;
                img.title = 'Click to view full size';
                img.onclick = function() { openLightbox(url, 'Gallery Image'); };
                img.onerror = function() {
                    this.className = 'no-image';
                    this.alt = 'Failed to load';
                };
                parent.replaceChild(img, preview);
            } else if (preview) {
                // Update existing image
                preview.src = url;
                preview.onclick = function() { openLightbox(url, 'Gallery Image'); };
            }
        }
    }

    // Update main image preview
    function updateMainImagePreview() {
        const input = document.getElementById('image');
        const preview = document.getElementById('mainImagePreview');
        const url = input.value.trim();

        if (url) {
            preview.src = url;
            preview.style.display = 'block';
            preview.onerror = function() {
                this.style.display = 'none';
            };
        } else {
            preview.style.display = 'none';
        }
    }

    function getArrayValues(arrayName) {
        const inputs = document.querySelectorAll(`input[data-array="${arrayName}"]`);
        const cdnUrl = '<%= cdnUrl %>';
        
        return Array.from(inputs)
            .map(input => {
                let value = input.value.trim();
                // Strip CDN URL prefix if present to store only relative paths
                if (value.startsWith(cdnUrl + '/')) {
                    value = value.substring(cdnUrl.length + 1);
                }
                // Also handle cloudfront URLs
                if (value.includes('.cloudfront.net/')) {
                    const cloudfrontMatch = value.match(/\.cloudfront\.net\/(.+)$/);
                    if (cloudfrontMatch) {
                        value = cloudfrontMatch[1];
                    }
                }
                // Also handle direct S3 URLs
                if (value.includes('.s3.') && value.includes('.amazonaws.com/')) {
                    const s3Match = value.match(/\.amazonaws\.com\/(.+)$/);
                    if (s3Match) {
                        value = s3Match[1];
                    }
                }
                return value;
            })
            .filter(val => val !== '');
    }

