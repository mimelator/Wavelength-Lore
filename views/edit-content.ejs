    // Toggle visibility function
    async function toggleVisibility() {
        const toggleBtn = document.getElementById('toggleVisibilityBtn');
        const visibilityBadge = document.getElementById('visibilityBadge');
        const visibilityIcon = document.getElementById('visibilityIcon');
        const visibilityText = document.getElementById('visibilityText');

        // The button has class 'hidden' when content is hidden
        // So if button has 'hidden' class, content is currently hidden (visible=false)
        // If button doesn't have 'hidden' class, content is currently visible (visible=true)
        const currentlyVisible = !toggleBtn.classList.contains('hidden');
        const newVisibility = !currentlyVisible;

        // Disable button during request
        toggleBtn.disabled = true;

        try {
            // Get Firebase ID token for authentication
            if (!window.firebaseAuth || !window.firebaseAuth.currentUser) {
                throw new Error('Please sign in via the Forum first');
            }

            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            // Build the appropriate API endpoint based on content type
            let endpoint;
            <% if (typeof seasonNumber !== 'undefined' && typeof episodeNumber !== 'undefined') { %>
            endpoint = `/api/content/episode/<%= seasonNumber %>/<%= episodeNumber %>/visibility`;
            <% } else { %>
            endpoint = `/api/content/${contentType}/${contentId}/visibility`;
            <% } %>

            // Send visibility toggle request
            const response = await fetch(endpoint, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${idToken}`
                },
                body: JSON.stringify({
                    visible: newVisibility
                })
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Failed to update visibility');
            }

            const result = await response.json();

            // Update UI to reflect new visibility state
            if (newVisibility) {
                // Now visible
                toggleBtn.classList.remove('hidden');
                visibilityIcon.textContent = '🔓';
                visibilityText.textContent = 'Hide Content';
                visibilityBadge.className = 'visibility-badge visible';
                visibilityBadge.textContent = '👁️ VISIBLE';
            } else {
                // Now hidden
                toggleBtn.classList.add('hidden');
                visibilityIcon.textContent = '🔒';
                visibilityText.textContent = 'Reveal Content';
                visibilityBadge.className = 'visibility-badge hidden';
                visibilityBadge.textContent = '🔒 HIDDEN';
            }

            // Show temporary success message
            const saveStatus = document.getElementById('saveStatus');
            saveStatus.className = 'save-status success';
            saveStatus.textContent = result.message;
            setTimeout(() => {
                saveStatus.style.display = 'none';
            }, 3000);

        } catch (error) {
            console.error('Error toggling visibility:', error);
            alert('Error: ' + error.message);
        } finally {
            toggleBtn.disabled = false;
        }
    }

    // Save content function
    async function saveContent() {
        const saveBtn = document.getElementById('saveBtn');
        const saveStatus = document.getElementById('saveStatus');

        // Show saving status
        saveBtn.disabled = true;
        saveStatus.className = 'save-status saving';
        saveStatus.textContent = 'Saving...';

        try {
            // Upload audio file first if one was selected (episodes only)
            let audioUrl = null;
            if (contentType === 'episode' && selectedAudioFile) {
                saveStatus.textContent = 'Uploading audio...';
                audioUrl = await uploadAudioFile();
            }

            // Collect form data
            const formData = {
                title: document.getElementById('title').value.trim(),
                description: document.getElementById('description').value.trim(),
                keywords: getKeywords(),
                image: document.getElementById('image').value.trim()
            };

            // Add type-specific fields
            if (contentType === 'episode') {
                formData.summary = document.getElementById('summary')?.value.trim() || '';
                formData.lyrics = document.getElementById('lyrics')?.value.trim() || '';
                // Use new uploaded audio URL if available, otherwise keep existing
                <% if (typeof contentData !== 'undefined') { %>
                const existingAudio = '<%= contentData.audioUrl || contentData.audio || '' %>';
                formData.audio = audioUrl || existingAudio;
                console.log('🎵 Audio URL being saved:', formData.audio, '(uploaded:', audioUrl, ', existing:', existingAudio, ')');
                <% } else { %>
                formData.audio = audioUrl || '';
