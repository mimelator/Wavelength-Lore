    // Save edited prompt content
    async function savePromptContent() {
        if (!currentPromptForGeneration) {
            alert('No prompt loaded');
            return;
        }

        const newContent = document.getElementById('editablePromptContent').value.trim();
        
        if (!newContent) {
            alert('Prompt content cannot be empty');
            return;
        }

        const saveBtn = document.getElementById('savePromptBtn');
        const statusEl = document.getElementById('promptSaveStatus');

        saveBtn.disabled = true;
        saveBtn.innerHTML = '⏳ Saving...';
        statusEl.style.display = 'inline-block';
        statusEl.className = 'save-status saving';
        statusEl.textContent = '⏳ Saving prompt...';

        try {
            const idToken = await window.firebaseAuth.currentUser.getIdToken();

            const response = await fetch(`/api/prompts/${currentPromptForGeneration.id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${idToken}`
                },
                body: JSON.stringify({
                    content: newContent,
                    // Keep other fields the same
                    title: currentPromptForGeneration.title,
                    category: currentPromptForGeneration.category,
                    keywords: currentPromptForGeneration.keywords,
                    tags: currentPromptForGeneration.tags
                })
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Save failed');
            }

            const result = await response.json();

            // Update the stored prompt
            currentPromptForGeneration.content = newContent;

            // Update in the allPrompts array
            const promptIndex = allPrompts.findIndex(p => p.id === currentPromptForGeneration.id);
            if (promptIndex !== -1) {
                allPrompts[promptIndex].content = newContent;
            }

            statusEl.className = 'save-status success';
            statusEl.textContent = '✅ Prompt saved successfully!';
            saveBtn.style.display = 'none';
            saveBtn.innerHTML = '💾 Save Changes';

            console.log('✅ Prompt content updated successfully');

        } catch (error) {
            console.error('Error saving prompt:', error);
            statusEl.className = 'save-status error';
            statusEl.textContent = `❌ Error: ${error.message}`;
        } finally {
            saveBtn.disabled = false;
        }
    }

