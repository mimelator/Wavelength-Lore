        try {
            const linkField = contentType === 'episode' ? 'linkedEpisodes' :
                            contentType === 'character' ? 'linkedCharacters' :
                            'linkedLore';

            linkedPrompts = allPrompts.filter(p =>
                p[linkField] && p[linkField].includes(contentId)
