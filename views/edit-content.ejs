                <% } %>
                formData.youtubeLink = document.getElementById('youtubeLink')?.value.trim() || '';
                formData.carouselImages = getArrayValues('carouselImages');
            } else if (contentType === 'character' || contentType === 'lore') {
                formData.image_gallery = getArrayValues('image_gallery');
