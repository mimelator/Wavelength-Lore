<!-- Gallery Scripts -->
<!-- The version variable is now properly provided by middleware.js -->
<script src="<%= cdnUrl || '' %>/static/js/components/gallery/gallery.js?v=<%= typeof version !== 'undefined' ? version : Date.now() %>"></script>
<script src="<%= cdnUrl || '' %>/static/js/components/gallery/user-gallery.js?v=<%= typeof version !== 'undefined' ? version : Date.now() %>"></script>
<script src="<%= cdnUrl || '' %>/static/js/components/gallery/image-capturer.js?v=<%= typeof version !== 'undefined' ? version : Date.now() %>"></script>
<script src="<%= cdnUrl || '' %>/static/js/components/gallery/image-capturer-init.js?v=<%= typeof version !== 'undefined' ? version : Date.now() %>"></script>
<link rel="stylesheet" href="<%= cdnUrl || '' %>/static/css/gallery/gallery.css?v=<%= typeof version !== 'undefined' ? version : Date.now() %>">

<!-- Add link to My Gallery in navigation -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Find the user menu if it exists
    const userMenu = document.querySelector('.user-menu, .navbar-user');
    
    if (userMenu) {
      // Create gallery link
      const galleryLink = document.createElement('a');
      galleryLink.href = '/my-gallery';
      galleryLink.textContent = 'My Gallery';
      galleryLink.className = 'nav-link';
      
      // Add to menu
      userMenu.appendChild(galleryLink);
    }
  });
</script>