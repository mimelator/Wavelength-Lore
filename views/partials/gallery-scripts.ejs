<!-- Gallery Activation Script -->
<script src="/static/js/components/gallery/image-capturer.js"></script>
<script src="/static/js/components/gallery/image-capturer-init.js"></script>

<!-- Add link to My Gallery in navigation -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Find the user menu if it exists
    const userMenu = document.querySelector('.user-menu, .navbar-user');
    
    if (userMenu) {
      // Create gallery link
      const galleryLink = document.createElement('a');
      galleryLink.href = '/my-gallery';
      galleryLink.textContent = 'My Gallery';
      galleryLink.className = 'nav-link';
      
      // Add to menu
      userMenu.appendChild(galleryLink);
    }
  });
</script>