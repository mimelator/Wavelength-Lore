<%- include('banner') %>
<header>
  <nav>
    <ul style="list-style: none; margin: 0; padding: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: 0;">
      <li style="margin: 0 10px;"><a href="/" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">Home</a></li>
      <li style="margin: 0 10px;"><a href="/forum" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">💬 Forum</a></li>
      <li style="margin: 0 10px;"><a href="/leaderboard" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">🏆 Leaderboard</a></li>
      <li style="margin: 0 10px;"><a href="/forum/profile" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">👤 My Profile</a></li>
      <li style="margin: 0 10px;"><a href="/radio" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">📻 Radio</a></li>
      <li style="margin: 0 10px;"><a href="/search" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">🔍 Search</a></li>
      <li id="content-creator-nav-item" style="margin: 0 10px; display: none;"><a href="/create" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">✨ Create</a></li>
      <li id="admin-nav-item" style="margin: 0 10px; display: none;"><a href="/forum/admin" style="color: #fff; text-decoration: none; font-size: 16px; font-weight: 500; font-family: 'AnimeAce', Arial, sans-serif;">⚙️ Admin</a></li>
    </ul>
  </nav>
</header>
<script>
  // Show privileged links when user is authenticated
  if (typeof window !== 'undefined') {
    window.wavelengthUserGroups = null;

    const checkAdminStatus = async () => {
      try {
        if (window.firebaseAuth && window.firebaseUtils) {
          window.firebaseUtils.onAuthStateChanged(window.firebaseAuth, async (user) => {
            if (user) {
              try {
                const idToken = await user.getIdToken();

                const response = await fetch('/api/user/admin-status', {
                  headers: {
                    'Authorization': `Bearer ${idToken}`
                  }
                });

                if (response.ok) {
                  const data = await response.json();
                  window.wavelengthUserGroups = data.groups || [];

                  // Show admin link if user is admin
                  if (data.isAdmin) {
                    const adminItem = document.getElementById('admin-nav-item');
                    if (adminItem) adminItem.style.display = 'block';
                  }

                  // Show create content link if user is content_manager or higher
                  const hasContentAccess = data.groups && (
                    data.groups.includes('content_manager') ||
                    data.groups.includes('admin') ||
                    data.groups.includes('super_admin')
                  );
                  if (hasContentAccess) {
                    const createItem = document.getElementById('content-creator-nav-item');
                    if (createItem) createItem.style.display = 'block';
                  }

                  window.dispatchEvent(new CustomEvent('wavelengthUserLoaded', { detail: data }));
                }
              } catch (error) {
                console.error('Error checking admin status:', error);
              }
            } else {
              window.wavelengthUserGroups = null;
              window.dispatchEvent(new CustomEvent('wavelengthUserLoaded', { detail: null }));
            }
          });
        } else {
          setTimeout(checkAdminStatus, 500);
        }
      } catch (error) {
        console.error('Error setting up admin status check:', error);
      }
    };

    window.checkAdminStatusNow = checkAdminStatus;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAdminStatus);
    } else {
      checkAdminStatus();
    }
  }
</script>
<style>
  header {
    background-color: #333;
    color: #fff;
    padding: 10px 0;
    position: relative;
    z-index: 1000;
  }
  header nav ul li a:hover {
    color: #4fc3f7;
  }
  
  @media (max-width: 768px) {
    header nav ul li {
      margin: 0 6px !important;
    }
    header nav ul li a {
      font-size: 14px !important;
    }
  }
  
  @media (max-width: 480px) {
    header nav ul li {
      margin: 0 4px !important;
    }
    header nav ul li a {
      font-size: 12px !important;
    }
  }
</style>
