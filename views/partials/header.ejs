<script>
  // Show admin link if user is authenticated as admin
  // Also expose user groups globally for content edit links
  if (typeof window !== 'undefined') {
    window.wavelengthUserGroups = null; // Will be populated if user is authenticated

    // Check for Firebase authentication state
    const checkAdminStatus = async () => {
      try {
        // Wait for Firebase to be available
        if (window.firebaseAuth && window.firebaseUtils) {
          console.log('🔥 Firebase available, checking auth state...');
          
          // Prevent duplicate auth listeners
          if (window.wavelengthAuthListenerActive) {
            console.log('⚠️ Auth listener already active, skipping duplicate');
            return;
          }
          window.wavelengthAuthListenerActive = true;
          
          window.firebaseUtils.onAuthStateChanged(window.firebaseAuth, async (user) => {
            if (user) {
              try {
                console.log('👤 User authenticated, fetching groups...');
                // Get ID token to check admin status
                const idToken = await user.getIdToken();

                // Check admin status via API
                const response = await fetch('/api/user/admin-status', {
                  headers: {
                    'Authorization': `Bearer ${idToken}`
                  }
                });

                if (response.ok) {
                  const data = await response.json();
                  console.log('✅ User groups loaded:', data.groups);

                  // Expose user groups globally
                  window.wavelengthUserGroups = data.groups || [];

                  // Show leaderboard, profile, and gallery links for all authenticated users
                  const leaderboardDropdownItem = document.getElementById('leaderboard-dropdown-item');
                  if (leaderboardDropdownItem) {
                    leaderboardDropdownItem.style.display = 'block';
                  }

                  const profileDropdownItem = document.getElementById('profile-dropdown-item');
                  if (profileDropdownItem) {
                    profileDropdownItem.style.display = 'block';
                  }

                  // Show gallery as a direct nav item (prominent access)
                  const galleryNavItem = document.getElementById('gallery-nav-item');
                  if (galleryNavItem) {
                    galleryNavItem.style.display = 'block';
                  }

                  // Show admin link if user is admin
                  if (data.isAdmin) {
                    document.getElementById('admin-nav-item').style.display = 'block';
                  }

                  // Show games link if user is VIP or higher
                  const hasGameAccess = data.groups && (
                    data.groups.includes('vip') ||
                    data.groups.includes('content_manager') ||
                    data.groups.includes('admin') ||
                    data.groups.includes('super_admin')
                  );
                  if (hasGameAccess) {
                    const gamesNavItem = document.getElementById('games-nav-item');
                    if (gamesNavItem) {
                      gamesNavItem.style.display = 'block';
                    }
                    
                    // Show merchandise store link for VIP members
                    const merchandiseNavItem = document.getElementById('merchandise-nav-item');
                    if (merchandiseNavItem) {
                      merchandiseNavItem.style.display = 'block';
                    }
                    
                    // Show VIP AI Assistant floating icon for same access levels as games
                    // AI Assistant disabled by default (Issue #113) - only enable if explicitly set to true
                    const aiAssistantIcon = document.getElementById('ai-assistant-icon');
                    const aiAssistantEnabled = '<%= process.env.ENABLE_AI_ASSISTANT === "true" ? "true" : "false" %>' === 'true';
                    if (aiAssistantIcon && aiAssistantEnabled) {
                      aiAssistantIcon.style.display = 'block';
                    }
                  }

                  // Trigger custom event for other scripts to listen to
                  window.dispatchEvent(new CustomEvent('wavelengthUserLoaded', { detail: data }));
                } else {
                  console.warn('⚠️ Failed to fetch admin status:', response.status);
                }
              } catch (error) {
                console.error('❌ Error checking admin status:', error);
              }
            } else {
              // User not authenticated - hide VIP features
              console.log('👤 No user authenticated');
              window.wavelengthUserGroups = null;
              
              // Ensure VIP features are hidden
              const gamesNavItem = document.getElementById('games-nav-item');
              if (gamesNavItem) {
                gamesNavItem.style.display = 'none';
              }
              
              const aiAssistantIcon = document.getElementById('ai-assistant-icon');
              if (aiAssistantIcon) {
                aiAssistantIcon.style.display = 'none';
              }
              
              window.dispatchEvent(new CustomEvent('wavelengthUserLoaded', { detail: null }));
            }
          });
        } else {
          // Firebase not available, use readiness helper if available
          if (window.WavelengthFirebase) {
            console.log('⏳ Waiting for Firebase readiness helper...');
            window.WavelengthFirebase.onReady(checkAdminStatus);
          } else {
            console.log('⏳ Firebase not ready yet, retrying in 500ms...');
            setTimeout(checkAdminStatus, 500);
          }
        }
      } catch (error) {
        console.error('❌ Error setting up admin status check:', error);
      }
    };

    // Expose function globally so footer can trigger it
    window.checkAdminStatusNow = checkAdminStatus;

    // Start checking when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAdminStatus);
    } else {
      checkAdminStatus();
    }

    // Mobile dropdown toggle functionality
    document.addEventListener('DOMContentLoaded', () => {
      const dropdownToggles = document.querySelectorAll('header nav .has-dropdown > a');
      
      dropdownToggles.forEach(toggle => {
        toggle.addEventListener('click', (e) => {
          // Only prevent default and toggle on mobile
          if (window.innerWidth <= 768) {
            e.preventDefault();
            const parent = toggle.parentElement;
            parent.classList.toggle('active');
            
            // Close other dropdowns
            document.querySelectorAll('header nav .has-dropdown').forEach(item => {
              if (item !== parent) {
                item.classList.remove('active');
              }
            });
          }
        });
      });

      // Dynamic dropdown positioning to prevent clipping
      function adjustDropdownPositions() {
        const dropdowns = document.querySelectorAll('header nav .has-dropdown');
        
        dropdowns.forEach(dropdown => {
          const rect = dropdown.getBoundingClientRect();
          const dropdownMenu = dropdown.querySelector('ul.dropdown');
          
          if (dropdownMenu) {
            // Check if dropdown would extend beyond right edge of viewport
            const dropdownWidth = 200; // min-width from CSS
            const rightEdge = rect.left + dropdownWidth;
            const viewportWidth = window.innerWidth;
            
            if (rightEdge > viewportWidth - 20) { // 20px buffer
              // Position dropdown to the right
              dropdownMenu.style.left = 'auto';
              dropdownMenu.style.right = '0';
            } else {
              // Position dropdown to the left (default)
              dropdownMenu.style.left = '0';
              dropdownMenu.style.right = 'auto';
            }
          }
        });
      }
      
      // Adjust positions on load and resize
      adjustDropdownPositions();
      window.addEventListener('resize', adjustDropdownPositions);

      // Hamburger menu functionality
      const menuIcon = document.querySelector('.menu-icon');
      const navLinks = document.querySelector('.nav-links');

      console.log('menuIcon:', menuIcon); // Debug: Check if menuIcon is found
      console.log('navLinks:', navLinks); // Debug: Check if navLinks is found

      if (menuIcon && navLinks) {
      menuIcon.addEventListener('click', () => {
          console.log('Hamburger icon clicked!'); // Debug: Check if click event is firing
        navLinks.classList.toggle('active');
      });
      } else {
        console.warn('menuIcon or navLinks not found!'); // Debug: Warn if elements are missing
  }
    });
  }
</script>
