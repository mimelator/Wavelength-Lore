<!-- Firebase Authentication (API keys are PUBLIC and safe - security is via Firebase Rules) -->
<% if (typeof cdnUrl !== 'undefined') { %>
  <% // In development, use local server to avoid CDN caching issues %>
  <% const scriptUrl = (process.env.NODE_ENV !== 'production') ? '/js/firebase-config.js' : cdnUrl + '/js/firebase-config.js'; %>
<script src="<%= scriptUrl %>?v=<%= Date.now() %>"></script>
<script>
  if (!window.firebaseAuth && !window.firebaseUtils) {
    window.initializeWavelengthFirebase({
      apiKey: "<%= process.env.API_KEY %>",
      authDomain: "<%= process.env.AUTH_DOMAIN %>",
      databaseURL: "<%= process.env.DATABASE_URL %>",
      projectId: "<%= process.env.PROJECT_ID %>",
      storageBucket: "<%= process.env.STORAGE_BUCKET %>",
      messagingSenderId: "<%= process.env.MESSAGING_SENDER_ID %>",
      appId: "<%= process.env.APP_ID %>"
    });
  }
</script>
<% } %>

<!-- Global Radio Game Widget (appears on all pages except /forum/* and /radio) -->
<% if (typeof currentPage !== 'undefined' && !currentPage.startsWith('/forum') && currentPage !== '/radio') { %>
<script src="/js/global-radio-game.js?v=<%= Date.now() %>"></script>

<!-- Full-page collectible overlay -->
<div id="globalGameCanvas" class="global-game-canvas"></div>

<div id="globalRadioGame" class="global-radio-game">
  <div class="radio-game-toggle" id="radioGameToggle" title="Show/Hide Radio Player">
    <span class="toggle-icon">📻</span>
    <span class="toggle-text">Radio Player</span>
  </div>

  <div class="radio-game-widget" id="radioGameWidget">
    <div class="radio-game-header">
      <h3>✨ Wavelength Radio ✨</h3>
      <button class="close-game-btn" id="closeGameBtn" title="Close">✕</button>
    </div>

    <!-- Game Stats (Compact) -->
    <div class="radio-game-stats">
      <div class="game-stat-mini">
        <span class="stat-icon">🍄</span>
        <span class="stat-value" id="globalMushrooms">0</span>
      </div>
      <div class="game-stat-mini">
        <span class="stat-icon">⭐</span>
        <span class="stat-value" id="globalStars">0</span>
      </div>
      <div class="game-stat-mini">
        <span class="stat-icon">🧲</span>
        <span class="stat-value" id="globalHorseshoes">0</span>
      </div>
      <div class="game-stat-mini">
        <span class="stat-icon">✨</span>
        <span class="stat-value" id="globalSparkles">0</span>
      </div>
      <div class="game-stat-mini">
        <span class="stat-icon">💎</span>
        <span class="stat-value" id="globalCrystals">0</span>
      </div>
      <div class="game-stat-mini">
        <span class="stat-icon">🌙</span>
        <span class="stat-value" id="globalMoons">0</span>
      </div>
      <div class="game-stat-mini">
        <span class="stat-icon">👺</span>
        <span class="stat-value" id="globalGoblins">0</span>
      </div>
      <div class="game-stat-mini total-score">
        <span class="stat-icon">🏆</span>
        <span class="stat-value" id="globalTotalScore">0</span>
      </div>
    </div>

    <!-- Mini Radio Player -->
    <div class="mini-radio-player">
      <audio id="globalRadioAudio" preload="metadata"></audio>

      <div class="now-playing">
        <div class="track-info">
          <div class="track-title" id="globalTrackTitle">Click Play to start</div>
          <div class="track-meta" id="globalTrackMeta">Wavelength Radio</div>
        </div>
      </div>

      <div class="player-controls">
        <button class="mini-control-btn" id="globalPrevBtn" title="Previous">⏮</button>
        <button class="mini-control-btn mini-play-btn" id="globalPlayBtn" title="Play">▶</button>
        <button class="mini-control-btn" id="globalNextBtn" title="Next">⏭</button>
      </div>

      <div class="mini-volume-control">
        <span class="volume-icon">🔊</span>
        <input type="range" id="globalVolumeSlider" min="0" max="100" value="80" class="mini-volume-slider">
      </div>

      <div class="visit-radio-link">
        <a href="/radio">🎵 Visit Full Radio Player</a>
      </div>
    </div>
  </div>
</div>
<% } %>

<footer>
  <div class="footer-content">
    <p>&copy; 2025 Wavelength Lore. All rights reserved.</p>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
    <% if (versionInfo) { %>
    <div class="version-info">
      <span class="version-badge" title="Version v<%= versionInfo.version %> | Build #<%= versionInfo.buildNumber %> | Commit <%= versionInfo.commitShort %> | Built <%= new Date(versionInfo.buildDate).toLocaleDateString() %>">
        v<%= versionInfo.version %> (<%= versionInfo.commitShort %>)
      </span>
    </div>
    <% } %>
  </div>
</footer>
<style>
  footer {
    background-color: #333;
    color: #fff;
    padding: 20px 0;
    text-align: center;
  }
  .footer-content nav ul {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    justify-content: center;
    gap: 15px;
  }
  .footer-content nav ul li a {
    color: #fff;
    text-decoration: none;
  }
  .footer-content nav ul li a:hover {
    text-decoration: underline;
  }
  .version-info {
    margin-top: 10px;
    font-size: 0.8em;
    opacity: 0.7;
  }
  .version-badge {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: 12px;
    font-family: 'Courier New', monospace;
    font-size: 0.85em;
    cursor: help;
    transition: opacity 0.2s;
  }
  .version-badge:hover {
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.2);
  }

  /* Global Radio Game Widget */
  .global-radio-game {
    position: fixed;
    bottom: 0;
    right: 20px;
    z-index: 9999;
    transition: all 0.3s ease;
  }

  .radio-game-toggle {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 12px 20px;
    border-radius: 25px 25px 0 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 -4px 15px rgba(102, 126, 234, 0.4);
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .radio-game-toggle:hover {
    transform: translateY(-2px);
    box-shadow: 0 -6px 20px rgba(102, 126, 234, 0.6);
  }

  .radio-game-toggle .toggle-icon {
    font-size: 1.2rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .radio-game-widget {
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.98) 0%, rgba(43, 43, 66, 0.98) 100%);
    backdrop-filter: blur(10px);
    border-radius: 20px 20px 0 0;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.3);
    width: 400px;
    max-height: 500px;
    display: none;
    overflow: hidden;
    border: 2px solid rgba(102, 126, 234, 0.3);
  }

  .radio-game-widget.active {
    display: block;
    animation: slideUp 0.3s ease;
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .radio-game-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .radio-game-header h3 {
    margin: 0;
    color: white;
    font-size: 1.1rem;
  }

  .close-game-btn {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .close-game-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(90deg);
  }

  .radio-game-stats {
    padding: 15px 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    background: rgba(0, 0, 0, 0.2);
  }

  .game-stat-mini {
    display: flex;
    align-items: center;
    gap: 5px;
    background: rgba(102, 126, 234, 0.1);
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid rgba(102, 126, 234, 0.2);
  }

  .game-stat-mini .stat-icon {
    font-size: 1.2rem;
  }

  .game-stat-mini .stat-value {
    color: white;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .game-stat-mini.total-score {
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.2) 0%, rgba(255, 165, 0, 0.2) 100%);
    border: 1px solid rgba(255, 215, 0, 0.4);
    flex: 1 0 100%;
  }

  .game-stat-mini.total-score .stat-value {
    color: #ffd700;
    font-size: 1.1rem;
  }

  /* Full-page game canvas for collectibles */
  .global-game-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9998;
  }

  .global-game-canvas .mystical-element {
    pointer-events: all;
    position: absolute;
    font-size: 2.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 9998;
  }

  /* Mini Radio Player */
  .mini-radio-player {
    padding: 15px 20px;
    background: rgba(0, 0, 0, 0.3);
  }

  .now-playing {
    margin-bottom: 15px;
  }

  .track-info {
    text-align: center;
  }

  .track-title {
    color: white;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-meta {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
  }

  .player-controls {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 15px;
  }

  .mini-control-btn {
    background: rgba(102, 126, 234, 0.3);
    border: 1px solid rgba(102, 126, 234, 0.5);
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .mini-control-btn:hover {
    background: rgba(102, 126, 234, 0.5);
    transform: scale(1.1);
  }

  .mini-play-btn {
    width: 50px;
    height: 50px;
    font-size: 1.2rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  .mini-volume-control {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
  }

  .mini-volume-control .volume-icon {
    font-size: 1.2rem;
  }

  .mini-volume-slider {
    flex: 1;
    height: 5px;
    border-radius: 5px;
    background: rgba(102, 126, 234, 0.3);
    outline: none;
    cursor: pointer;
  }

  .mini-volume-slider::-webkit-slider-thumb {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    cursor: pointer;
  }

  .visit-radio-link {
    text-align: center;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .visit-radio-link a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .visit-radio-link a:hover {
    color: #764ba2;
    text-decoration: underline;
  }

  /* Neon green horseshoe styling */
  .game-stat-mini:nth-child(3) .stat-icon {
    filter: drop-shadow(0 0 6px #00ff00)
            drop-shadow(0 0 12px #39ff14)
            brightness(0) saturate(100%) invert(100%) sepia(100%) saturate(10000%) hue-rotate(90deg);
    animation: neonGreenPulse 2s ease-in-out infinite;
  }

  @keyframes neonGreenPulse {
    0%, 100% { filter: drop-shadow(0 0 6px #00ff00) drop-shadow(0 0 12px #39ff14) brightness(0) saturate(100%) invert(100%) sepia(100%) saturate(10000%) hue-rotate(90deg); }
    50% { filter: drop-shadow(0 0 10px #00ff00) drop-shadow(0 0 20px #39ff14) brightness(0) saturate(100%) invert(100%) sepia(100%) saturate(10000%) hue-rotate(90deg); }
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .radio-game-widget {
      width: calc(100vw - 40px);
      right: 20px;
    }

    .global-radio-game {
      right: 20px;
      left: 20px;
    }
  }

  /* Hidden state when disabled */
  .global-radio-game.disabled {
    display: none;
  }
</style>