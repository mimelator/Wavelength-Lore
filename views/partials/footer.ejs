<!-- Firebase Authentication (API keys are PUBLIC and safe - security is via Firebase Rules) -->
<% if (typeof cdnUrl !== 'undefined') { %>
  <% // In development, use local server to avoid CDN caching issues %>
  <% const scriptUrl = (process.env.NODE_ENV !== 'production') ? '/js/firebase-config.js' : cdnUrl + '/js/firebase-config.js'; %>
<script src="<%= scriptUrl %>?v=<%= Date.now() %>"></script>
<script>
  if (!window.firebaseAuth && !window.firebaseUtils) {
    window.initializeWavelengthFirebase({
      apiKey: "<%= process.env.API_KEY %>",
      authDomain: "<%= process.env.AUTH_DOMAIN %>",
      databaseURL: "<%= process.env.DATABASE_URL %>",
      projectId: "<%= process.env.PROJECT_ID %>",
      storageBucket: "<%= process.env.STORAGE_BUCKET %>",
      messagingSenderId: "<%= process.env.MESSAGING_SENDER_ID %>",
      appId: "<%= process.env.APP_ID %>"
    });
  }
</script>
<% } %>

<footer>
  <div class="footer-content">
    <p>&copy; 2025 Wavelength Lore. All rights reserved.</p>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
    <% if (versionInfo) { %>
    <div class="version-info">
      <span class="version-badge" title="Version v<%= versionInfo.version %> | Build #<%= versionInfo.buildNumber %> | Commit <%= versionInfo.commitShort %> | Built <%= new Date(versionInfo.buildDate).toLocaleDateString() %>">
        v<%= versionInfo.version %> (<%= versionInfo.commitShort %>)
      </span>
    </div>
    <% } %>
  </div>
</footer>
<style>
  footer {
    background-color: #333;
    color: #fff;
    padding: 20px 0;
    text-align: center;
  }
  .footer-content nav ul {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    justify-content: center;
    gap: 15px;
  }
  .footer-content nav ul li a {
    color: #fff;
    text-decoration: none;
  }
  .footer-content nav ul li a:hover {
    text-decoration: underline;
  }
  .version-info {
    margin-top: 10px;
    font-size: 0.8em;
    opacity: 0.7;
  }
  .version-badge {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: 12px;
    font-family: 'Courier New', monospace;
    font-size: 0.85em;
    cursor: help;
    transition: opacity 0.2s;
  }
  .version-badge:hover {
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.2);
  }
</style>