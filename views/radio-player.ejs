<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="<%= cdnUrl %>/css/radio-player.css?<%= version %>">
    <meta name="description" content="<%= pageDescription %>">
    <title><%= pageTitle %></title>
</head>
<body class="radio-player-body">
    <%- include('partials/header') %>

    <div class="radio-container">
        <!-- Floating mystical imagery canvas -->
        <div id="mystical-canvas" class="mystical-canvas">
            <!-- Dynamic elements will be spawned here -->
        </div>

        <!-- Background image gallery from current episode -->
        <div id="background-gallery" class="background-gallery">
            <!-- Episode images will be displayed here -->
        </div>

        <!-- Game stats at the top -->
        <div class="game-stats">
            <div class="stat-item">
                <span class="stat-icon">🍄</span>
                <span class="stat-value" id="mushroomCount">0</span>
            </div>
            <div class="stat-item">
                <span class="stat-icon">🌟</span>
                <span class="stat-value" id="starCount">0</span>
            </div>
            <div class="stat-item">
                <span class="stat-icon">🧲</span>
                <span class="stat-value" id="horseshoeCount">0</span>
            </div>
            <div class="stat-item">
                <span class="stat-icon">✨</span>
                <span class="stat-value" id="sparkleCount">0</span>
            </div>
            <div class="stat-item">
                <span class="stat-icon">🔮</span>
                <span class="stat-value" id="crystalCount">0</span>
            </div>
            <div class="stat-item">
                <span class="stat-icon">🌙</span>
                <span class="stat-value" id="moonCount">0</span>
            </div>
            <div class="stat-item rare-item">
                <span class="stat-icon">🧌</span>
                <span class="stat-value" id="goblinCount">0</span>
            </div>
            <div class="stat-item magic-level">
                <span class="stat-label">Level:</span>
                <span class="stat-value" id="magicLevel">1</span>
            </div>
            <div class="stat-item total-points">
                <span class="stat-label">🏆 Total:</span>
                <span class="stat-value" id="totalPoints">0</span>
            </div>
        </div>

        <!-- Radio player controls -->
        <div class="radio-player" id="radioPlayer">
            <button class="mobile-expand-btn" id="mobileExpandBtn" aria-label="Expand player"></button>
            <div class="player-header">
                <h1 class="radio-title">✨ Wavelength Radio ✨</h1>
                <p class="radio-subtitle">Journey through the sounds of the Shire</p>
            </div>

            <!-- Album art / now playing visual -->
            <div class="album-art-container">
                <div class="album-art" id="albumArt">
                    <div class="vinyl-record"></div>
                    <div class="album-glow"></div>
                </div>
            </div>

            <!-- Now playing info -->
            <div class="now-playing">
                <div class="track-info">
                    <h2 id="trackTitle">Select a song to begin</h2>
                    <p id="trackEpisode">Season - • Episode -</p>
                </div>
                <div class="progress-container">
                    <div class="time-display">
                        <span id="currentTime">0:00</span>
                        <span id="duration">0:00</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                        <div class="progress-handle" id="progressHandle"></div>
                    </div>
                </div>
            </div>

            <!-- Episode info section (hidden until track is playing) -->
            <div class="episode-info-section" id="episodeInfoSection" style="display: none;">
                <!-- Character badges -->
                <div class="character-badges" id="characterBadges">
                    <!-- Character badges will be added dynamically -->
                </div>

                <!-- Episode actions -->
                <div class="episode-actions">
                    <a href="#" id="episodeLink" class="episode-action-btn">
                        📺 View Episode
                    </a>
                    <a href="#" id="createPostLink" class="episode-action-btn">
                        💬 Create a Post
                    </a>
                </div>
            </div>

            <!-- Audio element -->
            <audio id="audioPlayer" preload="metadata"></audio>

            <!-- Playback controls -->
            <div class="controls">
                <button class="control-btn" id="shuffleBtn" title="Shuffle">
                    <span class="shuffle-icon">🔀</span>
                </button>
                <button class="control-btn" id="prevBtn" title="Previous">
                    <span>⏮</span>
                </button>
                <button class="control-btn play-btn" id="playPauseBtn" title="Play">
                    <span id="playIcon">▶</span>
                </button>
                <button class="control-btn" id="nextBtn" title="Next">
                    <span>⏭</span>
                </button>
                <button class="control-btn" id="repeatBtn" title="Repeat Off">
                    <span class="repeat-icon">🔁</span>
                </button>
            </div>

            <!-- Volume control -->
            <div class="volume-control">
                <span class="volume-icon">🔊</span>
                <input type="range" id="volumeSlider" min="0" max="100" value="80" class="volume-slider">
                <span id="volumeValue">80%</span>
                <button class="sound-toggle-btn" id="soundToggle" title="Toggle Sound Effects">🔊</button>
            </div>

            <!-- Playlist mode selector -->
            <div class="playlist-mode">
                <button class="mode-btn active" data-mode="sequential">Sequential</button>
                <button class="mode-btn" data-mode="random">Random</button>
                <button class="mode-btn" data-mode="loop">Loop Favorites</button>
            </div>

            <!-- Screen Saver Mode Toggle -->
            <div class="screensaver-toggle-container">
                <button class="screensaver-toggle-btn" id="screensaverToggle" title="Toggle Screen Saver Mode">
                    🎨 Screen Saver Mode
                </button>
            </div>

            <!-- Playlist panel (moved inside radio-player for mobile scrolling) -->
            <div class="playlist-panel">
            <div class="playlist-header">
                <h3>Playlist <span id="playlistCount">(33 songs)</span></h3>
                <div class="playlist-filters">
                    <button class="filter-btn active" data-season="all">All</button>
                    <button class="filter-btn" data-season="1">Season 1</button>
                    <button class="filter-btn" data-season="2">Season 2</button>
                    <button class="filter-btn" data-season="3">Season 3</button>
                    <button class="filter-btn" data-season="4">Season 4</button>
                </div>
            </div>
            <div class="playlist-items" id="playlistItems">
                <% playlist.forEach((track, index) => { %>
                <div class="playlist-item"
                     data-index="<%= index %>"
                     data-season="<%= track.season %>"
                     data-episode="<%= track.episode %>"
                     data-title="<%= track.title %>"
                     data-file="<%= track.file %>"
                     data-duration="<%= track.duration %>"
                     data-episode-image="<%= track.episodeImage || '' %>"
                     data-episode-url="<%= track.episodeUrl || '' %>"
                     data-characters="<%= track.characters ? JSON.stringify(track.characters) : '[]' %>">
                    <div class="playlist-item-number"><%= index + 1 %></div>
                    <div class="playlist-item-info">
                        <div class="playlist-item-title"><%= track.title %></div>
                        <div class="playlist-item-meta">Season <%= track.season %> • Episode <%= track.episode %></div>
                    </div>
                    <div class="playlist-item-duration"><%= track.duration %></div>
                    <button class="playlist-item-favorite" title="Add to favorites">♡</button>
                </div>
                <% }); %>
            </div>
        </div>
        </div>
    </div>

    <!-- Screen Saver Mode Overlay -->
    <div class="screensaver-overlay" id="screensaverOverlay">
        <div class="screensaver-gallery"></div>
        
        <!-- Weather effects layer -->
        <div class="weather-effects">
            <canvas class="weather-canvas"></canvas>
            <div class="lightning-flash"></div>
        </div>
        
        <div class="screensaver-exit-hint">Press any key or click to exit screen saver</div>
        
        <!-- Customization controls -->
        <div class="screensaver-customization">
            <!-- Toggle button -->
            <button class="customization-toggle" id="customizationToggle">
                ⚙️ Customize
            </button>
            
            <!-- Collapsible panel -->
            <div class="customization-panel" id="customizationPanel">
                <!-- Weather controls -->
                <div class="customization-section">
                    <div class="customization-section-header">
                        <span class="section-icon">🌤️</span>
                        <span class="section-title">Weather</span>
                    </div>
                    <div class="customization-buttons">
                        <button class="custom-btn weather-btn" data-weather="rain">🌧️ Rain</button>
                        <button class="custom-btn weather-btn" data-weather="snow">❄️ Snow</button>
                        <button class="custom-btn weather-btn" data-weather="clouds">☁️ Clouds</button>
                        <button class="custom-btn weather-btn" data-weather="wind">💨 Wind</button>
                        <button class="custom-btn weather-btn" data-weather="lightning">⚡ Lightning</button>
                        <button class="custom-btn weather-btn" data-weather="clear">☀️ Sun</button>
                        <button class="custom-btn weather-btn active" data-weather="auto">🔄 Auto</button>
                    </div>
                </div>
                
                <!-- Image controls -->
                <div class="customization-section">
                    <div class="customization-section-header">
                        <span class="section-icon">🖼️</span>
                        <span class="section-title">Image Effects</span>
                    </div>
                    <div class="customization-buttons">
                        <button class="custom-btn image-btn active" data-effect="hue" title="Color shift">🎨 Colors</button>
                        <button class="custom-btn image-btn active" data-effect="zoom" title="Zoom in/out">🔍 Zoom</button>
                        <button class="custom-btn image-btn active" data-effect="rotate" title="Rotation">🔄 Rotate</button>
                        <button class="custom-btn image-btn active" data-effect="brightness" title="Brightness pulse">💡 Brightness</button>
                        <button class="custom-btn image-btn active" data-effect="contrast" title="Contrast shift">⚖️ Contrast</button>
                    </div>
                </div>
                
                <!-- Game Mode controls -->
                <div class="customization-section">
                    <div class="customization-section-header">
                        <span class="section-icon">🎮</span>
                        <span class="section-title">Game Mode</span>
                    </div>
                    <div class="customization-buttons">
                        <button class="custom-btn game-btn active" data-game="off" title="Game off">🚫 Off</button>
                        <button class="custom-btn game-btn" data-game="easy" title="Easy mode">😊 Easy</button>
                        <button class="custom-btn game-btn" data-game="medium" title="Medium mode">😎 Medium</button>
                        <button class="custom-btn game-btn" data-game="hard" title="Hard mode">😈 Hard</button>
                    </div>
                    <div class="game-stats">
                        <span class="game-score">Score: <span id="gameScore">0</span></span>
                        <span class="game-timer">Time: <span id="gameTimer">0:00</span></span>
                    </div>
                </div>
                
                <!-- Lyrics controls -->
                <div class="customization-section">
                    <div class="customization-section-header">
                        <span class="section-icon">🎵</span>
                        <span class="section-title">Lyrics</span>
                    </div>
                    <div class="customization-buttons">
                        <button class="custom-btn lyrics-btn" data-lyrics="scroll" title="Scrolling lyrics">📜 Scroll</button>
                        <button class="custom-btn lyrics-btn" data-lyrics="static" title="Static lyrics">📄 Static</button>
                        <button class="custom-btn lyrics-btn active" data-lyrics="off" title="No lyrics">🚫 Off</button>
                    </div>
                </div>
                
                <!-- Title Display controls -->
                <div class="customization-section">
                    <div class="customization-section-header">
                        <span class="section-icon">🎼</span>
                        <span class="section-title">Song Title</span>
                    </div>
                    <div class="customization-buttons">
                        <button class="custom-btn title-btn active" data-title="on" title="Show song titles">✅ Show</button>
                        <button class="custom-btn title-btn" data-title="off" title="Hide song titles">🚫 Hide</button>
                    </div>
                </div>

                <!-- Transitions controls -->
                <div class="customization-section">
                    <div class="customization-section-header">
                        <span class="section-icon">🎞️</span>
                        <span class="section-title">Image Transitions</span>
                    </div>
                    <div class="customization-buttons">
                        <button class="custom-btn transition-btn active" data-transition="on" title="Random transitions between images">✨ Random</button>
                        <button class="custom-btn transition-btn" data-transition="off" title="No transitions">🚫 Off</button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Floating game icons container -->
        <div class="floating-game-icons"></div>
        
        <!-- Scrolling lyrics container -->
        <div class="screensaver-lyrics"></div>
        
        <!-- Song title overlay -->
        <div class="screensaver-title-overlay">
            <div class="title-content"></div>
        </div>
        
        <!-- Game HUD overlay -->
        <div class="game-hud">
            <div class="hud-score">
                <span class="hud-label">SCORE</span>
                <span class="hud-value" id="hudScore">0</span>
            </div>
            <div class="hud-timer">
                <span class="hud-label">TIME</span>
                <span class="hud-value" id="hudTimer">0:00</span>
            </div>
            <div class="hud-combo">
                <span class="combo-text" id="comboText"></span>
            </div>
        </div>
        
        <!-- Minimal playback controls -->
        <div class="screensaver-minimal-controls">
            <button class="screensaver-control" id="screensaverPrev" title="Previous">⏮</button>
            <button class="screensaver-control" id="screensaverPlayPause" title="Play/Pause">▶</button>
            <button class="screensaver-control" id="screensaverNext" title="Next">⏭</button>
        </div>
    </div>

    <script>
        // Pass playlist data to JavaScript
        try {
            window.WAVELENGTH_PLAYLIST = <%- JSON.stringify(playlist).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>;
        } catch(e) {
            console.error('Failed to parse playlist:', e);
            window.WAVELENGTH_PLAYLIST = [];
        }
        window.CDN_URL = '<%= cdnUrl %>';
    </script>
    <script src="<%= cdnUrl %>/js/firebase-config.js?<%= version %>"></script>
    <script>
        // Initialize Firebase
        if (!window.firebaseAuth && !window.firebaseUtils) {
            window.initializeWavelengthFirebase({
                apiKey: "<%= process.env.API_KEY %>",
                authDomain: "<%= process.env.AUTH_DOMAIN %>",
                databaseURL: "<%= process.env.DATABASE_URL %>",
                projectId: "<%= process.env.PROJECT_ID %>",
                storageBucket: "<%= process.env.STORAGE_BUCKET %>",
                messagingSenderId: "<%= process.env.MESSAGING_SENDER_ID %>",
                appId: "<%= process.env.APP_ID %>"
            });
        }
    </script>
    <script src="<%= cdnUrl %>/js/radio-player.js?<%= version %>"></script>
</body>
</html>
