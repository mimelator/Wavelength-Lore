<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/games.css">
    <link rel="stylesheet" href="/css/wavelength-gems.css">
    <link rel="stylesheet" href="/css/goblin-glitch.css">
    <link rel="stylesheet" href="/css/admin-panel.css">
    <style>
        /* Target both main.gems-game-wrapper and .gems-game-wrapper */
        main.gems-game-wrapper,
        .gems-game-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: transparent; /* Let the background container show through */
            padding: 4px;
            position: relative;
            z-index: 1; /* Above background (z-index: 0) but allow background to show */
            box-sizing: border-box;
            overflow: visible;
            width: 100% !important;
            max-width: 100% !important;
        }

        @media (max-width: 768px) {
            main.gems-game-wrapper,
            .gems-game-wrapper {
                padding: 4px;
                width: 100% !important;
                max-width: 100% !important;
            }
        }

        .gems-game-container {
            /* Solid container with animated gradient - keeps UI readable */
            background: linear-gradient(
                135deg,
                rgba(20, 20, 40, 0.95),
                rgba(30, 20, 50, 0.95),
                rgba(20, 20, 40, 0.95)
            );
            background-size: 300% 300%;
            animation: gradientShift 15s ease infinite;
            border: 2px solid rgba(138, 43, 226, 0.4);
            border-radius: 20px;
            padding: 10px; /* Reduced from 15px for more space */
            width: 100%;
            box-shadow: 
                0 8px 32px rgba(138, 43, 226, 0.3),
                inset 0 0 40px rgba(138, 43, 226, 0.1);
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow: visible;
        }

        @keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        @media (max-width: 768px) {
            .gems-game-container {
                padding: 4px;
                border-radius: 12px;
                border-width: 1px;
                width: 100%;
                overflow: visible;
            }
        }

        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px; /* Reduced from 20px */
            flex-wrap: wrap;
            gap: 10px; /* Reduced from 15px */
        }

        .game-title {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(135deg, #a78bfa, #d8b4fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
        }

        .game-stats {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .stat {
            background: rgba(138, 43, 226, 0.1);
            padding: 12px 20px;
            border-radius: 10px;
            border: 1px solid rgba(138, 43, 226, 0.2);
            text-align: center;
        }

        .stat-label {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.6);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: #a78bfa;
            margin-top: 5px;
        }

        .game-board-wrapper {
            margin: 10px 0;
            display: flex;
            justify-content: center;
            position: relative; /* Allow absolute positioning for goblin */
            width: 100%;
            box-sizing: border-box;
            overflow: visible;
        }

        /* Hero Badge - positioned to right of game board */
        .hero-badge {
            position: absolute;
            right: -220px; /* Position to right of board */
            top: 50%;
            transform: translateY(-50%);
            width: 200px;
            z-index: 10;
            animation: heroBadgeAppear 0.5s ease-out;
        }

        .hero-badge-img {
            width: 100%;
            height: auto;
            border-radius: 15px;
            border: 4px solid #FFD700;
            box-shadow: 
                0 8px 32px rgba(255, 215, 0, 0.4),
                0 0 40px rgba(255, 215, 0, 0.3),
                inset 0 0 20px rgba(255, 215, 0, 0.2);
            transition: all 0.3s ease;
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.2), rgba(75, 0, 130, 0.2));
        }

        .hero-badge-img:hover {
            transform: scale(1.05);
            box-shadow: 
                0 12px 48px rgba(255, 215, 0, 0.6),
                0 0 60px rgba(255, 215, 0, 0.5),
                inset 0 0 30px rgba(255, 215, 0, 0.3);
        }

        @keyframes heroBadgeAppear {
            from {
                opacity: 0;
                transform: translateY(-50%) translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateY(-50%) translateX(0);
            }
        }

        /* Hide hero badge on smaller screens */
        @media (max-width: 1400px) {
            .hero-badge {
                display: none;
            }
        }

        @media (max-width: 768px) {
            .game-board-wrapper {
                margin: 5px 0;
                padding: 0 2px;
                width: 100% !important;
                max-width: 100% !important;
                overflow: hidden !important;
                box-sizing: border-box !important;
            }
        }

        #gameBoard {
            background: linear-gradient(135deg, rgb(100, 0, 200), rgb(50, 0, 100));
            border: 3px solid rgba(138, 43, 226, 0.5);
            border-radius: 15px;
            display: grid;
            gap: 3px;
            padding: 10px;
            position: relative; /* Allow absolute positioning for goblin */
            z-index: 1; /* Board appears above goblin */
            width: fit-content;
            box-sizing: border-box;
        }

        @media (max-width: 768px) {
            #gameBoard {
                border: 2px solid rgba(138, 43, 226, 0.5);
                padding: 4px;
                gap: 2px;
                border-radius: 12px;
                /* FORCE board to fit within viewport */
                max-width: 100% !important;
                width: 100% !important;
                overflow: hidden !important;
                box-sizing: border-box !important;
            }
        }

        .gem {
            /* Width/height set dynamically by JavaScript - DO NOT override here */
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            transition: all 0.1s ease;
            user-select: none;
            border: 2px solid transparent;
            position: relative;
            z-index: 2; /* Gems appear above the goblin underneath */
        }

        /* Mobile: Flex to fill grid cell, maintain square */
        @media (max-width: 768px) {
            .gem {
                width: 100% !important;
                height: 100% !important;
                aspect-ratio: 1 / 1;
                min-width: 0;
                min-height: 0;
            }
        }

        /* Desktop: Use fixed size */
        @media (min-width: 769px) {
            .gem {
                width: 60px !important;
                height: 60px !important;
            }
        }

        .gem:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(138, 43, 226, 0.5);
        }

        .gem.selected {
            border-color: #ffd700;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.8);
            transform: scale(1.1);
        }

        /* Mobile: Prevent emoji overflow and ensure proper display */
        @media (max-width: 768px) {
            .gem {
                padding: 2px; /* Small padding to contain emoji */
                line-height: 1;
            }
        }

        .gem-daphne { background: linear-gradient(135deg, #a855f7, #7c3aed); }
        .gem-jasper { background: linear-gradient(135deg, #3b82f6, #1e40af); }
        .gem-miles { background: linear-gradient(135deg, #10b981, #047857); }
        .gem-ivy { background: linear-gradient(135deg, #ec4899, #be185d); }
        .gem-echo { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .gem-atlas { background: linear-gradient(135deg, #06b6d4, #0891b2); }

        /* Mobile board sizing - let CSS grid auto-size based on gem width */
        @media (max-width: 768px) {
            #gameBoard {
                width: fit-content;
                margin: 0 auto;
                max-width: 100vw;
                overflow: hidden;
            }
        }

        .game-controls {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #8b5cf6, #6366f1);
            color: white;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #a78bfa, #818cf8);
            transform: scale(1.05);
        }

        .btn-secondary {
            background: rgba(138, 43, 226, 0.2);
            color: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(138, 43, 226, 0.4);
        }

        .btn-secondary:hover {
            background: rgba(138, 43, 226, 0.3);
        }

        .game-info {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(59, 130, 246, 0.1));
            border-left: 4px solid #22c55e;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.95rem;
        }

        /* Mobile styles handled by JavaScript injection and main media queries above */
    </style>
</head>
<body>
    <%- include('../partials/header') %>

    <!-- Game Background with effects -->
    <div class="game-background-container">
        <div class="game-background-gallery"></div>
        <canvas class="game-weather-canvas"></canvas>
        <div class="game-lightning-flash"></div>
    </div>

    <main class="gems-game-wrapper">
        <div class="gems-game-layout">
            <!-- Left Sidebar (Desktop only) -->
            <aside class="game-sidebar left-sidebar">
                <div class="level-info-card">
                    <div class="level-info-header">
                        <h3 id="sidebarLevelTitle">Level 1</h3>
                        <p id="sidebarLevelSubtitle">My Lucky Charm</p>
                    </div>
                    <div class="level-info-body">
                        <p id="sidebarLevelDescription">Match gems to spread luck across the Shire!</p>
                        <div class="level-objectives">
                            <h4>Objectives:</h4>
                            <ul id="sidebarObjectives">
                                <li>Reach target score</li>
                            </ul>
                        </div>
                    </div>
                    <div class="level-info-footer">
                        <a href="#" id="sidebarEpisodeLink" class="episode-link" target="_blank">
                            📺 Explore Episode
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Center Game Container -->
            <div class="gems-game-container">
                <!-- Game Header -->
                <div class="game-header">
                    <h1 class="game-title">🎮 Wavelength Gems</h1>
                    <div class="game-stats">
                        <div class="stat">
                            <div class="stat-label">Level</div>
                            <div class="stat-value" id="levelDisplay">1</div>
                        </div>
                        <div class="stat">
                            <div class="stat-label">Score</div>
                            <div class="stat-value" id="scoreDisplay">0</div>
                        </div>
                        <div class="stat">
                            <div class="stat-label">Target</div>
                            <div class="stat-value" id="targetDisplay">1500</div>
                        </div>
                        <div class="stat">
                            <div class="stat-label">Moves</div>
                            <div class="stat-value" id="movesDisplay">∞</div>
                        </div>
                        <div class="stat" id="cascadesStat" style="display: none;">
                            <div class="stat-label">Cascades</div>
                            <div class="stat-value">
                                <span id="cascadesDisplay">0</span>
                                <span id="cascadesTarget" style="opacity: 0.6;"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Game Board -->
                <div class="game-board-wrapper">
                    <!-- Hero Badge (overlaid on right side of board) -->
                    <div class="hero-badge" id="heroBadge">
                        <img id="heroBadgeImage" src="" alt="Episode Hero" class="hero-badge-img">
                    </div>
                    
                    <div id="gameBoard">
                        <!-- 👹 Static goblin underneath gems - revealed when holes appear -->
                        <div class="goblin-underneath">
                            <img src="/static/images/characters/wavelength/TheBattleOfTheShire-050.webp" alt="Goblin">
                        </div>
                    </div>
                </div>

                <!-- Game Controls -->
                <div class="game-controls">
                    <button class="btn btn-primary" onclick="showLevelSelectionMenu()">📋 Select Level</button>
                    <button class="btn btn-secondary" id="newGameBtn" onclick="retryLevel()">↻ Restart Level</button>
                    <button class="btn btn-secondary" id="pauseBtn" onclick="togglePause()">⏸ Pause</button>
                    <button class="btn btn-secondary" id="soundBtn" onclick="toggleSound()">🔊 Sound On</button>
                    <button class="btn btn-secondary" onclick="toggleLeaderboard()">🏆 Leaderboard</button>
                    <button class="btn btn-secondary" onclick="window.location.href = '/games'">← Back to Games</button>
                </div>

                <!-- Leaderboard Widget -->
                <div id="leaderboardWidget" class="leaderboard-widget" style="display: none;">
                    <div class="leaderboard-header">
                        <h3>🏆 Top Scores</h3>
                        <button class="close-btn" onclick="toggleLeaderboard()">&times;</button>
                    </div>
                    <div id="leaderboardList" class="leaderboard-list">
                        <p style="text-align: center; color: rgba(255,255,255,0.6);">Loading leaderboard...</p>
                    </div>
                </div>

                <!-- Game Info -->
                <div class="game-info">
                    <strong>How to Play:</strong> Click on gems to select them, then click an adjacent gem to swap. Match 3 or more gems of the same type to clear them and earn points!
                </div>
            </div>

            <!-- Right Sidebar (Desktop only) -->
            <aside class="game-sidebar right-sidebar">
                <div class="level-tips-card">
                    <h3>💡 Tips & Strategy</h3>
                    <ul class="tips-list">
                        <li>Look for matches that create cascades</li>
                        <li>Plan ahead to maximize combos</li>
                        <li>Focus on the target score</li>
                        <li>Save moves for big plays</li>
                    </ul>
                </div>
                <div class="level-stats-card">
                    <h3>📊 Current Stats</h3>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="stat-icon">⭐</span>
                            <span class="stat-text">Best: <span id="bestScore">0</span></span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-icon">🔥</span>
                            <span class="stat-text">Combo: <span id="bestCombo">0</span></span>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <!-- Load level system first (must be before engine.js) -->
    <script src="/js/games/wavelength-gems/levels.js"></script>
    <script src="/js/games/wavelength-gems/level-briefing.js"></script>
    <script src="/js/games/wavelength-gems/game-background.js"></script>
    <script src="/js/games/wavelength-gems/background-diagnostics.js"></script>
    
    <!-- Game engine and utilities -->
    <script src="/js/games/wavelength-gems/validator.js"></script>
    <script src="/js/games/wavelength-gems/engine.js"></script>
    <script src="/js/games/wavelength-gems/ui.js"></script>
    
    <!-- Admin/Developer Debug Panel (Ctrl+Shift+D to toggle) -->
    <script src="/js/games/wavelength-gems/admin-panel.js"></script>
    
    <script>
        // Validator available but disabled by default (major bugs fixed!)
        // To enable validation: startValidation(1000) in console
        // Manual commands: validateGame(), diagnoseStuckGame(), visualizePositionMismatches()
        
        // Toggle leaderboard visibility
        function toggleLeaderboard() {
            const widget = document.getElementById('leaderboardWidget');
            if (widget.style.display === 'none') {
                widget.style.display = 'block';
                loadLeaderboard();
            } else {
                widget.style.display = 'none';
            }
        }

        // Load leaderboard data
        async function loadLeaderboard() {
            try {
                const response = await fetch('/api/games/wavelength-gems/top-scores?limit=20');
                const data = await response.json();

                if (!data.success) {
                    document.getElementById('leaderboardList').innerHTML = '<p style="color: red;">Failed to load leaderboard</p>';
                    return;
                }

                const html = data.topScores.map(score => `
                    <div class="leaderboard-entry">
                        <span class="rank">#${score.rank}</span>
                        <span class="name">${escapeHtml(score.userName)}</span>
                        <span class="score">${score.score.toLocaleString()}</span>
                    </div>
                `).join('');

                document.getElementById('leaderboardList').innerHTML = html || '<p style="color: rgba(255,255,255,0.6);">No scores yet</p>';
            } catch (error) {
                console.error('Error loading leaderboard:', error);
                document.getElementById('leaderboardList').innerHTML = '<p style="color: red;">Error loading leaderboard</p>';
            }
        }

        // Escape HTML to prevent XSS
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        // Initialize game on page load
        document.addEventListener('DOMContentLoaded', async () => {
            await initGame();
            loadUserStats();
        });
    </script>
</body>
</html>
