<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/games.css">
    <style>
        .games-container {
            max-width: 1400px;
            margin: 40px auto;
            padding: 20px;
        }

        .games-header {
            text-align: center;
            margin-bottom: 50px;
            background: linear-gradient(135deg, rgba(128, 0, 255, 0.15), rgba(75, 0, 130, 0.15));
            padding: 60px 40px;
            border-radius: 25px;
            border: 2px solid rgba(138, 43, 226, 0.3);
            box-shadow: 0 0 30px rgba(138, 43, 226, 0.2);
        }

        .games-header .icon {
            font-size: 5rem;
            margin-bottom: 20px;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .games-header h1 {
            font-size: 3.5rem;
            margin: 0 0 15px 0;
            background: linear-gradient(135deg, #a78bfa, #d8b4fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }

        .games-header p {
            font-size: 1.2rem;
            color: rgba(255, 255, 255, 0.8);
            margin: 0;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .games-header .vip-badge {
            display: inline-block;
            background: linear-gradient(135deg, #ffd700, #ffed4e);
            color: #000;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: bold;
            margin-top: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .game-card {
            background: rgba(20, 20, 40, 0.8);
            border: 2px solid rgba(138, 43, 226, 0.3);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }

        .game-card:hover {
            border-color: rgba(138, 43, 226, 0.7);
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(138, 43, 226, 0.3);
        }

        .game-card-image {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(75, 0, 130, 0.3));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            border-bottom: 2px solid rgba(138, 43, 226, 0.2);
            position: relative;
            overflow: hidden;
        }

        .game-card-image::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at center, rgba(138, 43, 226, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .game-card-content {
            padding: 25px;
        }

        .game-card-title {
            font-size: 1.5rem;
            font-weight: bold;
            margin: 0 0 10px 0;
            color: #fff;
        }

        .game-card-description {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.7);
            margin: 0 0 20px 0;
            line-height: 1.5;
        }

        .game-card-status {
            display: inline-block;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 15px;
        }

        .game-card-status.coming-soon {
            background: rgba(255, 215, 0, 0.2);
            color: #ffd700;
            border: 1px solid rgba(255, 215, 0, 0.4);
        }

        .game-card-status.live {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
            border: 1px solid rgba(34, 197, 94, 0.4);
        }

        .game-card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid rgba(138, 43, 226, 0.2);
        }

        .game-card-date {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .game-card-btn {
            padding: 8px 16px;
            background: linear-gradient(135deg, #8b5cf6, #6366f1);
            border: none;
            border-radius: 8px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .game-card-btn:hover {
            background: linear-gradient(135deg, #a78bfa, #818cf8);
            transform: scale(1.05);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255, 255, 255, 0.6);
        }

        .empty-state-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .empty-state h2 {
            font-size: 2rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 10px;
        }

        .empty-state p {
            font-size: 1.1rem;
            margin: 0;
        }

        .games-info {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(59, 130, 246, 0.1));
            border-left: 4px solid #22c55e;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 40px;
            color: rgba(255, 255, 255, 0.8);
        }

        .games-info strong {
            color: #22c55e;
        }

        @media (max-width: 768px) {
            .games-header h1 {
                font-size: 2.5rem;
            }

            .games-grid {
                grid-template-columns: 1fr;
            }

            .games-header {
                padding: 40px 20px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>

    <main class="games-container">
        <!-- Header Section -->
        <div class="games-header">
            <div class="icon">🎮</div>
            <h1>Wavelength Games Hub</h1>
            <p>Exclusive games and interactive experiences for our VIP community members</p>
            <div class="vip-badge">VIP Exclusive Access</div>
        </div>

        <!-- Info Banner -->
        <div class="games-info">
            <strong>✨ Sandbox Environment:</strong> This is a dedicated sandbox area where we test and launch new games. Only VIP members and above can access this section.
        </div>

        <!-- Games Grid -->
        <div id="gamesContainer" class="games-grid">
            <div class="empty-state">
                <div class="empty-state-icon">⏳</div>
                <h2>Loading Games...</h2>
                <p>We're preparing exciting games for you</p>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        // Load games data
        async function loadGames() {
            try {
                const response = await fetch('/games/api/list');
                const data = await response.json();

                if (!data.success) {
                    showError('Failed to load games');
                    return;
                }

                renderGames(data.games);
            } catch (error) {
                console.error('Error loading games:', error);
                showError('Error loading games');
            }
        }

        function renderGames(games) {
            const container = document.getElementById('gamesContainer');

            if (!games || games.length === 0) {
                container.innerHTML = `
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <div class="empty-state-icon">🎮</div>
                        <h2>Coming Soon</h2>
                        <p>We're working on exciting games to share with you. Check back soon!</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = games.map(game => `
                <div class="game-card">
                    <div class="game-card-image">${getGameIcon(game.id)}</div>
                    <div class="game-card-content">
                        <h3 class="game-card-title">${escapeHtml(game.title)}</h3>
                        <p class="game-card-description">${escapeHtml(game.description)}</p>
                        <div class="game-card-status ${game.status}">${game.status === 'coming-soon' ? 'Coming Soon' : 'Live'}</div>
                        <div class="game-card-footer">
                            <span class="game-card-date">${game.releaseDate || 'TBA'}</span>
                            <button class="game-card-btn" onclick="launchGame('${game.id}')" ${game.status === 'coming-soon' ? 'disabled' : ''}>
                                ${game.status === 'coming-soon' ? 'Coming Soon' : 'Play'}
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function getGameIcon(gameId) {
            const icons = {
                'wavelength-gems': '💎',
                'wavelength-quest': '⚔️',
                'lore-puzzle': '🧩'
            };
            return icons[gameId] || '🎮';
        }

        function launchGame(gameId) {
            window.location.href = `/games/${gameId}`;
        }

        function showError(message) {
            const container = document.getElementById('gamesContainer');
            container.innerHTML = `
                <div class="empty-state" style="grid-column: 1 / -1;">
                    <div class="empty-state-icon">❌</div>
                    <h2>${message}</h2>
                    <p>Please try again later</p>
                </div>
            `;
        }

        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        // Load games on page load
        document.addEventListener('DOMContentLoaded', loadGames);
    </script>
</body>
</html>
