<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Wavelength Lore</title>
    
    <!-- Standard Wavelength includes -->
    <link rel="stylesheet" href="/css/styles.css?v=<%= version %>">
    <link rel="stylesheet" href="/css/lore_styles.css?v=<%= version %>">
    <link rel="stylesheet" href="/css/games.css?v=<%= version %>">
    
    <!-- Jigsaw Puzzle specific styles -->
    <style>
        .jigsaw-game-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
        }
        
        .jigsaw-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            backdrop-filter: blur(10px);
        }
        
        .puzzle-info h2 {
            color: #87ceeb;
            margin: 0 0 10px 0;
            font-size: 1.8em;
        }
        
        .puzzle-stats {
            display: flex;
            gap: 20px;
            color: #b8c5d1;
        }
        
        .timer {
            font-weight: bold;
            color: #ffeb3b;
        }
        
        .puzzle-controls {
            display: flex;
            gap: 10px;
        }
        
        .btn-secondary {
            padding: 10px 20px;
            background: rgba(135, 206, 235, 0.2);
            border: 2px solid #87ceeb;
            color: #87ceeb;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-secondary:hover {
            background: rgba(135, 206, 235, 0.3);
            transform: translateY(-2px);
        }
        
        .btn-primary {
            padding: 10px 20px;
            background: linear-gradient(135deg, #87ceeb, #4169e1);
            border: none;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(135, 206, 235, 0.4);
        }
        
        .puzzle-selector {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
        }
        
        .puzzle-selector h3 {
            color: #87ceeb;
            text-align: center;
            margin-bottom: 30px;
            font-size: 1.5em;
        }
        
        .difficulty-tabs {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
        }
        
        .difficulty-tab {
            padding: 12px 24px;
            background: rgba(135, 206, 235, 0.1);
            border: 2px solid rgba(135, 206, 235, 0.3);
            color: #b8c5d1;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .difficulty-tab.active {
            background: rgba(135, 206, 235, 0.3);
            border-color: #87ceeb;
            color: #87ceeb;
            font-weight: bold;
        }
        
        .puzzle-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .puzzle-option {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        
        .puzzle-option:hover:not(.locked) {
            border-color: #87ceeb;
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(135, 206, 235, 0.2);
        }
        
        .puzzle-option.locked {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        .puzzle-thumbnail {
            position: relative;
            width: 100%;
            height: 150px;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 15px;
        }
        
        .puzzle-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .lock-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 2em;
            background: rgba(0, 0, 0, 0.8);
            padding: 20px;
            border-radius: 50%;
        }
        
        .puzzle-details h4 {
            color: #87ceeb;
            margin: 0 0 10px 0;
        }
        
        .puzzle-lore {
            color: #b8c5d1;
            font-style: italic;
            margin: 10px 0;
            line-height: 1.4;
        }
        
        .puzzle-meta {
            display: flex;
            justify-content: space-between;
            margin: 15px 0;
            color: #999;
            font-size: 0.9em;
        }
        
        .start-puzzle-btn {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #87ceeb, #4169e1);
            border: none;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        
        .start-puzzle-btn:hover:not(.disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(135, 206, 235, 0.4);
        }
        
        .start-puzzle-btn.disabled {
            background: #555;
            cursor: not-allowed;
        }
        
        .game-area {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 20px;
        }
        
        .puzzle-workspace {
            display: grid;
            grid-template-columns: 300px 1fr 300px;
            gap: 20px;
            min-height: 600px;
        }
        
        .preview-panel {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 15px;
            transition: all 0.3s ease;
        }
        
        .preview-panel.minimized {
            transform: scale(0.7);
            opacity: 0.7;
        }
        
        .preview-panel img {
            width: 100%;
            border-radius: 8px;
            margin-bottom: 15px;
        }
        
        .lore-info h4 {
            color: #87ceeb;
            margin: 0 0 10px 0;
            font-size: 1.1em;
        }
        
        .lore-info p {
            color: #b8c5d1;
            font-size: 0.9em;
            line-height: 1.4;
        }
        
        .puzzle-board {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            border: 2px dashed rgba(135, 206, 235, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2em;
            color: #87ceeb;
        }
        
        .pieces-tray {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 15px;
        }
        
        .pieces-tray h4 {
            color: #87ceeb;
            margin: 0 0 15px 0;
            text-align: center;
        }
        
        .pieces-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
            gap: 10px;
            max-height: 500px;
            overflow-y: auto;
        }
        
        .puzzle-piece {
            width: 60px;
            height: 60px;
            background: rgba(135, 206, 235, 0.2);
            border: 2px solid rgba(135, 206, 235, 0.5);
            border-radius: 8px;
            cursor: grab;
            transition: all 0.2s ease;
        }
        
        .puzzle-piece:hover {
            transform: scale(1.1);
            border-color: #87ceeb;
        }
        
        .puzzle-piece:active {
            cursor: grabbing;
        }
        
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        
        .modal-content {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            border: 2px solid #87ceeb;
            border-radius: 15px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
            text-align: center;
        }
        
        .modal-content h3 {
            color: #87ceeb;
            margin: 0 0 20px 0;
            font-size: 1.8em;
        }
        
        .completion-stats {
            margin: 20px 0;
            color: #b8c5d1;
        }
        
        .completion-stats p {
            margin: 10px 0;
            font-size: 1.1em;
        }
        
        .completion-lore {
            background: rgba(135, 206, 235, 0.1);
            border-radius: 10px;
            padding: 20px;
            margin: 20px 0;
        }
        
        .completion-lore h4 {
            color: #87ceeb;
            margin: 0 0 10px 0;
        }
        
        .completion-lore p {
            color: #b8c5d1;
            font-style: italic;
            line-height: 1.4;
        }
        
        .completion-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
        }
        
        @media (max-width: 1200px) {
            .puzzle-workspace {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto 1fr;
            }
            
            .preview-panel {
                display: grid;
                grid-template-columns: 200px 1fr;
                gap: 15px;
                align-items: start;
            }
            
            .preview-panel img {
                width: 100%;
                margin-bottom: 0;
            }
        }
        
        @media (max-width: 768px) {
            .jigsaw-header {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
            
            .puzzle-stats {
                justify-content: center;
            }
            
            .difficulty-tabs {
                flex-wrap: wrap;
            }
            
            .puzzle-options {
                grid-template-columns: 1fr;
            }
            
            .preview-panel {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/header') %>
    
    <main class="main-content">
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb-nav">
            <% breadcrumbs.forEach((crumb, index) => { %>
                <% if (index > 0) { %><span class="breadcrumb-separator">></span><% } %>
                <% if (crumb.url) { %>
                    <a href="<%= crumb.url %>" class="breadcrumb-link"><%= crumb.name %></a>
                <% } else { %>
                    <span class="breadcrumb-current"><%= crumb.name %></span>
                <% } %>
            <% }) %>
        </nav>

        <!-- Jigsaw Puzzle Game Container -->
        <div id="jigsaw-puzzle-container"></div>
    </main>

    <%- include('../partials/footer') %>

    <!-- Game Scripts -->
    <script src="/static/js/games/jigsaw-puzzle.js?v=<%= version %>"></script>
    
    <script>
        // Initialize the game with theme-specific configuration
        document.addEventListener('DOMContentLoaded', () => {
            console.log('🧩 Wavelength Lore Jigsaw Puzzle Loading...');
            
            // Add strategic lore integration
            if (window.jigsawPuzzle) {
                console.log('✅ Jigsaw Puzzle Engine Initialized');
                console.log('🎯 Strategic puzzle reconstruction with lore bonuses active!');
            }
        });
    </script>
</body>
</html>