<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <title><%= title %></title>
    <style>
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
        }

        .vip-chatbot-container {
            background: linear-gradient(135deg, #1e1e2e 0%, #2d1b69 50%, #1a1a2e 100%);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            position: relative;
            overflow: hidden;
            padding: 20px;
        }

        .vip-chatbot-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #ffd700, #ff6b6b, #4ecdc4, #45b7d1, #ffd700);
            background-size: 200% 100%;
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { background-position: 200% 0; }
            50% { background-position: -200% 0; }
        }

        .vip-header {
            text-align: center;
            margin-bottom: 30px;
            color: #ffd700;
        }

        .vip-header h1 {
            font-size: 2.5rem;
            margin: 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            background: linear-gradient(45deg, #ffd700, #ff6b6b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .vip-badge {
            display: inline-block;
            background: linear-gradient(45deg, #ffd700, #ff6b6b);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
            margin-top: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
        }

        .chatbot-frame {
            width: 100%;
            height: 600px;
            border: none;
            border-radius: 10px;
            background: #ffffff;
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        }

        .vip-features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .feature-card {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .feature-card h3 {
            color: #ffd700;
            margin-bottom: 10px;
        }

        .feature-card p {
            color: #e0e0e0;
            margin: 0;
        }

        .loading-spinner {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 600px;
            flex-direction: column;
            color: #ffd700;
        }

        .spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255, 215, 0, 0.3);
            border-left: 4px solid #ffd700;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .error-message {
            background: rgba(255, 107, 107, 0.1);
            border: 1px solid #ff6b6b;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            color: #ff6b6b;
            margin: 20px 0;
        }

        @media (max-width: 768px) {
            .container {
                margin: 10px auto;
                padding: 10px;
            }
            
            .vip-chatbot-container {
                padding: 15px;
            }
            
            .vip-header h1 {
                font-size: 2rem;
            }
            
            .chatbot-frame {
                height: 500px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    
    <main class="container">
        <div class="vip-chatbot-container">
            <div class="vip-header">
                <h1>🎵 VIP Wavelength AI Assistant</h1>
                <div class="vip-badge"><%= membershipLevel.toUpperCase() %> Member</div>
            </div>

            <div id="chatbot-loading" class="loading-spinner">
                <div class="spinner"></div>
                <p>Initializing your VIP AI Assistant...</p>
            </div>

            <div id="chatbot-error" class="error-message" style="display: none;">
                <h3>⚠️ Unable to Load Chatbot</h3>
                <p>There was an issue connecting to your VIP AI Assistant. Please refresh the page or contact support.</p>
            </div>

            <iframe id="chatbot-frame" class="chatbot-frame" style="display: none;"></iframe>

            <div class="vip-features">
                <div class="feature-card">
                    <h3>🎯 Priority Support</h3>
                    <p>Get faster responses and priority handling for all your queries</p>
                </div>
                <div class="feature-card">
                    <h3>🧠 Advanced Features</h3>
                    <p>Access to enhanced AI capabilities and specialized knowledge</p>
                </div>
                <div class="feature-card">
                    <h3>🔒 Secure & Private</h3>
                    <p>Your conversations are encrypted and kept completely private</p>
                </div>
                <div class="feature-card">
                    <h3>⚡ Real-time Learning</h3>
                    <p>AI assistant that learns and adapts to your preferences</p>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        // Chatbot configuration from server
        const chatbotConfig = <%- chatbotConfig %>;
        
        // Initialize VIP chatbot
        function initializeChatbot() {
            try {
                const chatbotFrame = document.getElementById('chatbot-frame');
                const loadingDiv = document.getElementById('chatbot-loading');
                const errorDiv = document.getElementById('chatbot-error');

                // Build chatbot URL with token
                const chatbotUrl = new URL('/sso-demo.html', chatbotConfig.apiEndpoint);
                chatbotUrl.searchParams.set('token', chatbotConfig.token);
                chatbotUrl.searchParams.set('theme', chatbotConfig.theme);
                chatbotUrl.searchParams.set('embedded', 'false');

                // Hide loading and show button to open chatbot
                loadingDiv.style.display = 'none';
                
                // Create chatbot launch button
                const launchButton = document.createElement('div');
                launchButton.innerHTML = `
                    <div style="text-align: center; padding: 40px;">
                        <button onclick="openChatbotPopup()" style="
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            color: white;
                            border: none;
                            padding: 20px 40px;
                            border-radius: 15px;
                            font-size: 1.2rem;
                            font-weight: bold;
                            cursor: pointer;
                            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
                            transition: all 0.3s ease;
                        " onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                            🎵 Launch VIP AI Assistant
                        </button>
                        <p style="color: rgba(255,255,255,0.8); margin-top: 15px;">
                            Opens in a new secure window
                        </p>
                        <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem; margin-top: 10px;">
                            If popup is blocked, you can access the chatbot directly at:<br>
                            <a href="' + chatbotUrl + '" target="_blank" style="color: #ffd700; text-decoration: underline;">
                                ai-wavelengthlore.web.app/sso-demo.html
                            </a>
                        </p>
                    </div>
                `;
                
                chatbotFrame.parentNode.insertBefore(launchButton, chatbotFrame);
                chatbotFrame.style.display = 'none';

                // Store URL globally for popup function
                window.chatbotPopupUrl = chatbotUrl.toString();
                
                console.log('🎵 VIP Chatbot ready to launch');

                // Handle iframe error
                chatbotFrame.onerror = function() {
                    loadingDiv.style.display = 'none';
                    errorDiv.style.display = 'block';
                    
                    console.error('❌ Failed to load VIP Chatbot');
                };

                // Timeout fallback
                setTimeout(() => {
                    if (chatbotFrame.style.display === 'none') {
                        loadingDiv.style.display = 'none';
                        errorDiv.style.display = 'block';
                    }
                }, 15000);

            } catch (error) {
                console.error('Chatbot initialization error:', error);
                document.getElementById('chatbot-loading').style.display = 'none';
                document.getElementById('chatbot-error').style.display = 'block';
            }
        }

        // Token refresh functionality
        async function refreshTokenIfNeeded() {
            try {
                const response = await fetch('/chatbot/refresh-token', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${chatbotConfig.token}`
                    },
                    body: JSON.stringify({
                        currentToken: chatbotConfig.token
                    })
                });

                const data = await response.json();
                
                if (data.success && data.newToken) {
                    chatbotConfig.token = data.newToken;
                    console.log('🔄 Chatbot token refreshed');
                }
            } catch (error) {
                console.warn('Token refresh failed:', error);
            }
        }

        // Open chatbot in popup window
        function openChatbotPopup() {
            const popup = window.open(
                window.chatbotPopupUrl,
                'wavelength-vip-chatbot',
                'width=900,height=700,scrollbars=yes,resizable=yes,toolbar=no,menubar=no'
            );
            
            if (popup) {
                popup.focus();
                console.log('🎵 VIP Chatbot opened in popup window');
            } else {
                alert('Please allow popups for this site to use the VIP chatbot.');
            }
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🎵 VIP Chatbot Widget - Membership:', chatbotConfig.membershipLevel);
            initializeChatbot();
            
            // Refresh token every 23 hours
            setInterval(refreshTokenIfNeeded, 23 * 60 * 60 * 1000);
        });

        // Handle window messages from chatbot iframe
        window.addEventListener('message', function(event) {
            if (event.origin !== chatbotConfig.apiEndpoint) return;
            
            if (event.data.type === 'chatbot_ready') {
                console.log('🎵 VIP Chatbot is ready');
            } else if (event.data.type === 'token_expired') {
                console.log('🔄 Token expired, refreshing...');
                refreshTokenIfNeeded();
            }
        });
    </script>
</body>
</html>