<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/lore_styles.css?v=<%= version %>">
    <link rel="stylesheet" href="/css/modal_styles.css?v=<%= version %>">
    <link rel="stylesheet" href="/css/merchandise-store.css?v=<%= version %>">
    <link rel="stylesheet" href="/css/enhanced-product-ui.css?v=<%= version %>">
    <link rel="stylesheet" href="/css/gorgeous-mockups.css?v=<%= version %>">

    <title>The Liberation Vault | Wavelength Lore</title>
    <meta name="description" content="The Liberation Vault - A sanctuary where liberated minds create and share symbols of their freedom. Transform your gallery images into premium merchandise.">
</head>
<body>
    <%- include('partials/header') %>
    <%- include('partials/banner') %>

    <main class="merchandise-main">
        <div id="merchandise-store">
            <!-- The Liberation Vault interface will be rendered here by JavaScript -->
            <div class="loading-container">
                <div class="loading-spinner"></div>
                <p>Opening The Liberation Vault...</p>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <!-- REFACTOR: Load all services in dependency order -->

    <!-- Stripe.js Library (external) -->
    <script src="https://js.stripe.com/v3/"></script>

    <!-- Event Bus (foundation) -->
    <script src="/js/services/wavelength-event-bus.js?v=<%= version %>" onerror="console.error('❌ Failed to load wavelength-event-bus.js')"></script>

    <!-- Core Services -->
    <script src="/js/services/MerchandiseApiService.js?v=<%= version %>" onerror="console.error('❌ Failed to load MerchandiseApiService.js')"></script>
    <script src="/js/services/merchandise-cart-service.js?v=<%= version %>" onerror="console.error('❌ Failed to load merchandise-cart-service.js')"></script>
    <script src="/js/services/merchandise-product-validation-service.js?v=<%= version %>" onerror="console.error('❌ Failed to load merchandise-product-validation-service.js')"></script>
    <script src="/js/services/wavelength-pricing-service.js?v=<%= version %>" onerror="console.error('❌ Failed to load wavelength-pricing-service.js')"></script>
    <script src="/js/services/stripe-checkout-service.js?v=<%= version %>" onerror="console.error('❌ Failed to load stripe-checkout-service.js')"></script>
    
    <!-- PHASE 2: UI Renderer Components (depend on services) -->
    <script src="/js/components/merchandise-product-card-renderer.js?v=<%= version %>" onerror="console.error('❌ Failed to load merchandise-product-card-renderer.js')"></script>
    <script src="/js/components/merchandise-cart-renderer.js?v=<%= version %>" onerror="console.error('❌ Failed to load merchandise-cart-renderer.js')"></script>
    <script src="/js/components/merchandise-category-grid-renderer.js?v=<%= version %>" onerror="console.error('❌ Failed to load merchandise-category-grid-renderer.js')"></script>
    <script src="/js/components/merchandise-modal-renderer.js?v=<%= version %>" onerror="console.error('❌ Failed to load merchandise-modal-renderer.js')"></script>
    
    <!-- Main Component (depends on services and UI renderers) -->
    <script src="/js/components/merchandise-store.js?v=<%= version %>" onerror="console.error('❌ Failed to load merchandise-store.js')"></script>
    
    <script>
        // Initialize store when DOM is ready
        document.addEventListener('DOMContentLoaded', () => {
            console.log('🛍️ Merchandise Store page loaded');
            
            // REFACTOR: Check if all required services and UI renderers are available
            const requiredServices = [
                'WavelengthEventBus',
                'MerchandiseApiService',
                'MerchandiseCartService',
                'MerchandiseProductValidationService',
                'WavelengthPricingService',
                'StripeCheckoutService',
                'MerchandiseProductCardRenderer',
                'MerchandiseCartRenderer',
                'MerchandiseCategoryGridRenderer',
                'MerchandiseModalRenderer',
                'MerchandiseStore'
            ];
            
            const missingServices = requiredServices.filter(service => typeof window[service] === 'undefined');
            
            if (missingServices.length > 0) {
                console.error('❌ Required services not found:', missingServices);
                const container = document.getElementById('merchandise-store');
                if (container) {
                    container.innerHTML = `
                        <div class="merchandise-store">
                            <div class="store-header">
                                <h1>🔓 The Liberation Vault</h1>
                                <p style="color: #ff6b6b;">Failed to open the vault services: ${missingServices.join(', ')}</p>
                                <p style="color: #ff6b6b; font-size: 0.9rem;">Please refresh the page.</p>
                            </div>
                        </div>
                    `;
                }
                return;
            }
            
            if (typeof MerchandiseStore === 'undefined') {
                console.error('❌ MerchandiseStore class not found! Store component failed to load.');
                const container = document.getElementById('merchandise-store');
                if (container) {
                    container.innerHTML = `
                        <div class="merchandise-store">
                            <div class="store-header">
                                <h1>🔓 The Liberation Vault</h1>
                                <p style="color: #ff6b6b;">Failed to unlock the vault. Please refresh the page.</p>
                            </div>
                        </div>
                    `;
                }
                return;
            }
            
            // Check if user was authenticated server-side (development bypass or regular auth)
            const serverAuthenticated = <%= user ? 'true' : 'false' %>;
            
            if (serverAuthenticated) {
                console.log('✅ Server-side authentication detected, initializing store immediately');
                // User was authenticated server-side (development bypass or regular auth)
                // Initialize store without waiting for Firebase
                try {
                    if (!window.merchandiseStore) {
                        window.merchandiseStore = new MerchandiseStore();
                        
                        // 🔍 DIAGNOSTIC: Store instance reference for debugging
                        const container = document.getElementById('merchandise-store');
                        if (container) {
                            container._merchandiseStoreInstance = window.merchandiseStore;
                            console.log('🔍 DIAGNOSTIC: Store instance reference stored on container:', container.id);
                        } else {
                            console.warn('❌ DIAGNOSTIC: Could not find merchandise-store container for instance reference');
                        }
                    }
                } catch (error) {
                    console.error('❌ Failed to initialize MerchandiseStore:', error);
                }
            } else {
                console.log('🔥 No server-side auth, checking Firebase authentication...');
                // No server-side auth, fall back to Firebase client-side authentication
                const checkAuthAndInitialize = () => {
                    if (window.firebaseAuth && window.firebaseUtils) {
                        console.log('🔥 Firebase available, checking auth state...');
                        
                        window.firebaseUtils.onAuthStateChanged(window.firebaseAuth, (user) => {
                            if (user) {
                                console.log('👤 User authenticated via Firebase, initializing store');
                                // Initialize the merchandise store now that user is authenticated
                                try {
                                    if (!window.merchandiseStore) {
                                        window.merchandiseStore = new MerchandiseStore();
                                        
                                        // 🔍 DIAGNOSTIC: Store instance reference for debugging
                                        const container = document.getElementById('merchandise-store');
                                        if (container) {
                                            container._merchandiseStoreInstance = window.merchandiseStore;
                                            console.log('🔍 DIAGNOSTIC: Store instance reference stored on container:', container.id);
                                        } else {
                                            console.warn('❌ DIAGNOSTIC: Could not find merchandise-store container for instance reference');
                                        }
                                    }
                                } catch (error) {
                                    console.error('❌ Failed to initialize MerchandiseStore:', error);
                                }
                            } else {
                                console.log('❌ User not authenticated, redirecting to home');
                                // Redirect to home page where users can sign in
                                window.location.href = '/?redirect=' + encodeURIComponent(window.location.pathname);
                            }
                        });
                    } else {
                        console.log('⏳ Waiting for Firebase to initialize...');
                        // Retry after a short delay
                        setTimeout(checkAuthAndInitialize, 500);
                    }
                };
                
                // Start the authentication check
                checkAuthAndInitialize();
            }
        });
    </script>
</body>
</html>