<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        .auth-content {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: calc(100vh - 120px);
            padding: 20px 0;
        }

        .logout-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 400px;
            width: 90%;
        }

        .logo {
            font-size: 3rem;
            margin-bottom: 20px;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2rem;
        }

        .subtitle {
            color: #666;
            margin-bottom: 30px;
        }

        .logout-btn {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 15px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            margin-bottom: 15px;
        }

        .logout-btn:hover {
            background: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.3);
        }

        .home-btn {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px 25px;
            font-size: 1rem;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .home-btn:hover {
            background: #5a6268;
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

        .status-message {
            background: #d4edda;
            color: #155724;
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
            display: none;
        }

        @media (max-width: 480px) {
            .logout-container {
                padding: 30px 20px;
            }
            
            h1 {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    
    <div class="auth-content">
        <div class="logout-container">
            <div class="logo">🎵</div>
            <h1>Sign Out</h1>
            <p class="subtitle">Are you sure you want to sign out of Wavelength Lore?</p>

            <button id="logoutBtn" class="logout-btn">
                Sign Out
            </button>
            
            <a href="/" class="home-btn">
                Stay Signed In
            </a>

            <div id="statusMessage" class="status-message"></div>

            <% if (redirectUrl && redirectUrl !== '/') { %>
            <div style="background: #e8f4ff; color: #0066cc; padding: 15px; border-radius: 10px; margin-top: 20px; font-size: 0.9rem;">
                After signing out, you'll be redirected as requested.
            </div>
            <% } %>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <!-- Firebase SDK -->
    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js';
      import { getAuth, signOut, onAuthStateChanged } from 'https://www.gstatic.com/firebasejs/10.7.0/firebase-auth.js';

      // Firebase configuration
      const firebaseConfig = {
        apiKey: "<%= process.env.API_KEY %>",
        authDomain: "<%= process.env.AUTH_DOMAIN %>",
        databaseURL: "<%= process.env.DATABASE_URL %>",
        projectId: "<%= process.env.PROJECT_ID %>",
        storageBucket: "<%= process.env.STORAGE_BUCKET %>",
        messagingSenderId: "<%= process.env.MESSAGING_SENDER_ID %>",
        appId: "<%= process.env.APP_ID %>",
        measurementId: "<%= process.env.MEASUREMENT_ID %>"
      };

      // Initialize Firebase
      const app = initializeApp(firebaseConfig);
      const auth = getAuth(app);

      const logoutBtn = document.getElementById('logoutBtn');
      const statusMessage = document.getElementById('statusMessage');
      const redirectUrl = '<%= redirectUrl %>';

      // Check if user is signed in
      onAuthStateChanged(auth, (user) => {
        if (!user) {
          // User is already signed out
          statusMessage.textContent = 'You are already signed out.';
          statusMessage.style.display = 'block';
          logoutBtn.textContent = 'Already Signed Out';
          logoutBtn.disabled = true;
        }
      });

      // Handle logout
      logoutBtn.addEventListener('click', async () => {
        try {
          logoutBtn.disabled = true;
          logoutBtn.textContent = 'Signing Out...';

          await signOut(auth);
          
          statusMessage.textContent = 'Successfully signed out!';
          statusMessage.style.display = 'block';
          
          console.log('User signed out successfully');
          
          // Redirect after a short delay
          setTimeout(() => {
            if (redirectUrl && redirectUrl !== '/') {
              window.location.href = redirectUrl;
            } else {
              window.location.href = '/';
            }
          }, 1500);

        } catch (error) {
          console.error('Sign out error:', error);
          statusMessage.style.background = '#f8d7da';
          statusMessage.style.color = '#721c24';
          statusMessage.textContent = 'Error signing out. Please try again.';
          statusMessage.style.display = 'block';
          
          logoutBtn.disabled = false;
          logoutBtn.textContent = 'Sign Out';
        }
      });
    </script>
</body>
</html>