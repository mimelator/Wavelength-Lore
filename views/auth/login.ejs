<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        .auth-content {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: calc(100vh - 120px);
            padding: 20px 0;
        }

        .login-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 400px;
            width: 90%;
        }

        .logo {
            font-size: 3rem;
            margin-bottom: 20px;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2rem;
        }

        .subtitle {
            color: #666;
            margin-bottom: 30px;
        }

        .google-signin-btn {
            background: #4285f4;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 15px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .google-signin-btn:hover {
            background: #3367d6;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(66, 133, 244, 0.3);
        }

        .google-signin-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .loading-spinner {
            width: 20px;
            height: 20px;
            border: 2px solid transparent;
            border-left: 2px solid white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .error-message {
            background: #ffe6e6;
            color: #d63031;
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
            display: none;
        }

        .redirect-info {
            background: #e8f4ff;
            color: #0066cc;
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
            font-size: 0.9rem;
        }

        @media (max-width: 480px) {
            .login-container {
                padding: 30px 20px;
            }
            
            h1 {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    
    <div class="auth-content">
        <div class="login-container">
        <div class="logo">🎵</div>
        <h1>Wavelength Lore</h1>
        <p class="subtitle">Sign in to access your VIP features</p>

        <button id="googleSignIn" class="google-signin-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <span id="signInText">Sign in with Google</span>
            <div id="loadingSpinner" class="loading-spinner" style="display: none;"></div>
        </button>

        <div id="errorMessage" class="error-message"></div>

        <% if (redirectUrl && redirectUrl !== '/') { %>
        <div class="redirect-info">
            After signing in, you'll be redirected to continue accessing your VIP features.
        </div>
        <% } %>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <!-- Firebase SDK -->
    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js';
      import { getAuth, signInWithPopup, GoogleAuthProvider, onAuthStateChanged } from 'https://www.gstatic.com/firebasejs/10.7.0/firebase-auth.js';

      // Firebase configuration
      const firebaseConfig = {
        apiKey: "<%= process.env.API_KEY %>",
        authDomain: "<%= process.env.AUTH_DOMAIN %>",
        databaseURL: "<%= process.env.DATABASE_URL %>",
        projectId: "<%= process.env.PROJECT_ID %>",
        storageBucket: "<%= process.env.STORAGE_BUCKET %>",
        messagingSenderId: "<%= process.env.MESSAGING_SENDER_ID %>",
        appId: "<%= process.env.APP_ID %>",
        measurementId: "<%= process.env.MEASUREMENT_ID %>"
      };

      // Initialize Firebase
      const app = initializeApp(firebaseConfig);
      const auth = getAuth(app);
      const provider = new GoogleAuthProvider();

      const signInBtn = document.getElementById('googleSignIn');
      const signInText = document.getElementById('signInText');
      const loadingSpinner = document.getElementById('loadingSpinner');
      const errorMessage = document.getElementById('errorMessage');
      const redirectUrl = '<%= redirectUrl %>';

      // Check if user is already signed in
      onAuthStateChanged(auth, (user) => {
        if (user) {
          // User is signed in, redirect them
          console.log('User already signed in:', user.email);
          if (redirectUrl && redirectUrl !== '/') {
            window.location.href = redirectUrl;
          } else {
            window.location.href = '/';
          }
        }
      });

      // Handle Google Sign In
      signInBtn.addEventListener('click', async () => {
        try {
          // Show loading state
          signInBtn.disabled = true;
          signInText.style.display = 'none';
          loadingSpinner.style.display = 'block';
          errorMessage.style.display = 'none';

          // Sign in with Google
          const result = await signInWithPopup(auth, provider);
          const user = result.user;
          
          console.log('Sign in successful:', user.email);
          
          // Redirect to original URL or home
          if (redirectUrl && redirectUrl !== '/') {
            window.location.href = redirectUrl;
          } else {
            window.location.href = '/';
          }

        } catch (error) {
          console.error('Sign in error:', error);
          
          // Show error message
          errorMessage.textContent = 'Sign in failed. Please try again.';
          errorMessage.style.display = 'block';
          
          // Reset button state
          signInBtn.disabled = false;
          signInText.style.display = 'inline';
          loadingSpinner.style.display = 'none';
        }
      });
    </script>
</body>
</html>