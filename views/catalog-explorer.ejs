<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wavelength Catalog Explorer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            min-height: 100vh;
        }
        
        .header {
            background: rgba(0, 0, 0, 0.3);
            padding: 20px 0;
            text-align: center;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        }
        
        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(45deg, #FFD700, #FFA500);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px 20px;
        }
        
        .controls {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
        }
        
        .control-group {
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }
        
        .control-group:last-child {
            margin-bottom: 0;
        }
        
        .control-group label {
            font-weight: 600;
            min-width: 100px;
        }
        
        .control-group select, .control-group input {
            padding: 8px 12px;
            border: none;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.9);
            color: #333;
            font-size: 14px;
        }
        
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            backdrop-filter: blur(10px);
        }
        
        .stat-card h3 {
            font-size: 2rem;
            color: #FFD700;
            margin-bottom: 5px;
        }
        
        .stat-card p {
            opacity: 0.9;
        }
        
        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
        }
        
        .product-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }
        
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .product-header {
            display: flex;
            justify-content: between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        
        .product-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #FFD700;
            margin-bottom: 5px;
        }
        
        .product-type {
            background: rgba(255, 255, 255, 0.2);
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .product-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }
        
        .detail-item {
            display: flex;
            flex-direction: column;
        }
        
        .detail-label {
            font-size: 0.8rem;
            opacity: 0.7;
            margin-bottom: 2px;
        }
        
        .detail-value {
            font-weight: 600;
        }
        
        .product-description {
            font-size: 0.9rem;
            opacity: 0.8;
            line-height: 1.4;
            margin-bottom: 15px;
        }
        
        .product-actions {
            display: flex;
            gap: 10px;
        }
        
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        
        .btn-primary {
            background: linear-gradient(45deg, #FFD700, #FFA500);
            color: #333;
            font-weight: 600;
        }
        
        .btn-secondary {
            background: rgba(255, 255, 255, 0.2);
            color: white;
        }
        
        .btn:hover {
            transform: translateY(-2px);
        }
        
        .loading {
            text-align: center;
            padding: 40px;
            font-size: 1.2rem;
        }
        
        .error {
            background: rgba(255, 0, 0, 0.2);
            border: 1px solid rgba(255, 0, 0, 0.5);
            border-radius: 10px;
            padding: 20px;
            margin: 20px 0;
            text-align: center;
        }
        
        .category-header {
            background: rgba(255, 255, 255, 0.15);
            padding: 15px 20px;
            border-radius: 10px;
            margin: 30px 0 20px 0;
            border-left: 4px solid #FFD700;
        }
        
        .category-header h2 {
            font-size: 1.5rem;
            margin-bottom: 5px;
        }
        
        .category-header p {
            opacity: 0.8;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🌊 Wavelength Catalog Explorer</h1>
        <p>Browse all validated product offerings and blueprints</p>
    </div>
    
    <div class="container">
        <div class="controls">
            <div class="control-group">
                <label>Filter by Type:</label>
                <select id="typeFilter">
                    <option value="">All Product Types</option>
                </select>
                
                <label>Filter by Category:</label>
                <select id="categoryFilter">
                    <option value="">All Categories</option>
                </select>
                
                <label>Search:</label>
                <input type="text" id="searchInput" placeholder="Search products...">
            </div>
            
            <div class="control-group">
                <label>View Mode:</label>
                <select id="viewMode">
                    <option value="validated">Validated Products (Ready)</option>
                    <option value="essential">Essential Products Only</option>
                    <option value="master">Complete Master Catalog</option>
                    <option value="comparison">Comparison View</option>
                </select>
            </div>
        </div>
        
        <div class="stats" id="stats">
            <!-- Stats will be populated by JavaScript -->
        </div>
        
        <div id="catalogContent">
            <div class="loading">Loading catalog data...</div>
        </div>
    </div>

    <script>
        class CatalogExplorer {
            constructor() {
                this.catalogs = {};
                this.filteredProducts = [];
                this.currentView = 'validated';
                this.init();
            }
            
            async init() {
                await this.loadCatalogs();
                this.setupEventListeners();
                this.populateFilters();
                this.renderCatalog();
            }
            
            async loadCatalogs() {
                try {
                    // Load all catalog configurations
                    const catalogFiles = [
                        { key: 'validated', url: '/config/product-types-validated-ready.js', name: 'Validated Products' },
                        { key: 'essential', url: '/config/product-types-essential.js', name: 'Essential Products' },
                        { key: 'master', url: '/config/product-types-validated-master.js', name: 'Master Catalog' },
                        { key: 'original', url: '/config/product-types.js', name: 'Original Config' }
                    ];
                    
                    for (const catalog of catalogFiles) {
                        try {
                            const response = await fetch(catalog.url);
                            const text = await response.text();
                            
                            // Extract the product types from the JavaScript file
                            let productTypesArray = [];
                            
                            // Try different patterns for different config file structures
                            let match = text.match(/const\\s+productTypes\\s*=\\s*(\\[[\\s\\S]*?\\]);/);
                            if (match) {
                                productTypesArray = eval(match[1]);
                            } else {
                                // Try ProductTypes object structure
                                match = text.match(/const\\s+ProductTypes\\s*=\\s*(\\{[\\s\\S]*?\\});/);
                                if (match) {
                                    const productTypesObj = eval('(' + match[1] + ')');
                                    // Flatten the nested structure
                                    productTypesArray = [];
                                    Object.entries(productTypesObj).forEach(([categoryKey, categoryData]) => {
                                        if (categoryData.products && Array.isArray(categoryData.products)) {
                                            categoryData.products.forEach(product => {
                                                productTypesArray.push({
                                                    ...product,
                                                    category: categoryData.name || categoryKey
                                                });
                                            });
                                        }
                                    });
                                }
                            }
                            
                            if (productTypesArray.length > 0) {
                                this.catalogs[catalog.key] = {
                                    name: catalog.name,
                                    products: productTypesArray,
                                    categories: this.extractCategories(productTypesArray)
                                };
                            }
                        } catch (error) {
                            console.warn(`Could not load ${catalog.name}:`, error);
                        }
                    }
                    
                    console.log('Loaded catalogs:', Object.keys(this.catalogs));
                } catch (error) {
                    console.error('Error loading catalogs:', error);
                    this.showError('Failed to load catalog data');
                }
            }
            
            extractCategories(products) {
                const categories = {};
                products.forEach(product => {
                    const category = product.category || 'Uncategorized';
                    if (!categories[category]) {
                        categories[category] = [];
                    }
                    categories[category].push(product);
                });
                return categories;
            }
            
            setupEventListeners() {
                document.getElementById('typeFilter').addEventListener('change', () => this.applyFilters());
                document.getElementById('categoryFilter').addEventListener('change', () => this.applyFilters());
                document.getElementById('searchInput').addEventListener('input', () => this.applyFilters());
                document.getElementById('viewMode').addEventListener('change', (e) => {
                    this.currentView = e.target.value;
                    this.renderCatalog();
                });
            }
            
            populateFilters() {
                const typeFilter = document.getElementById('typeFilter');
                const categoryFilter = document.getElementById('categoryFilter');
                
                const allTypes = new Set();
                const allCategories = new Set();
                
                Object.values(this.catalogs).forEach(catalog => {
                    catalog.products.forEach(product => {
                        allTypes.add(product.id || product.name);
                        allCategories.add(product.category || 'Uncategorized');
                    });
                });
                
                // Populate type filter
                [...allTypes].sort().forEach(type => {
                    const option = document.createElement('option');
                    option.value = type;
                    option.textContent = type;
                    typeFilter.appendChild(option);
                });
                
                // Populate category filter  
                [...allCategories].sort().forEach(category => {
                    const option = document.createElement('option');
                    option.value = category;
                    option.textContent = category;
                    categoryFilter.appendChild(option);
                });
            }
            
            applyFilters() {
                const typeFilter = document.getElementById('typeFilter').value;
                const categoryFilter = document.getElementById('categoryFilter').value;
                const searchTerm = document.getElementById('searchInput').value.toLowerCase();
                
                const currentCatalog = this.catalogs[this.currentView];
                if (!currentCatalog) return;
                
                this.filteredProducts = currentCatalog.products.filter(product => {
                    const matchesType = !typeFilter || product.id === typeFilter || product.name === typeFilter;
                    const matchesCategory = !categoryFilter || (product.category || 'Uncategorized') === categoryFilter;
                    const matchesSearch = !searchTerm || 
                        product.name?.toLowerCase().includes(searchTerm) ||
                        product.id?.toLowerCase().includes(searchTerm) ||
                        product.description?.toLowerCase().includes(searchTerm);
                    
                    return matchesType && matchesCategory && matchesSearch;
                });
                
                this.renderProducts();
            }
            
            renderCatalog() {
                const currentCatalog = this.catalogs[this.currentView];
                if (!currentCatalog) {
                    this.showError(`Catalog "${this.currentView}" not available`);
                    return;
                }
                
                this.filteredProducts = currentCatalog.products;
                this.renderStats();
                this.renderProducts();
            }
            
            renderStats() {
                const currentCatalog = this.catalogs[this.currentView];
                if (!currentCatalog) return;
                
                const stats = {
                    'Total Products': currentCatalog.products.length,
                    'Categories': Object.keys(currentCatalog.categories).length,
                    'Blueprints': new Set(currentCatalog.products.map(p => p.blueprintId)).size,
                    'Providers': new Set(currentCatalog.products.map(p => p.printProviderId)).size
                };
                
                const statsHtml = Object.entries(stats).map(([label, value]) => `
                    <div class="stat-card">
                        <h3>${value}</h3>
                        <p>${label}</p>
                    </div>
                `).join('');
                
                document.getElementById('stats').innerHTML = statsHtml;
            }
            
            renderProducts() {
                const catalogContent = document.getElementById('catalogContent');
                
                if (this.filteredProducts.length === 0) {
                    catalogContent.innerHTML = '<div class="error">No products match your filters</div>';
                    return;
                }
                
                // Group by category
                const productsByCategory = {};
                this.filteredProducts.forEach(product => {
                    const category = product.category || 'Uncategorized';
                    if (!productsByCategory[category]) {
                        productsByCategory[category] = [];
                    }
                    productsByCategory[category].push(product);
                });
                
                let html = '';
                
                Object.entries(productsByCategory).forEach(([category, products]) => {
                    html += `
                        <div class="category-header">
                            <h2>${category}</h2>
                            <p>${products.length} product${products.length !== 1 ? 's' : ''}</p>
                        </div>
                        <div class="catalog-grid">
                            ${products.map(product => this.renderProductCard(product)).join('')}
                        </div>
                    `;
                });
                
                catalogContent.innerHTML = html;
            }
            
            renderProductCard(product) {
                return `
                    <div class="product-card">
                        <div class="product-header">
                            <div>
                                <div class="product-title">${product.name || product.id}</div>
                                <div class="product-type">${product.id || product.productType || 'Unknown'}</div>
                            </div>
                        </div>
                        
                        <div class="product-details">
                            <div class="detail-item">
                                <div class="detail-label">Blueprint ID</div>
                                <div class="detail-value">${product.blueprintId || 'N/A'}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Provider ID</div>
                                <div class="detail-value">${product.printProviderId || 'N/A'}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Category</div>
                                <div class="detail-value">${product.category || 'Uncategorized'}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Validated</div>
                                <div class="detail-value">${product.validated ? '✅ Yes' : '⚠️ Unverified'}</div>
                            </div>
                        </div>
                        
                        ${product.description ? `<div class="product-description">${product.description}</div>` : ''}
                        
                        <div class="product-actions">
                            <button class="btn btn-primary" onclick="window.open('/merchandise', '_blank')">
                                Create Product
                            </button>
                            <button class="btn btn-secondary" onclick="catalogExplorer.showProductDetails('${product.id || product.name}')">
                                View Details
                            </button>
                        </div>
                    </div>
                `;
            }
            
            showProductDetails(productId) {
                const product = this.filteredProducts.find(p => p.id === productId || p.name === productId);
                if (product) {
                    alert(`Product Details:\\n\\n${JSON.stringify(product, null, 2)}`);
                }
            }
            
            showError(message) {
                document.getElementById('catalogContent').innerHTML = `
                    <div class="error">
                        <h3>Error</h3>
                        <p>${message}</p>
                    </div>
                `;
            }
        }
        
        // Initialize the catalog explorer
        const catalogExplorer = new CatalogExplorer();
    </script>
</body>
</html>