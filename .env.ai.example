# AI Image Generation Configuration
# Add these to your .env file for AI image generation

# Primary API Configuration
AI_API_KEY=your_banana_api_key_here
AI_API_ENDPOINT=https://api.banana.dev/start/v4/
AI_MODEL_KEY=google/imagen

# Alternative naming (for compatibility)
BANANA_API_KEY=your_banana_api_key_here

# Optional: Default generation settings
AI_DEFAULT_WIDTH=1024
AI_DEFAULT_HEIGHT=1024
AI_DEFAULT_STEPS=50
AI_DEFAULT_GUIDANCE=7.5
AI_DEFAULT_STYLE=photorealistic

# Asset Management Integration
AI_AUTO_UPLOAD=true
AI_DEFAULT_TARGET=ai-generated
AI_URL_MODE=relative